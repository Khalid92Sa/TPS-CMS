@model CMS.Application.DTOs.TemplatesDTO

@{
    ViewData["Title"] = "Delete Template";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-file-text-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete template</p>
            <h2 class="tps-ihead__name" dir="auto">@(Model.Name ?? Model.Title)</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.Title))
                {
                    <span class="tps-chip"><i class="ri-text"></i>@Model.Title</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>Notifications that use this template will no longer have it available.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Name</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div>
                    <dt>Title</dt>
                    <dd>@Model.Title</dd>
                </div>
                <div>
                    <dt>Body</dt>
                    <dd><div class="fw-normal" dir="auto">@Html.DisplayFor(model => model.BodyDesc)</div></dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this template?"><i class="ri-delete-bin-6-line me-1"></i> Delete template</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
