@using CMS.Domain.Enums
@model CMS.Application.DTOs.InterviewsDTO

@await Html.PartialAsync("_InterviewDetailsStyles")

<div class="container interview-details-page">
    <div class="interview-details-page__header">
        <div class="interview-details-page__title">
            <h2>Interview Details</h2>
            <p><i class="bx bx-user me-1"></i>@Model.FullName</p>
        </div>
        <div class="interview-details-page__badges">
            @if (Model.FirstInterviewScore.HasValue)
            {
                <span class="detail-badge detail-badge--score"><i class="bx bx-star"></i>Score @Model.FirstInterviewScore</span>
            }
            @if (!string.IsNullOrEmpty(Model.TrackName))
            {
                <span class="detail-badge detail-badge--muted"><i class="bx bx-git-branch"></i>@Model.TrackName</span>
            }
        </div>
    </div>

    <div class="row interview-cards-row">
        <!-- Main Details -->
        <div class="col-md-3 col-sm-6 interview-card-col">
            <div class="interview-detail-card">
                <div class="interview-detail-card__header">
                    <span class="interview-detail-card__icon"><i class="bx bx-id-card"></i></span>
                    <h5 class="interview-detail-card__title">Main Details</h5>
                </div>
                <div class="interview-detail-card__body">
                    <div class="detail-field">
                        <div class="detail-field__label">Candidate Name</div>
                        <div class="detail-field__value">@Model.FullName</div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Level</div>
                        <div class="detail-field__value">@Model.Name</div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Track</div>
                        <div class="detail-field__value">@(Model.TrackName ?? "—")</div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Score</div>
                        <div class="detail-field__value">@(Model.FirstInterviewScore?.ToString() ?? "—")</div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Status</div>
                        <div class="detail-field__value">@Model.StatusName</div>
                    </div>
                    @if (User.IsInRole("Admin") || User.IsInRole("HR Manager"))
                    {
                        <div class="detail-field">
                            <div class="detail-field__label">Stop Cycle Note</div>
                            <div class="detail-field__value@(Model.StopCycleNote == null ? " detail-field__value--empty" : "")">
                                @if (Model.StopCycleNote != null)
                                {
                                    @await Html.PartialAsync("_NotesContent", new { Content = Model.StopCycleNote, MaxLength = 100 })
                                }
                                else
                                {
                                    <span class="detail-empty-state">No stop cycle happened yet</span>
                                }
                            </div>
                        </div>
                    }
                    <div class="detail-field">
                        <div class="detail-field__label">Evaluation</div>
                        <div class="detail-field__value">
                            @if (Model.AttachmentId != null)
                            {
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.AttachmentId" class="detail-download-btn">
                                    <i class="bx bx-download"></i> Download evaluation
                                </a>
                            }
                            else
                            {
                                <span class="detail-empty-state">No evaluation for this interview</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- First Interview -->
        <div class="@NotesDisplayHelper.GetCardColumnClass(Model.Notes)">
            <div class="interview-detail-card">
                <div class="interview-detail-card__header">
                    <span class="interview-detail-card__icon"><i class="bx bx-microphone"></i></span>
                    <h5 class="interview-detail-card__title">First Interview</h5>
                </div>
                <div class="interview-detail-card__body">
                    <div class="detail-field">
                        <div class="detail-field__label">First Interviewer</div>
                        <div class="detail-field__value">@Model.InterviewerName</div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Second Interviewer</div>
                        <div class="detail-field__value@(Model.SecondInterviewerId == null ? " detail-field__value--empty" : "")">
                            @(Model.SecondInterviewerId == null ? "No second interviewer" : Model.SecondInterviewerName)
                        </div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Actual Experience</div>
                        <div class="detail-field__value">
                            @if (Model.ActualExperience.HasValue)
                            {
                                @Model.ActualExperience
                            }
                            else
                            {
                                <span class="detail-empty-state">Not recorded</span>
                            }
                        </div>
                    </div>
                    <div class="detail-field">
                        <div class="detail-field__label">Notes</div>
                        <div class="detail-field__value detail-field__value--notes">
                            @if (Model.Notes != null)
                            {
                                @await Html.PartialAsync("_NotesContent", new { Content = Model.Notes, MaxLength = 100 })
                            }
                            else
                            {
                                <span class="detail-empty-state">No notes added</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Second Interview -->
        @if (User.IsInRole("Admin") || User.IsInRole("HR Manager") || User.IsInRole("General Manager"))
        {
            <div class="@NotesDisplayHelper.GetCardColumnClass(Model.SecondInterviewNotes)">
                <div class="interview-detail-card">
                    <div class="interview-detail-card__header">
                        <span class="interview-detail-card__icon"><i class="bx bx-group"></i></span>
                        <h5 class="interview-detail-card__title">Second Interview</h5>
                    </div>
                    <div class="interview-detail-card__body">
                        <div class="detail-field">
                            <div class="detail-field__label">Interviewer</div>
                            <div class="detail-field__value">
                                @(Model.SecondInterviewInterviewerName ?? "No second interview yet")
                            </div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Architecture Interviewer</div>
                            <div class="detail-field__value">
                                @(Model.ArchitectureInterviewerId != null ? Model.ArchitectureInterviewerName : "No architecture interview")
                            </div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Actual Experience</div>
                            <div class="detail-field__value">
                                @if (Model.SecondInterviewActualExperience.HasValue)
                                {
                                    @Model.SecondInterviewActualExperience
                                }
                                else
                                {
                                    <span class="detail-empty-state">Not recorded</span>
                                }
                            </div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Notes</div>
                            <div class="detail-field__value detail-field__value--notes">
                                @if (Model.SecondInterviewNotes != null)
                                {
                                    @await Html.PartialAsync("_NotesContent", new { Content = Model.SecondInterviewNotes, MaxLength = 100 })
                                }
                                else
                                {
                                    <span class="detail-empty-state">No notes added</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- HR Interview -->
        @if (User.IsInRole("Admin") || User.IsInRole("HR Manager"))
        {
            <div class="@NotesDisplayHelper.GetCardColumnClass(Model.HRNotes)">
                <div class="interview-detail-card">
                    <div class="interview-detail-card__header">
                        <span class="interview-detail-card__icon"><i class="bx bx-briefcase"></i></span>
                        <h5 class="interview-detail-card__title">HR Interview</h5>
                    </div>
                    <div class="interview-detail-card__body">
                        <div class="detail-field">
                            <div class="detail-field__label">HR Note</div>
                            <div class="detail-field__value detail-field__value--notes">
                                @if (Model.HRNotes != null)
                                {
                                    @await Html.PartialAsync("_NotesContent", new { Content = Model.HRNotes, MaxLength = 100 })
                                }
                                else
                                {
                                    <span class="detail-empty-state">No note added</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="interview-details-page__footer">
        <a class="btn-detail-back"
           asp-action="@ViewBag.PreviousAction"
           asp-route-statusFilter="@ViewBag.statusFilter"
           asp-route-candidateFilter="@ViewBag.candidateFilter"
           asp-route-trackFilter="@ViewBag.trackFilter"
           asp-route-pageNumber="@ViewBag.PageNumber"
           asp-route-pageSize="@ViewBag.PageSize">
            <i class="bx bx-arrow-back"></i> Back to List
        </a>
    </div>
</div>
