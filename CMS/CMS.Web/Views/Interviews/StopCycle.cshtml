@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Stop Cycle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form asp-action="StopCycle" method="post" class="needs-validation" novalidate id="stopCycleForm">
    <input type="hidden" asp-for="InterviewsId" />
    <input type="hidden" asp-for="InterviewerId" />
    <input type="hidden" asp-for="EvalutaionFormId" />
    <input type="hidden" asp-for="CandidateId" />
    <input type="hidden" asp-for="PositionId" />
    <input type="hidden" asp-for="isUpdated" />

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--icon" aria-hidden="true" style="background:var(--tps-danger-soft);color:var(--tps-danger)"><i class="ri-stop-circle-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Stop interview cycle</p>
                <h2 class="tps-ihead__name" dir="auto">@(string.IsNullOrEmpty(Model?.FullName) ? "Candidate" : Model.FullName)</h2>
                <div class="tps-ihead__meta">
                    @if (!string.IsNullOrEmpty(Model?.StatusName))
                    {
                        @InterviewStatusUi.Badge(Model.StatusName)
                    }
                    @if (!string.IsNullOrEmpty(Model?.Name))
                    {
                        <span class="tps-chip"><i class="ri-briefcase-4-line"></i>@Model.Name</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <section class="card tps-fsection" aria-labelledby="sec-stop">
                <div class="card-header">
                    <span class="tps-fsection__icon" style="background:var(--tps-danger-soft);color:var(--tps-danger)"><i class="ri-file-text-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-stop">Reason for stopping</h4>
                        <p class="tps-fsection__desc">HR and administrators see this note on the interview details.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-danger-note" role="note">
                        <i class="ri-error-warning-line"></i>
                        <div>Stopping ends this candidate's interview cycle. It can't be undone from here.</div>
                    </div>

                    <div class="tps-field">
                        <label asp-for="StopCycleNote" class="form-label" for="Note">Reason <span class="tps-req">*</span></label>
                        <textarea id="Note" asp-for="StopCycleNote" class="form-control" rows="5" dir="auto"
                                  placeholder="Explain why the cycle is being stopped, e.g. the candidate withdrew or the position was closed." required></textarea>
                        <div class="invalid-feedback">Explain why the cycle is being stopped.</div>
                        <span asp-validation-for="StopCycleNote" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index"
               asp-route-statusFilter="@ViewBag.statusFilter"
               asp-route-candidateFilter="@ViewBag.candidateFilter"
               asp-route-trackFilter="@ViewBag.trackFilter"
               asp-route-pageNumber="@ViewBag.PageNumber"
               asp-route-pageSize="@ViewBag.PageSize">Cancel</a>
            <button type="submit" class="btn btn-danger px-4"><i class="ri-stop-circle-line me-1"></i> Stop cycle</button>
        </div>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    (function () {
        'use strict';
        var form = document.getElementById('stopCycleForm');
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            event.stopPropagation();
            form.classList.add('was-validated');

            var note = document.getElementById('Note');
            note.value = note.value.trim() ? note.value : '';
            if (!form.checkValidity()) {
                note.focus();
                return;
            }

            Swal.fire({
                title: 'Stop this interview cycle?',
                text: 'The candidate\'s interview cycle ends with the reason you entered. This can\'t be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Stop cycle',
                cancelButtonText: 'Keep going',
                reverseButtons: true,
                focusCancel: true,
                customClass: { confirmButton: 'tps-swal-danger' }
            }).then(function (result) {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }, false);
    })();
</script>
