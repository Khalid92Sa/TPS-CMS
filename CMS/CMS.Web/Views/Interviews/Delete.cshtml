@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Delete Interview";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-calendar-close-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete interview</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.FullName</h2>
            <div class="tps-ihead__meta">
                @InterviewStatusUi.Badge(Model.StatusName)
                <span class="tps-chip"><i class="ri-calendar-event-line"></i>@Model.Date.ToString("dd MMM yyyy, h:mm tt")</span>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>The interview and its result are removed permanently.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Candidate</dt>
                    <dd>@Model.FullName</dd>
                </div>
                <div>
                    <dt>Level</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div>
                    <dt>Track</dt>
                    <dd>@Model.TrackName</dd>
                </div>
                <div>
                    <dt>Interviewer 1</dt>
                    <dd>@Model.InterviewerName</dd>
                </div>
                <div>
                    <dt>Interviewer 2</dt>
                    <dd>@if (Model.SecondInterviewerId != null)
                        {
                            @Model.SecondInterviewerName
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No second interviewer</span>
                        }</dd>
                </div>
                <div>
                    <dt>Date</dt>
                    <dd>@Model.Date.ToString("dd MMM yyyy, h:mm tt")</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@InterviewStatusUi.Badge(Model.StatusName)</dd>
                </div>
                <div>
                    <dt>First interview score</dt>
                    <dd>@if (Model.FirstInterviewScore != null)
                        {
                            <text>@Model.FirstInterviewScore / 5</text>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No score</span>
                        }</dd>
                </div>
                <div>
                    <dt>Actual experience</dt>
                    <dd>@if (Model.ActualExperience != null)
                        {
                            <text>@Model.ActualExperience years</text>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">Not recorded</span>
                        }</dd>
                </div>
                <div>
                    <dt>Notes</dt>
                    <dd>@if (Model.Notes != null)
                        {
                            <div class="fw-normal">@await Html.PartialAsync("_NotesContent", new { Content = Model.Notes, MaxLength = 100 })</div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No notes</span>
                        }</dd>
                </div>
                <div>
                    <dt>Stop cycle note</dt>
                    <dd>@if (Model.StopCycleNote != null)
                        {
                            <span class="fw-normal">@Model.StopCycleNote</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No stop cycle note</span>
                        }</dd>
                </div>
                <div>
                    <dt>Evaluation</dt>
                    <dd>@if (Model.AttachmentId != null)
                        {
                            <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.AttachmentId"><i class="ri-file-download-line me-1"></i>Download evaluation</a>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No evaluation</span>
                        }</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this interview?" data-confirm-text="The interview and its data are deleted. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete interview</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
