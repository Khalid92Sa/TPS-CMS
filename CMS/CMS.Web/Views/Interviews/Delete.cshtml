@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Delete Interview";
}

<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }
</style>

<!-- Page Container -->
<div class="container my-5">
    <div class="card shadow border-0 rounded-lg">
        <div class="card-header text-dark text-center py-4 border-bottom" style="background-color:#405189;">
            <h4 class="mb-0" style="color:white;">Confirm Deletion</h4>
        </div>

        <div class="card-body px-4 py-5">
            <div class="alert alert-light text-center shadow-sm border border-warning rounded-lg">
                <h5 class="mb-3 text-danger">Are you sure you want to delete this interview?</h5>
                <p class="text-muted">This action cannot be undone.</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-6" >
                    <!-- Candidate Details -->
                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Candidate Name:</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Level:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Track:</dt>
                        <dd class="col-sm-8">@Model.TrackName</dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">First Interviewer Name:</dt>
                        <dd class="col-sm-8">@Model.InterviewerName</dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Second Interviewer Name:</dt>
                        <dd class="col-sm-8">
                            @if (Model.SecondInterviewerId != null)
                            {
                                @Model.SecondInterviewerName
                            }
                            else
                            {
                                <span class="text-muted">No second interviewer</span>
                            }
                        </dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Date:</dt>
                        <dd class="col-sm-8">@Model.Date</dd>
                    </dl>
                </div>

                <div class="col-lg-6">
                    <!-- Interview Details -->
                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">First Interview Score:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.FirstInterviewScore != null)
                            {
                                @Model.FirstInterviewScore
                            }
                            else
                            {
                                <span class="text-muted">No score available</span>
                            }
                        </dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Actual Experience:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.ActualExperience != null)
                            {
                                @Model.ActualExperience
                            }
                            else
                            {
                                <span class="text-muted">No actual experience provided</span>
                            }
                        </dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Status:</dt>
                        <dd class="col-sm-8">@Model.StatusName</dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Notes:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.Notes != null)
                            {
                                @Model.Notes
                            }
                            else
                            {
                                <span class="text-muted">No notes available</span>
                            }
                        </dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Stop Cycle Note:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.StopCycleNote != null)
                            {
                                @Model.StopCycleNote
                            }
                            else
                            {
                                <span class="text-muted">No stop cycle note provided</span>
                            }
                        </dd>
                    </dl>

                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Evaluation:</dt>
                        <dd class="col-sm-8">
                            @if (Model.AttachmentId != null)
                            {
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.AttachmentId" class="btn btn-sm btn-outline-primary">
                                    Download Evaluation
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No evaluation available</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <!-- Action Buttons -->
        <div class="text-center mt-4">
            <form id="deleteForm" asp-action="Delete">
                <div class="d-flex justify-content-between mt-4" style="margin-bottom: 3.5%;">
                    <button type="button" class="btn btn-danger px-4" onclick="showSwalConfirm()" style="margin-left: 23px;">Delete</button>
                    <a class="btn btn-secondary" asp-action="Index" style="margin-right: 23px;">Back to list</a>
                 </div>
            </form>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showSwalConfirm() {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This action will permanently delete the interview and its data!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e3342f',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('deleteForm').submit();
            }
        });
    }
</script>

<!-- Font Awesome for Icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
