@using CMS.Domain.Enums;
@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Add Interview Result";

    bool scoresInterview = User.IsInRole("Interviewer")
        || (User.IsInRole("Solution Architecture") && Model.ParentId == null)
        || (User.IsInRole("Solution Architecture") && Model.ParentId != null && Model.WorkflowStageId == (int)EnumWorkflowStage.InterviewersReview);
    bool recordsExperience = !User.IsInRole("HR Manager");

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)) : $"{parts[0][0]}{parts[1][0]}";
    }
}

<form asp-action="UpdateAfterInterview" id="updateForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="InterviewsId" />
    <input type="hidden" asp-for="InterviewerId" />
    <input type="hidden" asp-for="SecondInterviewerId" />
    <input type="hidden" asp-for="ArchitectureInterviewerId" />
    <input type="hidden" asp-for="EvalutaionFormId" />
    <input type="hidden" asp-for="CandidateId" />
    <input type="hidden" asp-for="PositionId" />
    <input type="hidden" asp-for="isUpdated" />

    @* ---------- Header ---------- *@
    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar" aria-hidden="true">@Initials(Model.FullName)</span>
            <div>
                <p class="tps-ihead__eyebrow">Adding result for</p>
                <h2 class="tps-ihead__name" dir="auto">@Model.FullName</h2>
                <div class="tps-ihead__meta">
                    @if (!string.IsNullOrEmpty(Model.Name))
                    {
                        <span class="tps-chip"><i class="ri-briefcase-4-line"></i>@Model.Name</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrackName))
                    {
                        <span class="tps-chip"><i class="ri-git-branch-line"></i>@Model.TrackName</span>
                    }
                    @if (Model.Date != default)
                    {
                        <span class="tps-chip"><i class="ri-calendar-event-line"></i>@Model.Date.ToString("dd MMM yyyy, h:mm tt")</span>
                    }
                </div>
            </div>
        </div>
        <div class="tps-ihead__actions">
            @if (Model.StartFromHR)
            {
                <a class="btn btn-secondary" asp-action="ShowHistoryForHRFirstFlow" asp-route-id="@Model.InterviewsId"><i class="ri-history-line me-1"></i> History</a>
            }
            else
            {
                <a class="btn btn-secondary" asp-action="ShowHistory" asp-route-id="@Model.InterviewsId"><i class="ri-history-line me-1"></i> History</a>
            }
            @if (Model.CandidateCVAttachmentId != null)
            {
                <a class="btn btn-outline-primary" asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CandidateCVAttachmentId"><i class="ri-file-user-line me-1"></i> Candidate CV</a>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8">

            @* ---------- Outcome ---------- *@
            <section class="card tps-fsection" aria-labelledby="sec-outcome">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-scales-3-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-outcome">Outcome</h4>
                        <p class="tps-fsection__desc">Your decision for this interview and how the candidate scored.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field @(scoresInterview || recordsExperience ? "" : "tps-span-all")">
                            <label asp-for="StatusId" class="form-label">Decision <span class="tps-req">*</span></label>
                            @if (ViewBag.StatusDTOs != null)
                            {
                                <select asp-for="StatusId" class="form-select" data-status-select>
                                    <option value="">Select a decision…</option>
                                    @foreach (var sta in ViewBag.StatusDTOs)
                                    {
                                        if (sta.Text != StatusCode.GetName("PND"))
                                        {
                                            <option value="@sta.Value">@sta.Text</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No statuses are available.</p>
                            }
                            <span asp-validation-for="StatusId" class="text-danger"></span>
                        </div>

                        @if (scoresInterview)
                        {
                            <div class="tps-field">
                                <label asp-for="Score" class="form-label">Score <span class="tps-req">*</span></label>
                                <div class="tps-input-unit">
                                    <span class="tps-input-unit__suffix">out of 5</span>
                                    <input asp-for="Score" class="form-control score" inputmode="decimal" placeholder="e.g. 3.5" />
                                    <span asp-validation-for="Score" class="text-danger"></span>
                                </div>
                                <div class="tps-scale" id="scoreScale" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
                                <div class="tps-hint">0 to 5. An accepted candidate needs at least 3.</div>
                            </div>
                        }

                        @if (recordsExperience)
                        {
                            <div class="tps-field">
                                <label asp-for="ActualExperience" class="form-label">Actual experience <span class="tps-req">*</span></label>
                                <div class="tps-input-unit">
                                    <span class="tps-input-unit__suffix">years</span>
                                    <input asp-for="ActualExperience" class="form-control actualexperience" inputmode="decimal" placeholder="e.g. 4" pattern="^(?:0(\.\d+)?|[1-9]\d*(\.\d+)?)$" title="Experience must be a non-negative numeric value." />
                                    <span asp-validation-for="ActualExperience" class="text-danger"></span>
                                </div>
                                <div class="tps-hint">Experience you assessed during the interview.</div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            @* ---------- Notes ---------- *@
            <section class="card tps-fsection" aria-labelledby="sec-notes">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-file-text-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-notes">Notes</h4>
                        <p class="tps-fsection__desc">Strengths, concerns and anything the next reviewer should know. Required when you reject.</p>
                    </div>
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("_CKEditor", new { id = "Notes", label = "Interview notes", value = Model.Notes ?? "" })
                    <span asp-validation-for="Notes" class="text-danger d-block" id="notes-client-validation"></span>
                </div>
            </section>

            @* ---------- Evaluation ---------- *@
            @if (scoresInterview)
            {
                <section class="card tps-fsection" aria-labelledby="sec-eval">
                    <div class="card-header">
                        <span class="tps-fsection__icon"><i class="ri-file-upload-line"></i></span>
                        <div>
                            <h4 class="tps-fsection__title" id="sec-eval">Evaluation form</h4>
                            <p class="tps-fsection__desc">Upload the completed evaluation for this interview.</p>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.EvalutaionFormId != null)
                        {
                            <div class="tps-callout">
                                <i class="ri-file-download-line"></i>
                                <div>
                                    <div class="tps-callout__title">Step 1 · Download the evaluation template</div>
                                    <p class="tps-callout__text">Fill it in, save it, then upload the completed file below.</p>
                                    <a class="btn btn-outline-primary btn-sm" asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.EvalutaionFormId">
                                        <i class="ri-download-2-line me-1"></i> Download template
                                    </a>
                                </div>
                            </div>
                        }

                        <label class="form-label" for="file">@(Model.EvalutaionFormId != null ? "Step 2 · " : "")Upload completed evaluation <span class="tps-req">*</span></label>
                        <div class="tps-upload" id="fileUploadArea">
                            <input type="file" id="file" name="file" class="file-input-hidden" accept=".pdf,.doc,.docx,.xls,.xlsx" aria-describedby="fileHint" />
                            <span class="tps-upload__icon"><i class="ri-upload-cloud-2-line"></i></span>
                            <div class="tps-upload__text"><strong>Click to choose a file</strong> or drag it here</div>
                            <div class="tps-upload__hint" id="fileHint">PDF, Word or Excel · up to 10 MB</div>
                        </div>
                        <div id="filePreviewContainer" style="display: none;">
                            <div class="tps-file" id="filePreviewItem">
                                <span class="tps-file__icon"><i class="ri-file-3-line"></i></span>
                                <div>
                                    <div class="tps-file__name" id="fileName"></div>
                                    <div class="tps-file__meta" id="fileSize"></div>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm tps-file__remove" id="removeFileBtn" title="Remove file">
                                    <i class="ri-close-line"></i> Remove
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="AttachmentId" class="text-danger d-block mt-2"></span>
                        <span id="fileError" class="text-danger d-block mt-2"></span>
                    </div>
                </section>
            }
        </div>

        @* ---------- Checklist ---------- *@
        <div class="col-xl-4">
            <aside class="card tps-aside" aria-label="Before you submit">
                <div class="card-header">
                    <h4 class="card-title">Before you submit</h4>
                </div>
                <div class="card-body">
                    <ul class="tps-rule-list">
                        <li><i class="ri-checkbox-circle-line"></i><span>Choose a decision. You can't submit a result as Pending.</span></li>
                        @if (scoresInterview)
                        {
                            <li><i class="ri-checkbox-circle-line"></i><span>Give a score from 0 to 5. To accept the candidate, the score must be 3 or higher.</span></li>
                            <li><i class="ri-checkbox-circle-line"></i><span>Upload the completed evaluation form (up to 10 MB).</span></li>
                        }
                        @if (recordsExperience)
                        {
                            <li><i class="ri-checkbox-circle-line"></i><span>Enter the candidate's actual experience in years.</span></li>
                        }
                        <li><i class="ri-checkbox-circle-line"></i><span>If you reject, explain why in the notes.</span></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm before the result is saved.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary"
               asp-action="MyInterviews"
               asp-route-statusFilter="@ViewBag.statusFilter"
               asp-route-companyFilter="@ViewBag.companyFilter"
               asp-route-trackFilter="@ViewBag.trackFilter">
                Cancel
            </a>
            <button type="button" class="btn btn-primary px-4" id="submitButton"><i class="ri-send-plane-line me-1"></i> Submit result</button>
        </div>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        // Allow only numbers and decimal in Score and Actual Experience fields
        $('.score, .actualexperience').on('input', function () {
            this.value = this.value.replace(/[^0-9.]/g, '');
        });

        // Score scale indicator
        function renderScale() {
            var value = parseFloat($('[name="Score"]').val());
            $('#scoreScale span').each(function (i) {
                $(this).toggleClass('is-on', !isNaN(value) && value >= i + 1);
            });
            $('#scoreScale').attr('data-value', isNaN(value) ? null : value);
        }
        $('[name="Score"]').on('input', renderScale);
        renderScale();

        // ---------- Evaluation upload ----------
        const fileInput = $('#file');
        const fileUploadArea = $('#fileUploadArea');
        const filePreviewContainer = $('#filePreviewContainer');
        const fileName = $('#fileName');
        const fileSize = $('#fileSize');
        const removeFileBtn = $('#removeFileBtn');
        const fileError = $('#fileError');

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function showFilePreview(file) {
            fileName.text(file.name);
            fileSize.text(formatFileSize(file.size));
            filePreviewContainer.show();
            fileUploadArea.removeClass('has-error').addClass('has-file');
        }

        function hideFilePreview() {
            filePreviewContainer.hide();
            fileInput.val('');
            fileUploadArea.removeClass('has-file has-error');
            fileError.text('');
        }

        fileInput.on('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 10 * 1024 * 1024) {
                    fileError.text('This file is larger than 10 MB. Choose a smaller file.');
                    hideFilePreview();
                    fileUploadArea.addClass('has-error');
                    return;
                }
                showFilePreview(file);
                fileError.text('');
            }
        });

        removeFileBtn.on('click', function (e) {
            e.stopPropagation();
            hideFilePreview();
        });

        fileUploadArea.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).addClass('dragover');
        });

        fileUploadArea.on('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
        });

        fileUploadArea.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');

            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (file.size > 10 * 1024 * 1024) {
                    fileError.text('This file is larger than 10 MB. Choose a smaller file.');
                    fileUploadArea.addClass('has-error');
                    return;
                }
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                fileInput[0].files = dataTransfer.files;
                showFilePreview(file);
                fileError.text('');
            }
        });

        // ---------- Submit ----------
        $('#submitButton').click(function () {
            var isValid = true;
            var scoreValue = $('[name="Score"]').val();
            var statusValue = $('[name="StatusId"]').val();
            var fileSelected = fileInput.val();

            if ($('[name="Score"]').is(":visible")) {
                if (!scoreValue || scoreValue < 0 || scoreValue > 5 || (statusValue === "2" && scoreValue < 3)) {
                    $('[name="Score"]').next(".text-danger").text("Enter a score from 0 to 5. To accept, the score must be at least 3.");
                    isValid = false;
                } else {
                    $('[name="Score"]').next(".text-danger").text("");
                }
            }

            if ($('[name="ActualExperience"]').is(":visible")) {
                var actualExperience = $('[name="ActualExperience"]').val();
                if (!actualExperience || isNaN(actualExperience) || actualExperience < 0) {
                    $('[name="ActualExperience"]').next(".text-danger").text("Enter the experience in years (0 or more).");
                    isValid = false;
                } else {
                    $('[name="ActualExperience"]').next(".text-danger").text("");
                }
            }

            if (!statusValue) {
                $('[name="StatusId"]').next(".text-danger").text("Choose a decision.");
                isValid = false;
            } else {
                $('[name="StatusId"]').next(".text-danger").text("");
            }

            if (statusValue === "3" && !window.CKEditorManager.getPlainText('Notes')) {
                const notesTextarea = document.getElementById('Notes');
                const wrapper = notesTextarea?.closest('.ckeditor-component-wrapper');
                if (wrapper) wrapper.classList.add('is-invalid');
                $('#notes-client-validation').text("Explain the reason for rejecting the candidate.");
                isValid = false;
            } else {
                const notesTextarea = document.getElementById('Notes');
                const wrapper = notesTextarea?.closest('.ckeditor-component-wrapper');
                if (wrapper) wrapper.classList.remove('is-invalid');
                $('#notes-client-validation').text("");
            }

            if (fileInput.is(":visible") && !fileSelected) {
                fileError.text("Upload the completed evaluation form.");
                fileUploadArea.addClass('has-error');
                isValid = false;
            } else {
                fileUploadArea.removeClass('has-error');
            }

            if (!isValid) {
                var first = $('#updateForm .text-danger').filter(function () { return $(this).text().trim().length > 0; }).first();
                if (first.length) first[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            var decision = $('[name="StatusId"] option:selected').text();
            Swal.fire({
                title: 'Submit this result?',
                html: 'Decision: <strong>' + $('<div>').text(decision).html() + '</strong>'
                    + (scoreValue ? ' · Score <strong>' + $('<div>').text(scoreValue).html() + ' / 5</strong>' : ''),
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Submit result',
                cancelButtonText: 'Back',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#updateForm').submit();
                }
            });
        });
    });
</script>
