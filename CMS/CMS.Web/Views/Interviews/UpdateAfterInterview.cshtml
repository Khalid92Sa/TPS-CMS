@using CMS.Domain.Enums;
@model CMS.Application.DTOs.InterviewsDTO

<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }

    .btn-link {
        font-size: 11px;
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

        .btn-link:hover {
            color: white;
            text-decoration: underline;
        }
</style>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 style="color:white !important">Adding Interview Result: <span style="color:#c50000;">@Model.FullName</span></h2>
        </div>
        <div class="card-body">
            <form asp-action="UpdateAfterInterview" id="updateForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="InterviewsId" />
                <input type="hidden" asp-for="InterviewerId" />
                <input type="hidden" asp-for="EvalutaionFormId" />
                <input type="hidden" asp-for="CandidateId" />
                <input type="hidden" asp-for="PositionId" />
                <input type="hidden" asp-for="isUpdated" />

                <div class="row">
                    @if ((User.IsInRole("Interviewer") || User.IsInRole("Solution Architecture")) && Model.ParentId == null)
                    {
                        <!-- Score -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Score"><span class="text-danger">*</span> Score out of 5:</label>
                            <input asp-for="Score" class="form-control score" />
                            <span asp-validation-for="Score" class="text-danger"></span>
                        </div>
                    }

                    @if (!User.IsInRole("HR Manager"))
                    {
                        <!-- Actual Experience -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActualExperience"><span class="text-danger">*</span> Actual Experience:</label>
                            <input asp-for="ActualExperience" class="form-control actualexperience" pattern="^(?:0(\.\d+)?|[1-9]\d*(\.\d+)?)$" title="Experience must be a non-negative numeric value." />
                            <span asp-validation-for="ActualExperience" class="text-danger"></span>
                        </div>
                    }

                    <!-- Status -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StatusId" class="control-label"><span class="text-danger">*</span> Status</label>
                        @if (ViewBag.StatusDTOs != null)
                        {
                            <select asp-for="StatusId" class="form-control">
                                <option value="">Select a Status</option>
                                @foreach (var sta in ViewBag.StatusDTOs)
                                {
                                    if (sta.Text != StatusCode.GetName("PND"))
                                    {
                                        <option value="@sta.Value">@sta.Text</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <p>No statuses available.</p>
                        }
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div>

                    <!-- Notes -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Notes">Notes:</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>

                @if ((User.IsInRole("Interviewer") || User.IsInRole("Solution Architecture")) && Model.ParentId == null)
                {
                    @if (Model.EvalutaionFormId != null)
                    {
                        <div class="alert alert-info mt-4">
                            <p>
                                Please download the evaluation form by clicking the link below. After making the necessary modifications, please upload the modified form using the file input field.
                            </p>
                            <a class="btn btn-link" asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.EvalutaionFormId">Download Evaluation Form</a>
                        </div>
                    }

                    <!-- Upload Evaluation -->
                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label for="file"><span class="text-danger">*</span> Upload An Evaluation:</label>
                            <input type="file" id="file" name="file" class="form-control-file" />
                            <br />
                            <span asp-validation-for="AttachmentId" class="text-danger"></span>
                            <br />
                            <span id="fileError" class="text-danger"></span>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-success" id="submitButton">Submit</button>
                    <a class="btn btn-secondary" asp-action="MyInterviews">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>

<script>
    $(document).ready(function () {
        // Allow only numbers and decimal in Score and Actual Experience fields
        $('.score, .actualexperience').on('input', function () {
            this.value = this.value.replace(/[^0-9.]/g, '');
        });

        $('#submitButton').click(function () {
            var isValid = true;
            var scoreValue = $('[name="Score"]').val();
            var statusValue = $('[name="StatusId"]').val();
            var fileInput = $('#file');
            var fileSelected = fileInput.val();

            if ($('[name="Score"]').is(":visible")) {
                if (!scoreValue || scoreValue < 0 || scoreValue > 5 || (statusValue === "2" && scoreValue < 3)) {
                    $('[name="Score"]').next(".text-danger").text("Score must be between 0 and 5. If status is Accepted, score should be at least 3.");
                    isValid = false;
                } else {
                    $('[name="Score"]').next(".text-danger").text("");
                }
            }

            if ($('[name="ActualExperience"]').is(":visible")) {
                var actualExperience = $('[name="ActualExperience"]').val();
                if (!actualExperience || isNaN(actualExperience) || actualExperience < 0) {
                    $('[name="ActualExperience"]').next(".text-danger").text("Actual Experience must be a positive number or zero.");
                    isValid = false;
                } else {
                    $('[name="ActualExperience"]').next(".text-danger").text("");
                }
            }

            if (!statusValue) {
                $('[name="StatusId"]').next(".text-danger").text("Status is required.");
                isValid = false;
            }

            if (statusValue === "3" && !$('[name="Notes"]').val()) {
                $('[name="Notes"]').next(".text-danger").text("Please provide a reason for rejection.");
                isValid = false;
            }

            if (fileInput.is(":visible") && !fileSelected) {
                $('#fileError').text("Please choose a file to upload.");
                isValid = false;
            }

            if (!isValid) return;

            Swal.fire({
                title: 'Are you sure?',
                text: 'You are about to submit the form.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, submit it!',
                cancelButtonText: 'No, cancel!',
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#updateForm').submit();
                }
            });
        });
    });
</script>
