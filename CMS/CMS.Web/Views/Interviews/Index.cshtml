@using CMS.Domain.Enums;

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
@model IEnumerable<CMS.Application.DTOs.InterviewsDTO>
@{
    ViewData["Title"] = "Interviews";
    var archiId = ViewBag.ArchiId as string;
}

<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }

    a.disabled {
        color: #6c757d;
        pointer-events: none;
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>

@using (Html.BeginForm("Index", "Interviews", FormMethod.Get, new { id = "filterForm", onsubmit = "return validateForm();" }))
{
    <div class="form-group mb-3">
        <div class="row align-items-end">
            <div class="col-md-3">
                @Html.Label("Filter by Status:")
                @Html.DropDownList("statusFilter", ViewBag.StatusList as SelectList, "All Statuses", new { @class = "form-control" })
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Candidate Name:")
                <input type="text" id="candidateFilter" name="candidateFilter" class="form-control" placeholder="Search by Candidate Name" value="@ViewBag.candidateFilter">
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Track:")
                @Html.DropDownList("trackFilter", ViewBag.TrackList as SelectList, "All Tracks", new { @class = "form-control" })
            </div>

            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary mt-4 w-50 me-2" title="Filter Interviews">
                    Filter
                </button>
                <button type="button" id="resetButton" class="btn btn-secondary mt-4 w-50" title="Reset Filters">
                    Reset
                </button>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                
                    <div>
                        <a asp-action="Create" class="btn btn-primary">Schedule New Interview</a>
                    </div>

            </div>
            <div class="card-body">
                <table id="add-rows" class="display nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Candidate Name</th>
                            <th>Level</th>
                            <th>Track</th>
                            <th>Interviewer/s</th>
                            <th hidden>Second Interviewer</th>
                            <th>Architecture</th>
                            <th>Date and Time</th>
                            <th>Status</th>
                            <th hidden>Parent ID</th>
                            <th hidden>Score</th>
                            <th hidden>Actual Experience</th>
                            <th hidden>Notes</th>
                            <th hidden>Evaluation</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            var sortedInterviews = Model.OrderByDescending(x => x.CreatedOn).ToList();

                            for (var i = 0; i < sortedInterviews.Count(); i++)
                            {
                                var item = sortedInterviews[i];

                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.TrackName)</td>
                                    @if (item.SecondInterviewerName == "User not found")
                                    {
                                        <td>@item.InterviewerName</td>
                                    }
                                    else
                                    {
                                        <td>
                                            <div>1-@item.InterviewerName</div>
                                            <div>2-@item.SecondInterviewerName</div>
                                        </td>
                                    }
                                    @if (item.SecondInterviewerId != null)
                                    {
                                        <td hidden>@item.SecondInterviewerName</td>
                                    }
                                    else
                                    {
                                        <td hidden>There is no Second Interviewer</td>
                                    }  
                                    
                                    @if (item.ArchitectureInterviewerId != null)
                                    {
                                        if (item.ArchitectureInterviewerId == "User not found")
                                        {
                                            <td>No Architecture Interviewer</td>
                                        }
                                        else
                                        {
                                        <td>@item.ArchitectureInterviewerName</td>
                                        }
                                    }
                                    else
                                    {
                                        <td>No Architecture Interviewer</td>
                                    }
                                    <td>
                                        <div>@item.Date.ToString("dd-MM-yyyy")</div>
                                        <div>@item.Date.ToString("h:mm tt")</div>
                                    </td>
                                    <td>@item.StatusName</td>
                                    <td hidden>@item.ParentId</td>
                                    <td hidden>@item.Score</td>
                                    <td hidden>@item.ActualExperience</td>
                                    <td hidden>@item.Notes</td>
                                    @if (item.AttachmentId != null)
                                    {
                                        <td hidden><a asp-controller="Attachments" asp-action="Download" asp-route-id="@item.AttachmentId">Download evaluation</a></td>
                                    }
                                    else
                                    {
                                        <td hidden></td>
                                    }
                                    <td>
                                        @if (item.StartFromHR)
                                        {
                                            <a class="bx bx-detail" style="font-size:x-large"
                                               asp-action="HRFirstDetails"
                                               asp-route-id="@item.InterviewsId"
                                               asp-route-statusFilter="@ViewBag.statusFilter"
                                               asp-route-candidateFilter="@ViewBag.candidateFilter"
                                               asp-route-trackFilter="@ViewBag.trackFilter"
                                               asp-route-pageNumber="@ViewBag.PageNumber"
                                               asp-route-pageSize="@ViewBag.PageSize"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="left"
                                               data-bs-original-title="Details"></a>
                                        }
                                        else
                                        {
                                            <a class="bx bx-detail" style="font-size:x-large"
                                               asp-action="Details"
                                               asp-route-id="@item.InterviewsId"
                                               asp-route-statusFilter="@ViewBag.statusFilter"
                                               asp-route-candidateFilter="@ViewBag.candidateFilter"
                                               asp-route-trackFilter="@ViewBag.trackFilter"
                                               asp-route-pageNumber="@ViewBag.PageNumber"
                                               asp-route-pageSize="@ViewBag.PageSize"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="left"
                                               data-bs-original-title="Details"></a>
                                        }

                                        @if (((item.InterviewerRole == "Interviewer" || item.InterviewerRole == "General Manager" || item.InterviewerRole == "Solution Architecture") && item.StatusName == StatusCode.GetName("PND") && item.ParentId == null) || (item.StatusName == StatusCode.GetName("PND") && item.InterviewerRole == "HR Manager" && item.WorkflowStageId == (short)EnumWorkflowStage.HRInitialInterview))
                                        {
                                            <input type="hidden" name="StatusId" value="@item.StatusId" />
                                            <a class="bx bxs-edit-alt" style="font-size:x-large" asp-action="Edit" asp-route-statusFilter="@ViewBag.statusFilter"
                                               asp-route-candidateFilter="@ViewBag.candidateFilter"
                                               asp-route-trackFilter="@ViewBag.trackFilter"
                                               asp-route-pageNumber="@ViewBag.PageNumber"
                                               asp-route-pageSize="@ViewBag.PageSize" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Edit"></a>
                                            <a class="ri-delete-bin-2-line text-danger" style="font-size:x-large" asp-action="Delete" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Delete"></a>
                                        }

                                        @if (item.InterviewerRole == "General Manager"
                                           && item.SecondInterviewerId == null
                                           && item.ArchitectureInterviewerId == null
                                           && item.StatusName == StatusCode.GetName("PND")
                                           && item.ParentId is not null
                                           && item.StopCycleNote is null)
                                        {
                                            <a class="bx bx-user-plus" style="font-size:x-large; color:green"
                                               asp-action="AssignArchitectureInterviewer"
                                               asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="bottom"
                                               data-bs-original-title="Add Architecture"></a>
                                        }

                                        @if (item.InterviewerRole == "General Manager"
                                          && item.SecondInterviewerId == archiId
                                          && item.ArchitectureInterviewerId == null
                                          && item.StatusName == StatusCode.GetName("PND")
                                          && item.ParentId is not null
                                          && item.StopCycleNote is null)
                                        {
                                            <a class="bx bx-user-minus" style="font-size:x-large; color:red"
                                               asp-action="AssignArchitectureInterviewer"
                                               asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="bottom"
                                               data-bs-original-title="Edit/Remove Architecture"></a>
                                        }


                                        @if (item.StatusName != StatusCode.GetName("PND"))
                                        {
                                            <a class="ri-shut-down-line disabled" style="font-size: x-large" asp-action="StopCycle"
                                               asp-route-statusFilter="@ViewBag.statusFilter"
                                               asp-route-candidateFilter="@ViewBag.candidateFilter"
                                               asp-route-trackFilter="@ViewBag.trackFilter"
                                               asp-route-pageNumber="@ViewBag.PageNumber"
                                               asp-route-pageSize="@ViewBag.PageSize" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Stop Cycle"></a>
                                        }
                                        else if(item.ParentId != null)
                                        {
                                            <a class="ri-shut-down-line" style="font-size: x-large" asp-action="StopCycle"
                                               asp-route-statusFilter="@ViewBag.statusFilter"
                                               asp-route-candidateFilter="@ViewBag.candidateFilter"
                                               asp-route-trackFilter="@ViewBag.trackFilter"
                                               asp-route-pageNumber="@ViewBag.PageNumber"
                                               asp-route-pageSize="@ViewBag.PageSize" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Stop Cycle"></a>
                                        }
                                       
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>
    </div><!--end col-->
</div><!--end row-->
<script>
     $.noConflict();
    jQuery(document).ready(function ($) {
        $('#add-rows').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',
            scrollX: true, 
            autoWidth: false,
            fixedHeader: true,
            columnDefs: [
                { targets: 'hidden', visible: false }
            ]
        });

        $('#resetButton').on('click', function () {
            $('#statusFilter').val('');
            $('#candidateFilter').val('');
            $('#trackFilter').val('');
            window.location.href = '@Url.Action("Index", "Interviews")';
        });
    });

</script>

<script>
    function removeTrailingSpaces() {
        var candidateFilter = document.getElementById("candidateFilter");
        candidateFilter.value = candidateFilter.value.trim();
    }

    function validateForm() {
        removeTrailingSpaces();
        return true;
    }
</script>
