@model CMS.Application.DTOs.DelegateInterviewPageDTO
@{
    ViewData["Title"] = "Delegate Pending Interview";
    bool hasSecondInterviewer = !string.IsNullOrEmpty(Model.SecondInterviewerId);
}

<style>
    .details-card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        color: white;
        padding: 20px;
    }

    .card-body-custom {
        padding: 20px;
    }
</style>

<div class="container mt-4">
    <div class="card details-card">
        <div class="card-header card-header-custom">
            <h4 class="mb-0" style="color:white;">Delegate Pending Interview</h4>
        </div>
        <div class="card-body card-body-custom">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            <p>
                The assigned interviewer stays on this interview.
                The delegated user receives temporary access to enter the score for this interview only, until the expiration time.
                Their account role is not changed.
            </p>

            <dl class="row">
                <dt class="col-sm-3">Candidate</dt>
                <dd class="col-sm-9">@Model.CandidateName</dd>
                <dt class="col-sm-3">Position</dt>
                <dd class="col-sm-9">@Model.PositionName</dd>
                <dt class="col-sm-3">Interview date</dt>
                <dd class="col-sm-9">@Model.InterviewDate.ToString("dd/MM/yyyy hh:mm tt")</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.StatusName</dd>
                <dt class="col-sm-3">Assigned interviewer</dt>
                <dd class="col-sm-9">@Model.PrimaryInterviewerName (@Model.PrimaryRole)</dd>
                @if (hasSecondInterviewer)
                {
                    <dt class="col-sm-3">Second interviewer</dt>
                    <dd class="col-sm-9">@Model.SecondInterviewerName (@Model.SecondRole)</dd>
                }
            </dl>

            <form id="delegateForm" asp-action="Delegate" asp-route-id="@Model.InterviewId" method="post" novalidate data-candidate="@Model.CandidateName">
                @Html.AntiForgeryToken()

                @if (hasSecondInterviewer)
                {
                    <div class="form-group mb-3">
                        <label class="form-label">Cover this interviewer</label>
                        <div>
                            <label class="me-3">
                                <input type="radio" name="interviewerSlot" value="Primary|@Model.PrimaryInterviewerId" checked />
                                @Model.PrimaryInterviewerName
                            </label>
                            <label>
                                <input type="radio" name="interviewerSlot" value="Second|@Model.SecondInterviewerId" />
                                @Model.SecondInterviewerName
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" name="interviewerSlot" value="Primary|@Model.PrimaryInterviewerId" />
                }

                <div class="form-group mb-3">
                    <label class="form-label" for="delegatedUserId">Delegated User <span class="text-danger">*</span></label>
                    <select id="delegatedUserId" name="delegatedUserId" class="form-control">
                        <option value="">-- Select user --</option>
                        @foreach (var user in Model.DelegateCandidates)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                    <span id="delegatedUserError" class="text-danger" style="display:none;">Please select a delegated user.</span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label" for="durationId">Duration</label>
                    <select id="durationId" name="durationId" class="form-control">
                        <option value="">-- Select duration --</option>
                        @foreach (var duration in Model.Durations)
                        {
                            <option value="@duration.Id">@duration.Name</option>
                        }
                    </select>
                    @if (Model.Durations.Count == 0)
                    {
                        <span class="text-muted">No active durations are available. Add one from Delegation Durations.</span>
                    }
                </div>

                <button type="submit" class="btn btn-primary">Delegate</button>
                <a asp-action="Delegation" class="btn btn-secondary">Cancel</a>
            </form>

            <hr />
            <h5>Delegation History</h5>
            @if (Model.History.Count == 0)
            {
                <p class="text-muted mb-0">No previous delegations.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Original interviewer</th>
                            <th>Delegated user</th>
                            <th>Delegated by</th>
                            <th>Delegation date</th>
                            <th>Duration</th>
                            <th>Expiry</th>
                            <th>Status</th>
                            <th>Removed by</th>
                            <th>Removed on</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.History)
                        {
                            <tr class="@(item.Status == "Active" ? "table-success" : null)">
                                <td>@item.OriginalInterviewerName</td>
                                <td>
                                    @item.DelegatedUserName
                                    @if (item.CanRemove)
                                    {
                                        <form id="removeDelegate-@item.Id" asp-action="RemoveDelegate" asp-route-id="@Model.InterviewId" asp-route-delegationId="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-2 remove-delegate" data-user="@item.DelegatedUserName" data-form="removeDelegate-@item.Id">Remove delegate</button>
                                        </form>
                                    }
                                </td>
                                <td>@item.DelegatedByName</td>
                                <td>@item.CreatedOn.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>@item.Duration</td>
                                <td>@item.ExpirationDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-secondary">Expired</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Removed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>
                                <td>@item.RemovedByName</td>
                                <td>@(item.RemovedOn.HasValue ? item.RemovedOn.Value.ToString("dd/MM/yyyy hh:mm tt") : null)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var allowDelegateSubmit = false;

    document.getElementById('delegateForm').addEventListener('submit', function (event) {
        if (allowDelegateSubmit)
            return;

        event.preventDefault();
        var userSelect = document.getElementById('delegatedUserId');
        var userError = document.getElementById('delegatedUserError');
        if (!userSelect.value) {
            userError.style.display = 'block';
            userSelect.focus();
            return;
        }

        userError.style.display = 'none';
        var userName = userSelect.options[userSelect.selectedIndex].text;
        var durationSelect = document.getElementById('durationId');
        var durationName = durationSelect.value
            ? durationSelect.options[durationSelect.selectedIndex].text
            : 'no duration selected';
        var candidate = this.getAttribute('data-candidate') || 'this candidate';

        Swal.fire({
            title: 'Are you sure?',
            text: 'You are about to give ' + userName + ' temporary access to score ' + candidate + ' for ' + durationName + '.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delegate!',
            cancelButtonText: 'No, cancel!'
        }).then(function (result) {
            if (result.isConfirmed) {
                allowDelegateSubmit = true;
                document.getElementById('delegateForm').submit();
            }
        });
    });

    document.getElementById('delegatedUserId').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('delegatedUserError').style.display = 'none';
        }
    });

    document.querySelectorAll('.remove-delegate').forEach(function (button) {
        button.addEventListener('click', function () {
            var userName = button.getAttribute('data-user') || 'this user';
            var form = document.getElementById(button.getAttribute('data-form'));
            Swal.fire({
                title: 'Are you sure?',
                text: 'You are about to remove ' + userName + ' from this interview. They will lose access immediately.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove!',
                cancelButtonText: 'No, cancel!'
            }).then(function (result) {
                if (result.isConfirmed && form)
                    form.submit();
            });
        });
    });
</script>
