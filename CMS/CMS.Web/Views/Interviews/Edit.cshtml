@using CMS.Domain.Enums;
@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Edit Interview";
}

<style>
    /* Client-side messages start hidden; the page script shows them when needed */
    #interviewerIdError,
    #candidateIdError,
    #positionIdError,
    #trackIdError,
    #dateValidationMessage {
        display: none;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<form asp-action="Edit" asp-route-id="@Model.InterviewsId" id="editForm" class="needs-validation" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="InterviewsId" />
    <input type="hidden" asp-for="StatusId" />
    <input type="hidden" asp-for="WorkflowStageId" />
    <input type="hidden" asp-for="ParentId" />
    <input asp-for="AttachmentId" hidden />

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--icon" aria-hidden="true"><i class="ri-edit-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Editing interview</p>
                <h2 class="tps-ihead__name" dir="auto" data-summary-title>@(Model.FullName ?? "Interview")</h2>
                <div class="tps-ihead__meta">
                    @if (!string.IsNullOrEmpty(Model.StatusName))
                    {
                        @InterviewStatusUi.Badge(Model.StatusName)
                    }
                    <span class="tps-chip"><i class="ri-calendar-event-line"></i>Currently @Model.Date.ToString("dd MMM yyyy, h:mm tt")</span>
                </div>
            </div>
        </div>
        <div class="tps-ihead__actions">
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.InterviewsId"><i class="ri-file-list-3-line me-1"></i> View details</a>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8">

            @* ---------- 1. Candidate & role ---------- *@
            <section class="card tps-fsection" aria-labelledby="sec-candidate">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-user-star-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-candidate">Candidate &amp; role</h4>
                        <p class="tps-fsection__desc">Who is being interviewed, and for which level and track.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field tps-span-all">
                            <label asp-for="CandidateId" class="form-label">Candidate <span class="tps-req">*</span></label>
                            @Html.DropDownListFor(model => model.CandidateId, (SelectList)ViewBag.candidateList, "Search for a candidate…", new { @class = "form-select", id = "CandidateId", data_searchable = "" })
                            <span id="candidateIdError" class="tps-field-error"></span>
                            <span asp-validation-for="CandidateId" class="text-danger"></span>
                        </div>

                        <div class="tps-field">
                            <label asp-for="PositionId" class="form-label">Level <span class="tps-req">*</span></label>
                            @Html.DropDownListFor(model => model.PositionId, (SelectList)ViewBag.positionList, "Select a level…", new { @class = "form-select", id = "PositionId", data_searchable = "" })
                            <span id="positionIdError" class="tps-field-error"></span>
                            <span asp-validation-for="PositionId" class="text-danger"></span>
                        </div>

                        <div class="tps-field">
                            <label asp-for="TrackId" class="form-label">Track <span class="tps-req">*</span></label>
                            <select asp-for="TrackId" asp-items="@(ViewBag.Tracks)" class="form-select" id="TrackId" data-searchable>
                                <option value="">Select a track…</option>
                            </select>
                            <span id="trackIdError" class="tps-field-error"></span>
                            <span asp-validation-for="TrackId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            @* ---------- 2. Interview panel ---------- *@
            <section class="card tps-fsection" aria-labelledby="sec-panel">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-team-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-panel">Interview panel</h4>
                        <p class="tps-fsection__desc">The interviewers who will run the first interview and submit its result.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="InterviewerId" class="form-label">Interviewer 1 <span class="tps-req">*</span></label>
                            <select asp-for="InterviewerId" asp-items="@(ViewBag.interviewersList)" class="form-select" id="InterviewerId" data-searchable>
                                <option value="">Search for an interviewer…</option>
                            </select>
                            <span id="interviewerIdError" class="tps-field-error">Select the first interviewer.</span>
                            <span id="interviewerIdDuplicateError" class="tps-field-error" style="display: none;">This person is already Interviewer 2.</span>
                            <span asp-validation-for="InterviewerId" class="text-danger"></span>
                        </div>

                        <div class="tps-field">
                            <label asp-for="SecondInterviewerId" class="form-label">Interviewer 2 <span class="text-muted fw-normal">(optional)</span></label>
                            <select asp-for="SecondInterviewerId" asp-items="@(ViewBag.interviewersList)" class="form-select" id="SecondInterviewerId" data-searchable>
                                <option value="">No second interviewer</option>
                            </select>
                            <span id="secondInterviewerIdError" class="tps-field-error" style="display: none;">This person is already Interviewer 1.</span>
                            <span asp-validation-for="SecondInterviewerId" class="text-danger"></span>
                        </div>

                        <div class="tps-field tps-span-all">
                            <label asp-for="ArchitectureInterviewerId" class="form-label">Architecture interviewer <span class="text-muted fw-normal">(optional)</span></label>
                            <select asp-for="ArchitectureInterviewerId" asp-items="@(ViewBag.architecturesList)" class="form-select" id="ArchitectureInterviewerId">
                                <option value="">No architecture review</option>
                            </select>
                            <div class="tps-hint" id="architectureHint">Not available when a General Manager is on the panel.</div>
                        </div>
                    </div>
                </div>
            </section>

            @* ---------- 3. Schedule & workflow ---------- *@
            <section class="card tps-fsection" aria-labelledby="sec-schedule">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-calendar-event-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-schedule">Schedule &amp; workflow</h4>
                        <p class="tps-fsection__desc">When the interview happens and which stages follow it.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="Date" class="form-label">Date and time <span class="tps-req">*</span></label>
                            <input asp-for="Date" onclick="this.showPicker()" class="form-control" id="Date" />
                            <span id="dateValidationMessage" class="tps-field-error">Choose the interview date and time.</span>
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="tps-span-all">
                            <label class="tps-switch-card form-switch" for="StartFromHR">
                                <input class="form-check-input" type="checkbox" asp-for="StartFromHR" id="StartFromHR" role="switch" />
                                <span>
                                    <span class="tps-switch-card__title">Start the workflow with HR</span>
                                    <span class="tps-switch-card__desc d-block">HR interviews first, then the interviewers, and the General Manager reviews last.</span>
                                    <span class="tps-flow" id="flowPreview" aria-live="polite"></span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* ---------- Live summary ---------- *@
        <div class="col-xl-4">
            <aside class="card tps-aside" aria-label="Interview summary">
                <div class="card-header">
                    <h4 class="card-title">Summary</h4>
                </div>
                <div class="card-body">
                    <ul class="tps-summary">
                        <li><i class="ri-user-star-line"></i><div><div class="tps-summary__label">Candidate</div><div class="tps-summary__value" data-summary="candidate">Not selected</div></div></li>
                        <li><i class="ri-briefcase-4-line"></i><div><div class="tps-summary__label">Level · Track</div><div class="tps-summary__value" data-summary="level-track">Not selected</div></div></li>
                        <li><i class="ri-team-line"></i><div><div class="tps-summary__label">Panel</div><div class="tps-summary__value" data-summary="panel">Not selected</div></div></li>
                        <li><i class="ri-calendar-event-line"></i><div><div class="tps-summary__label">When</div><div class="tps-summary__value" data-summary="date">Not set</div></div></li>
                    </ul>
                    <hr />
                    <p class="text-muted fs-13 mb-0"><i class="ri-information-line me-1"></i> Changes apply to this interview step only.</p>
                </div>
            </aside>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index" asp-route-statusFilter="@ViewBag.statusFilter"
               asp-route-candidateFilter="@ViewBag.candidateFilter"
               asp-route-trackFilter="@ViewBag.trackFilter"
               asp-route-pageNumber="@ViewBag.PageNumber"
               asp-route-pageSize="@ViewBag.PageSize">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save changes</button>
        </div>
    </div>
</form>

<script>
    $(document).ready(function () {
        // Show duplicate-interviewer errors returned by the server
        var interviewer1ErrorSpan = $('span[data-valmsg-for="InterviewerId"].field-validation-error');
        var interviewer2ErrorSpan = $('span[data-valmsg-for="SecondInterviewerId"].field-validation-error');

        var interviewer1Error = interviewer1ErrorSpan.text();
        var interviewer2Error = interviewer2ErrorSpan.text();

        if (interviewer1Error && interviewer1Error.includes('Interviewer #2')) {
            $('#interviewerIdDuplicateError').text(interviewer1Error.trim()).show();
        }
        if (interviewer2Error && interviewer2Error.includes('Interviewer #1')) {
            $('#secondInterviewerIdError').text(interviewer2Error.trim()).show();
        }

        // Validate interviewer selection - check if Interviewer #1 and #2 are the same
        function validateInterviewerSelection(changedField) {
            var interviewer1 = $('#InterviewerId').val();
            var interviewer2 = $('#SecondInterviewerId').val();

            if (interviewer1 && interviewer2 && interviewer1 === interviewer2) {
                if (changedField === 'InterviewerId') {
                    $('#interviewerIdDuplicateError').show();
                    $('#secondInterviewerIdError').hide();
                } else if (changedField === 'SecondInterviewerId') {
                    $('#secondInterviewerIdError').show();
                    $('#interviewerIdDuplicateError').hide();
                } else {
                    $('#secondInterviewerIdError').show();
                    $('#interviewerIdDuplicateError').hide();
                }
                return false;
            } else {
                $('#secondInterviewerIdError').hide();
                $('#interviewerIdDuplicateError').hide();
                return true;
            }
        }

        // When a General Manager is on the panel, the architecture interviewer is not used
        function checkAndDisableArchitectureInterviewer() {
            var gmUserIds = @Html.Raw(Json.Serialize(ViewBag.GMUserIds ?? new List<string>()));
            var interviewer1 = $('#InterviewerId').val();
            var interviewer2 = $('#SecondInterviewerId').val();
            var architectureField = $('#ArchitectureInterviewerId');

            var isGMSelected = (interviewer1 && gmUserIds.includes(interviewer1)) ||
                               (interviewer2 && gmUserIds.includes(interviewer2));

            if (isGMSelected) {
                architectureField.prop('disabled', true);
                architectureField.val('');
            } else {
                architectureField.prop('disabled', false);
            }
            $('#architectureHint').toggleClass('text-warning', !!isGMSelected);
        }

        $(document).on('change', '#InterviewerId', function () {
            validateInterviewerSelection('InterviewerId');
            checkAndDisableArchitectureInterviewer();
        });
        $(document).on('change', '#SecondInterviewerId', function () {
            validateInterviewerSelection('SecondInterviewerId');
            checkAndDisableArchitectureInterviewer();
        });

        checkAndDisableArchitectureInterviewer();

        // ---------- Live summary and workflow preview ----------
        function selectedText(selector) {
            var el = $(selector)[0];
            return el && el.value ? el.options[el.selectedIndex].text : '';
        }

        function setSummary(key, text) {
            var el = document.querySelector('[data-summary="' + key + '"]');
            if (!el) return;
            el.textContent = text || (key === 'date' ? 'Not set' : 'Not selected');
            el.classList.toggle('is-empty', !text);
        }

        function formatDate(value) {
            if (!value) return '';
            var d = new Date(value);
            return isNaN(d.getTime()) ? value : d.toLocaleString(undefined, { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        function renderFlow() {
            var steps = $('#StartFromHR').is(':checked')
                ? ['HR', 'Interviewers', 'General Manager']
                : ['Interviewers', 'Management review', 'Decision'];
            document.getElementById('flowPreview').innerHTML =
                steps.map(function (s) { return '<span>' + s + '</span>'; }).join('<i class="ri-arrow-right-s-line"></i>');
        }

        function updateSummary() {
            var candidate = selectedText('#CandidateId');
            setSummary('candidate', candidate);
            if (candidate) $('[data-summary-title]').text(candidate);
            setSummary('level-track', [selectedText('#PositionId'), selectedText('#TrackId')].filter(Boolean).join(' · '));
            var panel = [selectedText('#InterviewerId'), selectedText('#SecondInterviewerId')].filter(Boolean);
            var arch = selectedText('#ArchitectureInterviewerId');
            setSummary('panel', panel.join(' & ') + (arch ? ' + ' + arch + ' (architecture)' : ''));
            setSummary('date', formatDate($('#Date').val()));
            renderFlow();
        }

        $('#editForm').on('change input', 'select, input', updateSummary);
        updateSummary();

        // ---------- Submit ----------
        $('#editForm').submit(function (e) {
            e.preventDefault();

            var isValid = true;

            var candidateId = $('#CandidateId').val();
            var positionId = $('#PositionId').val();
            var trackId = $('#TrackId').val();
            var interviewerId = $('#InterviewerId').val();
            var date = $('#Date').val();

            if (!candidateId) {
                $('#candidateIdError').text('Select the candidate.').show();
                isValid = false;
            } else {
                $('#candidateIdError').hide();
            }

            if (!positionId) {
                $('#positionIdError').text('Select the level.').show();
                isValid = false;
            } else {
                $('#positionIdError').hide();
            }

            if (!trackId) {
                $('#trackIdError').text('Select the track.').show();
                isValid = false;
            } else {
                $('#trackIdError').hide();
            }

            if (!interviewerId) {
                $('#interviewerIdError').text('Select the first interviewer.').show();
                isValid = false;
            } else {
                $('#interviewerIdError').hide();
            }

            var interviewer1 = $('#InterviewerId').val();
            var interviewer2 = $('#SecondInterviewerId').val();

            if (interviewer1 && interviewer2 && interviewer1 === interviewer2) {
                validateInterviewerSelection('');
                isValid = false;
            } else {
                $('#secondInterviewerIdError').hide();
                $('#interviewerIdDuplicateError').hide();
            }

            if (!date) {
                $('#dateValidationMessage').text('Choose the interview date and time.').show();
                isValid = false;
            } else {
                $('#dateValidationMessage').hide();
            }

            if (!isValid) {
                var firstError = $('.tps-field-error:visible').first();
                if (firstError.length) firstError[0].closest('.tps-field').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            Swal.fire({
                title: 'Save changes to this interview?',
                text: 'The interview will be updated with the details you entered.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Save changes',
                cancelButtonText: 'Back',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#editForm')[0].submit();
                }
            });
        });
    });
</script>
