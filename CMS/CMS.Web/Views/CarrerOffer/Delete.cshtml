@model CMS.Application.DTOs.CarrerOfferDTO

@{
    ViewData["Title"] = "Delete Career Offer";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-megaphone-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete career offer</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.PositionName</h2>
            <div class="tps-ihead__meta">
                <span class="tps-chip"><i class="ri-time-line"></i>@Model.YearsOfExperience years of experience</span>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>The career offer is removed permanently.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Position</dt>
                    <dd>@Model.PositionName</dd>
                </div>
                <div>
                    <dt>Years of experience</dt>
                    <dd>@Model.YearsOfExperience</dd>
                </div>
                <div>
                    <dt>Description</dt>
                    <dd><div class="fw-normal" dir="auto">@Html.DisplayFor(model => model.LongDescription)</div></dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this career offer?"><i class="ri-delete-bin-6-line me-1"></i> Delete career offer</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
