@model CMS.Application.DTOs.CandidateDTO

@{
    ViewData["Title"] = "Delete Candidate";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-user-unfollow-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete candidate</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.FullName</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.PositionName))
                {
                    <span class="tps-chip"><i class="ri-briefcase-4-line"></i>@Model.PositionName</span>
                }
                @if (!string.IsNullOrEmpty(Model.TrackName))
                {
                    <span class="tps-chip"><i class="ri-git-branch-line"></i>@Model.TrackName</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>All associated child entities, such as interviews and attachments, will also be deleted.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Full name</dt>
                    <dd>@Model.FullName</dd>
                </div>
                <div>
                    <dt>Phone</dt>
                    <dd><span dir="ltr">@Model.Phone</span></dd>
                </div>
                <div>
                    <dt>CV provider</dt>
                    <dd>@Model.CompanyName</dd>
                </div>
                <div>
                    <dt>Level</dt>
                    <dd>@Model.PositionName</dd>
                </div>
                <div>
                    <dt>Track</dt>
                    <dd>@Model.TrackName</dd>
                </div>
                <div>
                    <dt>Experience</dt>
                    <dd>@Model.Experience</dd>
                </div>
                <div>
                    <dt>CV</dt>
                    <dd>@if (Model.CVAttachmentId != null)
                        {
                            <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CVAttachmentId"><i class="ri-file-download-line me-1"></i>Download CV</a>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No CV uploaded</span>
                        }</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@Model.Id">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this candidate?" data-confirm-text="The candidate and their interviews and files are deleted. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete candidate</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
