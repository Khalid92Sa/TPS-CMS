@model CMS.Application.DTOs.CandidateDTO

@{
    ViewData["Title"] = "Confirm Delete";
}

<!-- Page Container -->
<div class="container my-5">
    <div class="card shadow border-0 rounded-lg">
        <div class="card-header text-dark text-center py-4 border-bottom" style="background: linear-gradient(135deg, #486fc7, #319ca7);">
            <h4 class="mb-0" style="color:white;">Confirm Deletion</h4>
        </div>

        <div class="card-body px-4 py-5">
            <div class="alert alert-light text-center shadow-sm border border-warning rounded-lg">
                <h5 class="mb-3 text-danger">Are you sure you want to delete this candidate?</h5>
                <p class="text-muted">This action cannot be undone. All associated child entities will also be deleted.</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8" style="margin-left:20%;">
                    <!-- Full Name -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Full Name:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>
                    </dl>

                    <!-- Phone Number -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Phone Number:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>
                    </dl>

                    <!-- CV Provider Name -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">CV Provider Name:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CompanyName)</dd>
                    </dl>

                    <!-- Level -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Level:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PositionName)</dd>
                    </dl>

                    <!-- Track -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Track:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TrackName)</dd>
                    </dl>

                    <!-- Experience -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Experience:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Experience)</dd>
                    </dl>

                    <!-- CV Attachment -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">CV Attachment:</dt>
                        <dd class="col-sm-8">
                            @if (Model.CVAttachmentId != null)
                            {
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CVAttachmentId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Download CV">
                                    <i style="font-size: x-large;" class="bx bxs-cloud-download"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">There is no CV for this candidate.</span>
                            }
                        </dd>
                    </dl>

                </div>

                 <!-- Action Buttons -->
                    <div class="text-center mt-4">
                        <form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@Model.Id">
                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-danger px-4" onclick="showSwalConfirm()">Delete</button>
                                <a class="btn btn-secondary" asp-action="Index">Back to list</a>
                            </div>
                        </form>
                    </div>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showSwalConfirm() {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This action will permanently delete the candidate and its data!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e3342f',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('deleteForm').submit();
            }
        });
    }
</script>

<!-- Font Awesome for Icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
