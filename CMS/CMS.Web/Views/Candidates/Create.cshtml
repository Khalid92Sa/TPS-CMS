@model CMS.Application.DTOs.CandidateCreateDTO

@{
    ViewData["Title"] = "Create Candidate";
}

<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 style="color:white !important">Create Candidate</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data" class="needs-validation" id="candidateForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Full Name -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label">
                            <span class="text-danger">*</span> Full Name
                        </label>
                        <input asp-for="FullName" class="form-control" id="FullName" autocomplete="off" />
                        <div class="invalid-feedback">Full Name is required.</div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" id="Phone" autocomplete="off" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>

                <!-- CV Provider -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyId" class="form-label">
                            <span class="text-danger">*</span> CV Provider
                        </label>
                        <select asp-for="CompanyId" id="CompanyId" asp-items="@(ViewBag.CompaniesDTOs)" class="form-control">
                            <option value="">-- Select the provider --</option>
                        </select>
                        <div class="invalid-feedback">Please select a CV provider.</div>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Level -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PositionId" class="form-label">
                            <span class="text-danger">*</span> Level
                        </label>
                        <select asp-for="PositionId" id="PositionId" asp-items="@(ViewBag.positions)" class="form-control">
                            <option value="">-- Select a Level --</option>
                        </select>
                        <div class="invalid-feedback">Please select a level.</div>
                        <span asp-validation-for="PositionId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Track -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TrackId" class="form-label">
                            <span class="text-danger">*</span> Track
                        </label>
                        <select asp-for="TrackId" id="TrackId" asp-items="@(ViewBag.Tracks)" class="form-control">
                            <option value="">-- Select a track --</option>
                        </select>
                        <div class="invalid-feedback">Please select a track.</div>
                        <span asp-validation-for="TrackId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Experience -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Experience" class="form-label">
                            <span class="text-danger">*</span> Experience
                        </label>
                        <input asp-for="Experience" class="form-control" id="Experience" autocomplete="off" />
                        <div class="invalid-feedback">Experience is required.</div>
                        <span asp-validation-for="Experience" class="text-danger"></span>
                    </div>
                </div>

                <!-- Upload CV -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="file" class="form-label">Upload CV:</label>
                        <input type="file" id="file" name="file" class="form-control-file" onchange="validateFileFormat(this)" />
                        <span id="fileError" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4" id="submitButton">Create</button>
                    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<script>
    $(document).ready(function () {
        // Restrict invalid characters in Phone and Experience fields
        $('#Phone').on('input', function () {
            this.value = this.value.replace(/[^0-9+]/g, '');
        });
        $('#Experience').on('input', function () {
            this.value = this.value.replace(/[^0-9.]/g, '');
        });

        // Form validation on submit
        $('#candidateForm').on('submit', function (e) {
            var isValid = true;
            var fileInput = $('#file')[0];

            // Validate Full Name
            if (!$('#FullName').val().trim()) {
                $('#FullName').addClass('is-invalid');
                isValid = false;
            } else {
                $('#FullName').removeClass('is-invalid');
            }

            // Validate CV Provider
            if (!$('#CompanyId').val()) {
                $('#CompanyId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#CompanyId').removeClass('is-invalid');
            }

            // Validate Level (Position)
            if (!$('#PositionId').val()) {
                $('#PositionId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#PositionId').removeClass('is-invalid');
            }

            // Validate Track
            if (!$('#TrackId').val()) {
                $('#TrackId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#TrackId').removeClass('is-invalid');
            }

            // Validate Experience
            if (!$('#Experience').val().trim()) {
                $('#Experience').addClass('is-invalid');
                isValid = false;
            } else {
                $('#Experience').removeClass('is-invalid');
            }

            // Validate file if selected
            if (fileInput.files.length > 0) {
                var allowedExtensions = [".pdf", ".docx", ".png", ".jpg"];
                var fileName = fileInput.files[0].name;
                var fileSize = fileInput.files[0].size;
                var fileExtension = '.' + fileName.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes(fileExtension)) {
                    $('#fileError').text('Invalid file format. Allowed formats: PDF, DOCX, PNG, JPG.');
                    isValid = false;
                } else if (fileSize > 9 * 1024 * 1024) {
                    $('#fileError').text('File size exceeds 9 MB.');
                    isValid = false;
                } else {
                    $('#fileError').text('');
                }
            }

            // If any validation failed, prevent form submission
            if (!isValid) {
                e.preventDefault();
            }
        });
    });

    function validateFileFormat(input) {
        const allowedExtensions = [".pdf", ".docx", ".png", ".jpg"];
        const file = input.files[0];

        if (file) {
            const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
            if (!allowedExtensions.includes(fileExtension)) {
                $('#fileError').text('Invalid file format. Allowed formats: PDF, DOCX, PNG, JPG.');
                input.value = '';
            } else if (file.size > 9 * 1024 * 1024) {
                $('#fileError').text('File size exceeds 9 MB.');
                input.value = '';
            } else {
                $('#fileError').text('');
            }
        }
    }
</script>

