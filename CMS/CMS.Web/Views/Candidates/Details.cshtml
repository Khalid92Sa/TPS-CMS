@model CMS.Application.DTOs.CandidateDTO

<style>
    .text-muted-custom {
        color: #6c757d;
        font-style: italic;
    }

    .details-card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header-custom {
        background-color: #405189;
        color: white;
        padding: 20px;
        border-bottom: 3px solid #ffffff;
    }

    .card-body-custom {
        padding: 20px;
    }

    dt {
        font-weight: bold;
        color: #333;
    }

    dd {
        margin-bottom: 1rem;
    }

    .btn-link {
        color: #007bff;
    }

        .btn-link:hover {
            color: #0056b3;
            text-decoration: underline;
        }

    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="card details-card">
    <div class="card-header card-header-custom">
        <h2 style="color:white;">Candidate Details</h2>
    </div>

    <div class="card-body card-body-custom">
        <dl class="row">
            <dt class="col-sm-2">Full Name:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>

            <dt class="col-sm-2">Phone:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Phone)</dd>

            <dt class="col-sm-2">CV Provider Name:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.CompanyName)</dd>

            <dt class="col-sm-2">Level:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.PositionName)</dd>

            <dt class="col-sm-2">Track:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.TrackName)</dd>

            <dt class="col-sm-2">Experience:</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Experience)</dd>

            @if (Model.CVAttachmentId != null)
            {
                <dt class="col-sm-2">CV Attachment:</dt>
                <dd class="col-sm-10">
                    <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CVAttachmentId" class="btn btn-link" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Download CV">
                        <i class="bx bxs-cloud-download" style="font-size: x-large;"></i>
                    </a>
                </dd>
            }
            else
            {
                <dt class="col-sm-2">CV Attachment:</dt>
                <dd class="col-sm-10 text-muted-custom">There is no CV for this candidate</dd>
            }
        </dl>
    </div>
</div>

<div class="form-group text-center mt-3">
    <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model.Id" >Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
