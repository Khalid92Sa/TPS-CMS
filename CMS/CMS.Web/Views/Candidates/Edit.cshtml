@model CMS.Application.DTOs.CandidateDTO

@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-user-settings-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Editing candidate</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.FullName</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.PositionName))
                {
                    <span class="tps-chip"><i class="ri-briefcase-4-line"></i>@Model.PositionName</span>
                }
                @if (!string.IsNullOrEmpty(Model.TrackName))
                {
                    <span class="tps-chip"><i class="ri-git-branch-line"></i>@Model.TrackName</span>
                }
                <span class="tps-chip"><i class="ri-file-user-line"></i>@(Model.CVAttachmentId != null ? "CV on file" : "No CV yet")</span>
            </div>
        </div>
    </div>
    <div class="tps-ihead__actions">
        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id"><i class="ri-file-list-3-line me-1"></i> View details</a>
    </div>
</div>

<div class="row">
    @* ---------- Details form ---------- *@
    <div class="col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" class="needs-validation" novalidate id="candidateEditForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <section class="card tps-fsection" aria-labelledby="sec-person">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-user-star-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-person">Candidate</h4>
                        <p class="tps-fsection__desc">Who the candidate is and how to reach them.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="FullName" class="form-label">Full name <span class="tps-req">*</span></label>
                            <input asp-for="FullName" class="form-control" dir="auto" autocomplete="off" />
                            <div class="invalid-feedback">Enter the candidate's full name.</div>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" dir="ltr" inputmode="tel" autocomplete="off" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card tps-fsection" aria-labelledby="sec-role">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-briefcase-4-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-role">Role &amp; source</h4>
                        <p class="tps-fsection__desc">The level and track they're applying for, and who provided the CV.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="PositionId" class="form-label">Level <span class="tps-req">*</span></label>
                            @if (ViewBag.positions != null)
                            {
                                <select asp-for="PositionId" asp-items="@(ViewBag.positions)" class="form-select" data-searchable>
                                    <option value="">Select a level…</option>
                                </select>
                            }
                            <div class="invalid-feedback">Select the level.</div>
                            <span asp-validation-for="PositionId" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="TrackId" class="form-label">Track <span class="tps-req">*</span></label>
                            @if (ViewBag.Tracks != null)
                            {
                                <select asp-for="TrackId" asp-items="@(ViewBag.Tracks)" class="form-select" data-searchable>
                                    <option value="">Select a track…</option>
                                </select>
                            }
                            <div class="invalid-feedback">Select the track.</div>
                            <span asp-validation-for="TrackId" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="Experience" class="form-label">Experience <span class="tps-req">*</span></label>
                            <div class="tps-input-unit">
                                <span class="tps-input-unit__suffix">years</span>
                                <input asp-for="Experience" class="form-control" inputmode="decimal" autocomplete="off" />
                                <div class="invalid-feedback">Enter the years of experience.</div>
                            </div>
                            <span asp-validation-for="Experience" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="CompanyId" class="form-label">CV provider <span class="tps-req">*</span></label>
                            @if (ViewBag.CompaniesDTOs != null)
                            {
                                <select asp-for="CompanyId" class="form-select" data-searchable>
                                    <option value="">Select the provider…</option>
                                    @foreach (var c in ViewBag.CompaniesDTOs)
                                    {
                                        <option value="@c.Value" selected="@(c.Value == Model.CompanyId.ToString())">@c.Text</option>
                                    }
                                </select>
                            }
                            <div class="invalid-feedback">Select who provided the CV.</div>
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save changes</button>
                </div>
            </section>
        </form>
    </div>

    @* ---------- CV form ---------- *@
    <div class="col-xl-4">
        <form asp-action="UpdateAttachment" asp-route-id="@Model.Id" enctype="multipart/form-data" id="uploadForm" class="card tps-fsection tps-aside" aria-labelledby="sec-cv">
            <div class="card-header">
                <span class="tps-fsection__icon"><i class="ri-file-user-line"></i></span>
                <div>
                    <h4 class="tps-fsection__title" id="sec-cv">CV</h4>
                    <p class="tps-fsection__desc">Upload a new file to replace the current CV.</p>
                </div>
            </div>
            <div class="card-body">
                @if (Model.CVAttachmentId != null)
                {
                    <div class="tps-callout tps-callout--success">
                        <i class="ri-checkbox-circle-line"></i>
                        <div>
                            <div class="tps-callout__title">CV on file</div>
                            <a class="btn btn-outline-primary btn-sm mt-2" asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CVAttachmentId">
                                <i class="ri-file-download-line me-1"></i> Download current CV
                            </a>
                        </div>
                    </div>
                }

                <div class="tps-upload" id="fileUploadArea">
                    <input type="file" id="file" name="file" class="file-input-hidden" accept=".pdf,.docx,.png,.jpg" aria-describedby="fileHint" required />
                    <span class="tps-upload__icon"><i class="ri-upload-cloud-2-line"></i></span>
                    <div class="tps-upload__text"><strong>Choose a file</strong> or drag it here</div>
                    <div class="tps-upload__hint" id="fileHint">PDF, DOCX, PNG or JPG · up to 9 MB</div>
                </div>
                <div id="filePreviewContainer" style="display: none;">
                    <div class="tps-file" id="filePreviewItem">
                        <span class="tps-file__icon"><i class="ri-file-3-line"></i></span>
                        <div>
                            <div class="tps-file__name" id="fileName"></div>
                            <div class="tps-file__meta" id="fileSize"></div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm tps-file__remove" id="removeFileBtn" title="Remove file">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>
                <span id="fileError" class="text-danger d-block mt-2"></span>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-primary" id="uploadButton" disabled><i class="ri-upload-2-line me-1"></i> Upload CV</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Only digits/+ in Phone and digits/. in Experience
        $('#Phone').on('input', function () { this.value = this.value.replace(/[^0-9+]/g, ''); });
        $('#Experience').on('input', function () { this.value = this.value.replace(/[^0-9.]/g, ''); });

        // ---------- CV upload (required in this form) ----------
        const fileInput = $('#file');
        const fileUploadArea = $('#fileUploadArea');
        const filePreviewContainer = $('#filePreviewContainer');
        const fileName = $('#fileName');
        const fileSize = $('#fileSize');
        const removeFileBtn = $('#removeFileBtn');
        const fileError = $('#fileError');
        const uploadButton = $('#uploadButton');
        const allowedExtensions = [".pdf", ".docx", ".png", ".jpg"];
        const fileSizeLimit = 9 * 1024 * 1024; // 9MB

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function validateFile(file) {
            var message = '';
            if (!file) message = 'Choose a file to upload.';
            else if (!allowedExtensions.includes('.' + file.name.split('.').pop().toLowerCase())) message = 'This file type isn\'t supported. Use PDF, DOCX, PNG or JPG.';
            else if (file.size > fileSizeLimit) message = 'This file is larger than 9 MB. Choose a smaller file.';
            fileError.text(message);
            uploadButton.prop('disabled', !!message);
            return !message;
        }

        function showFilePreview(file) {
            if (validateFile(file)) {
                fileName.text(file.name);
                fileSize.text(formatFileSize(file.size));
                filePreviewContainer.show();
                fileUploadArea.removeClass('has-error').addClass('has-file');
            } else {
                fileUploadArea.removeClass('has-file').addClass('has-error');
            }
        }

        function hideFilePreview() {
            filePreviewContainer.hide();
            fileInput.val('');
            fileUploadArea.removeClass('has-file has-error');
            fileError.text('');
            uploadButton.prop('disabled', true);
        }

        fileInput.on('change', function (e) {
            const file = e.target.files[0];
            if (file) showFilePreview(file); else hideFilePreview();
        });
        removeFileBtn.on('click', function (e) { e.stopPropagation(); hideFilePreview(); });
        fileUploadArea.on('dragover', function (e) { e.preventDefault(); e.stopPropagation(); $(this).addClass('dragover'); });
        fileUploadArea.on('dragleave', function (e) { e.preventDefault(); e.stopPropagation(); $(this).removeClass('dragover'); });
        fileUploadArea.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(files[0]);
                fileInput[0].files = dataTransfer.files;
                showFilePreview(files[0]);
            }
        });

        $('#uploadForm').on('submit', function (e) {
            if (!validateFile(fileInput[0].files[0])) {
                e.preventDefault();
                fileUploadArea.addClass('has-error');
                return false;
            }
            fileUploadArea.removeClass('has-error');
        });

        // ---------- Details validation ----------
        function mark(selector, invalid) {
            var el = $(selector)[0];
            if (!el) return;
            el.classList.toggle('is-invalid', invalid);
            if (el.tomselect) el.tomselect.wrapper.classList.toggle('is-invalid', invalid);
        }

        $('#candidateEditForm').submit(function (e) {
            var isValid = true;
            [['#FullName', !$('#FullName').val().trim()],
             ['#CompanyId', !$('#CompanyId').val()],
             ['#PositionId', !$('#PositionId').val()],
             ['#TrackId', !$('#TrackId').val()],
             ['#Experience', !$('#Experience').val().trim()]].forEach(function (check) {
                mark(check[0], check[1]);
                if (check[1]) isValid = false;
            });
            if (!isValid) {
                e.preventDefault();
                var first = this.querySelector('.is-invalid');
                if (first) (first.tomselect ? first.tomselect.wrapper : first).scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        $('#FullName, #Experience').on('input', function () { if (this.value.trim()) mark('#' + this.id, false); });
        $('#CompanyId, #PositionId, #TrackId').on('change', function () { if (this.value) mark('#' + this.id, false); });
    });
</script>
