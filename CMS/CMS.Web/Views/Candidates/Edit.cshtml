@model CMS.Application.DTOs.CandidateDTO

@{
    ViewData["Title"] = "Edit Candidate";
}

<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 style="color:white !important;">Edit Candidate</h2>
        </div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label">
                            <span class="text-danger">*</span> Full Name
                        </label>
                        <input asp-for="FullName" class="form-control" />
                        <div class="invalid-feedback">Full Name is required.</div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <!-- CV Provider -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyId" class="form-label">
                            <span class="text-danger">*</span> CV Provider Name
                        </label>
                        @if (ViewBag.CompaniesDTOs != null)
                        {
                            <select asp-for="CompanyId" class="form-control">
                                <option value="">-- Select the provider --</option>
                                @foreach (var c in ViewBag.CompaniesDTOs)
                                {
                                    <option value="@c.Value" selected="@(c.Value == Model.CompanyId.ToString())">@c.Text</option>
                                }
                            </select>
                        }
                        <div class="invalid-feedback">Please select a CV provider.</div>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>

                    <!-- Position -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="PositionId" class="form-label">
                            <span class="text-danger">*</span> Level
                        </label>
                        @if (ViewBag.positions != null)
                        {
                            <select asp-for="PositionId" asp-items="@(ViewBag.positions)" class="form-control">
                                <option value="">-- Select a position --</option>
                            </select>
                        }
                        <div class="invalid-feedback">Please select a level.</div>
                        <span asp-validation-for="PositionId" class="text-danger"></span>
                    </div>

                    <!-- Track -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="TrackId" class="form-label">
                            <span class="text-danger">*</span> Track
                        </label>
                        @if (ViewBag.Tracks != null)
                        {
                            <select asp-for="TrackId" asp-items="@(ViewBag.Tracks)" class="form-control">
                                <option value="">-- Select a track --</option>
                            </select>
                        }
                        <div class="invalid-feedback">Please select a track.</div>
                        <span asp-validation-for="TrackId" class="text-danger"></span>
                    </div>

                    <!-- Experience -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Experience" class="form-label">
                            <span class="text-danger">*</span> Experience
                        </label>
                        <input asp-for="Experience" class="form-control" />
                        <div class="invalid-feedback">Experience is required.</div>
                        <span asp-validation-for="Experience" class="text-danger"></span>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4">Submit</button>
                </div>
            </form>

            <!-- Upload CV Form (if needed) -->
            <form asp-action="UpdateAttachment" asp-route-id="@Model.Id" enctype="multipart/form-data" class="mt-5">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="file" class="form-label">Upload CV</label>
                        <input type="file" id="file" name="file" class="form-control-file" onchange="validateFileFormat()" required />
                        <span id="fileError" class="text-danger"></span>
                    </div>
                </div>

                <!-- Upload Button -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-primary" id="uploadButton" disabled>Upload</button>
                    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<script>
    $(document).ready(function () {
        // Prevent letters in the Phone and Experience fields
        $('#Phone').on('input', function () {
            this.value = this.value.replace(/[^0-9+]/g, '');
        });
        $('#Experience').on('input', function () {
            this.value = this.value.replace(/[^0-9.]/g, '');
        });

        $('form').submit(function (e) {
            var isValid = true;
            var fileInput = $('#file')[0];

            // Validate Full Name
            if (!$('#FullName').val().trim()) {
                $('#FullName').addClass('is-invalid');
                isValid = false;
            } else {
                $('#FullName').removeClass('is-invalid').addClass('is-valid');
            }

            // Validate CV Provider
            if (!$('#CompanyId').val()) {
                $('#CompanyId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#CompanyId').removeClass('is-invalid').addClass('is-valid');
            }

            // Validate Position
            if (!$('#PositionId').val()) {
                $('#PositionId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#PositionId').removeClass('is-invalid').addClass('is-valid');
            }

            // Validate Track
            if (!$('#TrackId').val()) {
                $('#TrackId').addClass('is-invalid');
                isValid = false;
            } else {
                $('#TrackId').removeClass('is-invalid').addClass('is-valid');
            }

            // Validate Experience
            if (!$('#Experience').val().trim()) {
                $('#Experience').addClass('is-invalid');
                isValid = false;
            } else {
                $('#Experience').removeClass('is-invalid').addClass('is-valid');
            }

            if (!isValid) {
                e.preventDefault();
            }
        });
    });

    function validateFileFormat(input) {
        const allowedExtensions = [".pdf", ".docx", ".png", ".jpg"];
        const file = input.files[0];

        if (file) {
            const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
            if (!allowedExtensions.includes(fileExtension) || file.size > 9 * 1024 * 1024) {
                $('#fileError').text('Invalid file format or size exceeds 9MB.');
                input.value = '';
            } else {
                $('#fileError').text('');
            }
        }
    }
</script>
