@model CMS.Application.DTOs.DelegationDurationDTO

@{
    ViewData["Title"] = "Add Delegation Duration";
    ViewData["UnitPlaceholder"] = true;
    ViewData["ConfirmVerb"] = "add";
}

<form id="durationForm" asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-timer-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Delegation durations</p>
                <h2 class="tps-ihead__name">New access period</h2>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            @await Html.PartialAsync("_DurationFields", Model)
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-add-line me-1"></i> Add period</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DurationScript")
