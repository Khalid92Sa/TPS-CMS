@model CMS.Application.DTOs.DelegationDurationDTO

@{
    ViewData["Title"] = "Edit Delegation Duration";
    ViewData["UnitPlaceholder"] = false;
    ViewData["ConfirmVerb"] = "";
}

<form id="durationForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-timer-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Editing access period</p>
                <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
                <div class="tps-ihead__meta">
                    <span class="tps-status @(Model.IsActive ? "tps-status--approved" : "tps-status--neutral")">@(Model.IsActive ? "Enabled" : "Disabled")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="tps-callout">
                <i class="ri-information-line"></i>
                <div>
                    <div class="tps-callout__title">Existing delegations keep their period</div>
                    <p class="tps-callout__text mb-0">Each delegation stores its period when it's created, so changes here apply to new delegations only.</p>
                </div>
            </div>
            @await Html.PartialAsync("_DurationFields", Model)
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save changes</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DurationScript")
