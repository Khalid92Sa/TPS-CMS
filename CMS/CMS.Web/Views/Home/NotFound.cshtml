@{
    ViewData["Title"] = "Page not found";
}

<div class="tps-state">
    <div class="tps-state__icon"><i class="ri-compass-3-line"></i></div>
    <div class="tps-state__code">Error 404</div>
    <h2>We couldn't find that page</h2>
    <p>The link may be out of date, or the record may have been moved or deleted.</p>
    <div class="tps-state__actions">
        <a href="javascript:history.back()" class="btn btn-secondary"><i class="ri-arrow-left-line me-1"></i> Go back</a>
        <a href="/users/login" class="btn btn-primary">Go to my workspace</a>
    </div>
</div>
