<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
@model List<CMS.Application.DTOs.CompanyDTO>
@{
    ViewData["Title"] = "Companies";
}
<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }
</style>

@using (Html.BeginForm("GetCompanies", "Company", FormMethod.Get, new { id = "filterForm" }))
{
    <div class="form-group mb-3">
        <div class="row align-items-end">
            <div class="col-md-3">
                @Html.Label("Filter by Company Name:")
                <input type="text" id="companyName" name="companyName" class="form-control" placeholder="Search by Company Name" value="@ViewBag.companyNameFilter">
            </div>

            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary mt-4 w-50 me-2" title="Filter Companies">
                    Filter
                </button>
                <button type="button" id="resetButton" class="btn btn-secondary mt-4 w-50" title="Reset Filters">
                    Reset
                </button>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <div>
                    <a asp-action="AddCompany" class="btn btn-primary">Add New Company</a>
                </div>
            </div>
            <div class="card-body">

                <table id="add-rows" class="display nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Company Name</th>
                            <th>Country</th>
                            <th>Person Name</th>
                            <th>Email</th>
                            <th>Phone number</th>
                            
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count(); i++)
                        {
                            var company = Model.ElementAt(i);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@company.Name</td>
                                <td>@company.CountryName</td>
                                <td>@company.PersonName</td>
                                <td>@company.Email</td>
                                <td>@company.PhoneNumber</td>
                                
                                <td>
                                    <a class="bx bxs-edit-alt" style="font-size:x-large" asp-action="UpdateCompany" asp-route-id="@company.Id" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-original-title="Edit"></a>|
                                    <a class="bx bx-detail" style="font-size:x-large" asp-action="Details" asp-route-id="@company.Id" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Details"></a> |
                                    <a class="ri-delete-bin-2-line text-danger" style="font-size:x-large" href="@Url.Action("ConfirmDelete", new { id = company.Id })" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Delete"></a>


                                   
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>
    </div><!--end col-->
</div><!--end row-->

<script>
    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this company?")) {
            window.location.href = "@Url.Action("DeleteCompany")/" + id;
        }
    }
</script>
<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        $('#add-rows').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',  // Ensures proper height management
            scrollX: true,     // Enables horizontal scrolling to prevent misalignment
            autoWidth: false,  // Prevents columns from being resized incorrectly
            fixedHeader: true, // Keeps column headers aligned correctly
            columnDefs: [
                { targets: 'hidden', visible: false } // Ensures hidden columns remain hidden
            ]
        });

            $('#resetButton').on('click', function () {
                $('#companyName').val('');
                window.location.href = '@Url.Action("GetCompanies", "Company")';
            });
        });
</script>
