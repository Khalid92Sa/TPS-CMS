@model CMS.Application.DTOs.CompanyDTO

@{
    ViewData["Title"] = "Company Details";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-building-2-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Company</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.CountryName))
                {
                    <span class="tps-chip"><i class="ri-earth-line"></i>@Model.CountryName</span>
                }
            </div>
        </div>
    </div>
    <div class="tps-ihead__actions">
        <a class="btn btn-secondary" asp-action="GetCompanies"><i class="ri-arrow-left-line me-1"></i> Back to list</a>
        <a class="btn btn-primary" asp-action="UpdateCompany" asp-route-id="@Model.Id"><i class="ri-edit-line me-1"></i> Edit</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Company</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                    <div>
                        <dt>Company name</dt>
                        <dd dir="auto">@Model.Name</dd>
                    </div>
                    <div>
                        <dt>Country</dt>
                        @if (!string.IsNullOrEmpty(Model.CountryName))
                        {
                            <dd><a asp-controller="Country" asp-action="ShowCompanies" asp-route-id="@Model.CountryId">@Model.CountryName</a></dd>
                        }
                        else
                        {
                            <dd class="is-empty">Not set</dd>
                        }
                    </div>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Contact person</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                    <div>
                        <dt>Name</dt>
                        @if (!string.IsNullOrEmpty(Model.PersonName))
                        {
                            <dd dir="auto">@Model.PersonName</dd>
                        }
                        else
                        {
                            <dd class="is-empty">No contact person</dd>
                        }
                    </div>
                    <div>
                        <dt>Email</dt>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <dd><span class="user-select-all">@Model.Email</span></dd>
                        }
                        else
                        {
                            <dd class="is-empty">No email</dd>
                        }
                    </div>
                    <div>
                        <dt>Phone</dt>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <dd><span dir="ltr" class="user-select-all">@Model.PhoneNumber</span></dd>
                        }
                        else
                        {
                            <dd class="is-empty">No phone number</dd>
                        }
                    </div>
                </dl>
            </div>
        </div>
    </div>
</div>
