@model CMS.Application.DTOs.CompanyDTO

@{
    ViewData["Title"] = "Delete Company";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-building-2-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete company</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.CountryName))
                {
                    <span class="tps-chip"><i class="ri-earth-line"></i>@Model.CountryName</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>All associated child entities will also be deleted.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Company name</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div>
                    <dt>Country</dt>
                    <dd>@Model.CountryName</dd>
                </div>
                <div>
                    <dt>Contact person</dt>
                    <dd>@if (!string.IsNullOrEmpty(Model.PersonName))
                        {
                            @Model.PersonName
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No contact person</span>
                        }</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <span dir="ltr">@Model.Email</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No email</span>
                        }</dd>
                </div>
                <div>
                    <dt>Phone</dt>
                    <dd>@if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span dir="ltr">@Model.PhoneNumber</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No phone number</span>
                        }</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="DeleteCompany" asp-route-id="@Model.Id">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetCompanies">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this company?" data-confirm-text="The company and its related data are deleted. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete company</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
