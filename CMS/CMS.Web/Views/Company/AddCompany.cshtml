@model CMS.Application.DTOs.CompanyDTO

@{
    ViewData["Title"] = "Add a Company";
}

<form asp-action="AddCompany" class="needs-validation" novalidate id="addCompanyForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-building-2-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Companies</p>
                <h2 class="tps-ihead__name">New company</h2>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <section class="card tps-fsection" aria-labelledby="sec-company">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-building-2-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-company">Company</h4>
                        <p class="tps-fsection__desc">The company name and the country it operates in.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid" style="grid-template-columns: 1fr;">
                        <div class="tps-field">
                            <label asp-for="Name" class="form-label">Company name <span class="tps-req">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Full company name" dir="auto" autocomplete="off" required>
                            <div class="invalid-feedback">Enter the company name.</div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="CountryId" class="form-label">Country <span class="tps-req">*</span></label>
                            <select asp-for="CountryId" asp-items="@(ViewBag.CountriesDTOs)" class="form-select" data-searchable required>
                                <option value="">Select a country…</option>
                            </select>
                            <div class="tps-field-error" id="CountryInvalid" style="display:none;">Select the country.</div>
                            <span asp-validation-for="CountryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card tps-fsection" aria-labelledby="sec-contact">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-contacts-book-2-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-contact">Contact person <span class="text-muted fw-normal fs-13">(optional)</span></h4>
                        <p class="tps-fsection__desc">Who HR can reach at this company.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid" style="grid-template-columns: 1fr;">
                        <div class="tps-field">
                            <label asp-for="PersonName" class="form-label">Name</label>
                            <input asp-for="PersonName" class="form-control" placeholder="Contact person's name" dir="auto" autocomplete="off">
                            <span asp-validation-for="PersonName" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@company.com" dir="ltr" autocomplete="off">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="PhoneNumber" class="form-label">Phone</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" dir="ltr" inputmode="tel" autocomplete="off">
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetCompanies">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-add-line me-1"></i> Add company</button>
        </div>
    </div>
</form>

<script>
    $(function () {
        function setCountryInvalid(invalid) {
            var select = document.getElementById('CountryId');
            select.classList.toggle('is-invalid', invalid);
            if (select.tomselect) select.tomselect.wrapper.classList.toggle('is-invalid', invalid);
            $('#CountryInvalid').toggle(invalid);
        }

        $('#addCompanyForm').submit(function (e) {
            var isValid = true;
            if (!$('#Name').val().trim()) {
                $('#Name').addClass('is-invalid');
                isValid = false;
            } else {
                $('#Name').removeClass('is-invalid');
            }
            if (!$('#CountryId').val()) {
                setCountryInvalid(true);
                isValid = false;
            } else {
                setCountryInvalid(false);
            }
            if (!isValid) e.preventDefault();
        });

        $('#Name').on('input', function () { if (this.value.trim()) $(this).removeClass('is-invalid'); });
        $('#CountryId').on('change', function () { if (this.value) setCountryInvalid(false); });
    });
</script>
