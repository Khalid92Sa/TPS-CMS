@model IEnumerable<CMS.Application.DTOs.NotificationsDTO>
@* Server-rendered notification rows; same markup as TPSNotices.render() in wwwroot/js/tps-notifications.js.
   ViewData["NoticesRead"] (bool) selects the read or unread style. *@
@{
    bool isRead = ViewData["NoticesRead"] as bool? ?? false;
    var list = Model?.ToList() ?? new List<CMS.Application.DTOs.NotificationsDTO>();
}
@if (list.Count == 0)
{
    <div class="tps-notices-empty">
        <i class="@(isRead ? "ri-inbox-line" : "ri-checkbox-circle-line")"></i>
        @(isRead ? "No read notifications yet." : "You're all caught up. No unread notifications.")
    </div>
}
else
{
    foreach (var n in list)
    {
        <a class="tps-notice @(isRead ? "" : "tps-notice--unread")" href="@Url.Action("Details", "Notifications", new { id = n.NotificationsId })">
            <span class="tps-notice__icon" aria-hidden="true"><i class="@(isRead ? "ri-notification-3-line" : "ri-notification-badge-line")"></i></span>
            <span>
                <span class="tps-notice__title d-block" dir="auto">@Html.Raw(n.Title)</span>
                <time class="tps-notice__time" dir="auto" datetime="@n.SendDate.ToString("o")">@n.SendDate.ToString("dd MMM yyyy, h:mm tt")</time>
            </span>
            <span class="tps-notice__end">
                @if (!isRead)
                {
                    <span class="tps-notice__dot" title="Unread"></span>
                }
                <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
            </span>
        </a>
    }
}
