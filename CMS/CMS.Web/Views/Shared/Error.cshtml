@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="tps-state">
    <div class="tps-state__icon tps-state__icon--danger"><i class="ri-error-warning-line"></i></div>
    <div class="tps-state__code">Error 500</div>
    <h2>Something went wrong on our side</h2>
    <p>Your request couldn't be completed. Try again, and if it keeps happening, send the reference below to the system administrator.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p><strong>Reference:</strong> <code>@Model.RequestId</code></p>
    }
    <div class="tps-state__actions">
        <a href="javascript:history.back()" class="btn btn-secondary"><i class="ri-arrow-left-line me-1"></i> Go back</a>
        <a href="/users/login" class="btn btn-primary">Go to my workspace</a>
    </div>
</div>
