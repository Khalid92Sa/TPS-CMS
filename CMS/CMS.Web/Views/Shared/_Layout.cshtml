@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    // Role shown under the user's name in the topbar
    string roleLabel =
        User.IsInRole("Admin") ? "Administrator" :
        User.IsInRole("HR Manager") ? "HR Manager" :
        User.IsInRole("General Manager") ? "General Manager" :
        User.IsInRole("Solution Architecture") ? "Solution Architect" :
        User.IsInRole("Interviewer") ? "Interviewer" :
        User.IsInRole("Viewer") ? "Viewer" : "Member";

    string homeUrl = (User.IsInRole("HR Manager") || User.IsInRole("Admin") || User.IsInRole("General Manager") || User.IsInRole("Viewer"))
        ? "/dashboard/index"
        : "/interviews/myInterviews";
}
<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">

<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] · TPS Candidate Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="TechProcess Solutions" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/theme/images/favicon.ico">
    <!-- Saved Light/Dark theme: must run before layout.js -->
    <script src="~/js/tps-theme-init.js" asp-append-version="true"></script>
    <!-- Layout config Js -->
    <script src="~/theme/js/layout.js"></script>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Searchable selects -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css" rel="stylesheet">
    <!-- Bootstrap Css -->
    <link href="~/theme/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/theme/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/theme/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- custom Css-->
    <link href="~/theme/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.18.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- TPS design system (must load after the theme) -->
    <link href="~/css/tps-design.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/css/tps-components.css" rel="stylesheet" type="text/css" asp-append-version="true" />

    <!-- jQuery (the single copy for the whole page; views must not load another) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Request loader (top progress bar); replaces jquery-loading-overlay -->
    <script src="~/js/tps-loader.js" asp-append-version="true"></script>

</head>

<body>

    <!-- Begin page -->
    <div id="layout-wrapper">

        <header id="page-topbar">
            <div class="layout-width">
                <div class="navbar-header">
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-sm px-3 fs-16 header-item vertical-menu-btn topnav-hamburger" id="topnav-hamburger-icon" aria-label="Toggle navigation">
                            <span class="hamburger-icon">
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                        </button>
                        <span class="tps-role-chip d-none d-md-inline-flex ms-2">
                            <i class="ri-shield-user-line"></i> @roleLabel workspace
                        </span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="ms-1 header-item d-none d-sm-flex">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" data-toggle="fullscreen" aria-label="Full screen">
                                <i class='bx bx-fullscreen fs-20' data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Full screen"></i>
                            </button>
                        </div>

                        <!-- Theme toggle: one click switches Light <-> Dark -->
                        <div class="ms-1 header-item">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="tps-theme-button"
                                    data-tps-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
                                <i class="ri-moon-clear-line fs-20" data-tps-theme-icon></i>
                            </button>
                        </div>


                        @if (User.IsInRole("General Manager"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                loadNotificationsGM();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownGM">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownGM" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                                    <i class='bx bx-bell fs-20'></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeGM"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownGM">
                                    <div class="dropdown-head rounded-top">
                                        <div class="p-3">
                                            <h6 class="m-0 fs-15 fw-bold">Notifications</h6>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabGM" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabGM" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listGM">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="gm" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkGM">
                                            View all notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("HR Manager"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                loadNotificationsHR();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownHR">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownHR" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                                    <i class='bx bx-bell fs-20'></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeHR"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownHR">
                                    <div class="dropdown-head rounded-top">
                                        <div class="p-3">
                                            <h6 class="m-0 fs-15 fw-bold">Notifications</h6>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabHR" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabHR" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listHR">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="hr" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkHR">
                                            View all notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("Interviewer"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                loadNotificationsInterviewer();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownInterviewer">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownInterviewer" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                                    <i class='bx bx-bell fs-20'></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeInterviewer"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownInterviewer">
                                    <div class="dropdown-head rounded-top">
                                        <div class="p-3">
                                            <h6 class="m-0 fs-15 fw-bold">Notifications</h6>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabInterviewer" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabInterviewer" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listInterviewer">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="interviewer" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkInterviewer">
                                            View all notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("Solution Architecture"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                loadNotificationsArchitecture();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownArchitecture">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownArchitecture" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                                    <i class='bx bx-bell fs-20'></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeArchitecture"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownArchitecture">
                                    <div class="dropdown-head rounded-top">
                                        <div class="p-3">
                                            <h6 class="m-0 fs-15 fw-bold">Notifications</h6>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabArchitecture" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabArchitecture" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listArchitecture">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="archi" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkArchitecture">
                                            View all notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        @* end of the icon *@

                        <div class="dropdown ms-sm-3 header-item topbar-user">
                            <button type="button" class="btn" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="d-flex align-items-center">
                                    @if (User.IsInRole("HR Manager"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/HR.png" alt="">
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/user-dummy-img.jpg" alt="">
                                    }
                                    else if (User.IsInRole("Interviewer"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/interviewers.jpeg" alt="">
                                    }
                                    else if (User.IsInRole("General Manager") || User.IsInRole("Viewer"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/General_Manager.png" alt="">
                                    }
                                    else if (User.IsInRole("Solution Architecture"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/avatar-3.jpg" alt="">
                                    }
                                    else
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/Anonymous.jpg" alt="">
                                    }
                                    <span class="text-start ms-2 d-none d-xl-block">
                                        <span class="d-block user-name-text">@User.Identity.Name</span>
                                        <span class="d-block user-name-sub-text">@roleLabel</span>
                                    </span>
                                    <i class="ri-arrow-down-s-line ms-1 text-muted d-none d-xl-inline"></i>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <!-- item-->
                                <h6 class="dropdown-header">Signed in as<br /><span class="fw-semibold text-body">@User.Identity.Name</span></h6>
                                <div class="dropdown-divider"></div>
                                @if (!User.IsInRole("Admin") && (User.IsInRole("Interviewer") || User.IsInRole("General Manager") || User.IsInRole("Solution Architecture") || User.IsInRole("HR Manager")))
                                {
                                    <a class="dropdown-item" asp-controller="users" asp-action="changePassword">
                                        <i class="ri-lock-password-line text-muted fs-16 align-middle me-2"></i>
                                        <span class="align-middle">Change password</span>
                                    </a>
                                }

                                <a class="dropdown-item" asp-controller="users" asp-action="logout"><i class="ri-logout-box-r-line text-muted fs-16 align-middle me-2"></i> <span class="align-middle">Sign out</span></a>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- removeNotificationModal -->
        <div id="removeNotificationModal" class="modal fade zoomIn" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="NotificationModalbtn-close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mt-2 text-center">
                            <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                            <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                <h4>Remove this notification?</h4>
                                <p class="text-muted mx-4 mb-0">It will be removed from your notification list.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                            <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn w-sm btn-danger" id="delete-notification">Remove</button>
                        </div>
                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div>
        <!-- /.modal -->
        <!-- ========== App Menu ========== -->
        <div class="app-menu navbar-menu">
   <!-- LOGO -->
<div class="navbar-brand-box">
    <a href="@homeUrl" class="tps-brand" aria-label="Candidate Management System home">
        <img style="width: 200px;height: 45px;" src="/theme/images/TechProcessSolutions-logo_White.svg" alt="" height="17">
    </a>
    <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover" aria-label="Pin sidebar">
        <i class="ri-record-circle-line"></i>
    </button>
</div>

            <div id="scrollbar">
                <div class="container-fluid">
                    <div id="two-column-menu">
                    </div>
                    @{
                        var NavLinks = new[] {
                            new { Section = "Overview", Controller = "Dashboard", Action = "Index", Icon = "ri-dashboard-2-line", Label = "Dashboard",
                                  Roles = new[] {"Admin","General Manager","HR Manager","Viewer"} },
                            new { Section = "Overview", Controller = "SearchInterviews", Action = "Index", Icon = "ri-search-eye-line", Label = "Interview Search",
                                  Roles = new[] {"Admin","HR Manager","General Manager","Viewer"} },

                            new { Section = "Recruitment", Controller = "Candidates", Action = "Index", Icon = "ri-user-star-line", Label = "Candidates",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Recruitment", Controller = "Interviews", Action = "Index", Icon = "ri-calendar-check-line", Label = "Interviews",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Recruitment", Controller = "Interviews", Action = "MyInterviews", Icon = "ri-user-voice-line", Label = "My Interviews",
                                  Roles = new[] {"Interviewer","HR Manager", "General Manager","Solution Architecture"} },
                            new { Section = "Recruitment", Controller = "Interviews", Action = "Delegation", Icon = "ri-user-shared-line", Label = "Delegation",
                                  Roles = new[] {"Admin","HR Manager"} },

                            new { Section = "Organization", Controller = "Position", Action = "GetPositions", Icon = "ri-briefcase-4-line", Label = "Positions",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Organization", Controller = "Track", Action = "Index", Icon = "ri-git-branch-line", Label = "Tracks",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Organization", Controller = "Company", Action = "GetCompanies", Icon = "ri-building-2-line", Label = "Companies",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Organization", Controller = "Country", Action = "GetCountries", Icon = "ri-earth-line", Label = "Countries",
                                  Roles = new[] {"Admin","HR Manager"} },

                            new { Section = "Administration", Controller = "Account", Action = "Index", Icon = "ri-shield-user-line", Label = "Users",
                                  Roles = new[] {"Admin","HR Manager"} },
                            new { Section = "Administration", Controller = "DelegationDurations", Action = "Index", Icon = "ri-timer-line", Label = "Delegation Durations",
                                  Roles = new[] {"Admin","HR Manager"} }
                        };

                        var visibleLinks = NavLinks.Where(item => item.Roles.Any(role => User.IsInRole(role))).ToList();

                        // Highlight the exact controller/action match, otherwise the first link for the same controller
                        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                        var activeLink =
                            visibleLinks.FirstOrDefault(l => l.Controller.Equals(currentController, StringComparison.OrdinalIgnoreCase)
                                                          && l.Action.Equals(currentAction, StringComparison.OrdinalIgnoreCase))
                            ?? visibleLinks.FirstOrDefault(l => l.Controller.Equals(currentController, StringComparison.OrdinalIgnoreCase));
                        string previousSection = null;
                    }
                    <ul class="navbar-nav" id="navbar-nav">
                        @foreach (var item in visibleLinks)
                        {
                            if (item.Section != previousSection)
                            {
                                previousSection = item.Section;
                                <li class="menu-title"><span>@item.Section</span></li>
                            }
                            <li class="nav-item">
                                <a class="nav-link menu-link @(item == activeLink ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action"
                                   aria-current="@(item == activeLink ? "page" : null)">
                                    <i class="@item.Icon"></i> <span>@item.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <!-- Sidebar -->
            </div>

            <div class="tps-sidebar-footer">
                <strong>TPS Candidate Management</strong>
                Recruitment &amp; interview workflow
            </div>

            <div class="sidebar-background"></div>
        </div>
        <!-- Left Sidebar End -->
        <!-- Vertical Overlay-->
        <div class="vertical-overlay"></div>

        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content">

            <div class="page-content">
                <div class="container-fluid">

                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box tps-page-head">
                                <div>
                                    <ol class="tps-crumbs">
                                        <li><a href="@homeUrl">Workspace</a></li>
                                        @if (activeLink != null && activeLink.Label != (ViewData["Title"] as string))
                                        {
                                            <li><a asp-controller="@activeLink.Controller" asp-action="@activeLink.Action">@activeLink.Label</a></li>
                                        }
                                        <li aria-current="page">@ViewData["Title"]</li>
                                    </ol>
                                    <h4 class="mb-0">@ViewData["Title"]</h4>
                                </div>
                                <span class="tps-page-date d-none d-md-inline">@DateTime.Now.ToString("dddd, d MMMM yyyy")</span>
                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    @RenderBody()
                </div>
                <!-- container-fluid -->
            </div>
            <!-- End Page-content -->

            <footer class="footer">
                <div class="container-fluid">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span>&copy; <span id="year"></span> TechProcess Solutions</span>
                        <span class="d-none d-sm-inline">Candidate Management System</span>
                    </div>
                </div>
            </footer>
        </div>
        <!-- end main content-->

    </div>
    <!-- END layout-wrapper -->
    <!--preloader-->
    <!-- JAVASCRIPT -->
    <script src="~/theme/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/theme/libs/simplebar/simplebar.min.js"></script>
    <script src="~/theme/libs/node-waves/waves.min.js"></script>
    <script src="~/theme/libs/feather-icons/feather.min.js"></script>
    <script src="~/theme/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/theme/js/plugins.js"></script>
    @{
        string[] scripts = ViewData["additionalJS"] as string[];
        if (scripts != null)
        {
            foreach (var item in scripts)
            {
                <script src="@item"></script>
            }
        }
    }

    <!-- App js -->
    <script src="~/theme/js/app.js" asp-append-version="true"></script>

    <!-- Searchable selects + theme switcher + shared UI -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/tps-ui.js" asp-append-version="true"></script>



    <script>
        // Global flag to track if notifications have been loaded
        let notificationsLoaded = false;

        document.addEventListener("DOMContentLoaded", function () {
            // General Manager notifications
            const notificationButtonGM = document.getElementById("page-header-notifications-dropdownGM");
            if (notificationButtonGM !== undefined && !notificationsLoaded) {
                notificationButtonGM.addEventListener("click", loadNotificationsGM);
                updateBadgeCountGM(0);
                notificationsLoaded = true;
            }

            // HR notifications
            const notificationButtonHR = document.getElementById("page-header-notifications-dropdownHR");
            if (notificationButtonHR !== undefined && !notificationsLoaded) {
                notificationButtonHR.addEventListener("click", loadNotificationsHR);
                updateBadgeCountHR(0);
                notificationsLoaded = true;
            }

            // Interviewer notifications
            const notificationButtonInterviewer = document.getElementById("page-header-notifications-dropdownInterviewer");
            if (notificationButtonInterviewer !== undefined && !notificationsLoaded) {
                notificationButtonInterviewer.addEventListener("click", loadNotificationsInterviewer);
                updateBadgeCountInterviewer(0);
                notificationsLoaded = true;
            }

            // Architecture notifications
            const notificationButtonArchitecture = document.getElementById("page-header-notifications-dropdownArchitecture");
            if (notificationButtonArchitecture !== undefined && !notificationsLoaded) {
                notificationButtonArchitecture.addEventListener("click", loadNotificationsArchitecture);
                updateBadgeCountArchitecture(0);
                notificationsLoaded = true;
            }
        });

        // Function and variables for General Manager notifications
        var GMNotificationURl = '@Url.Action("GM-notifications", "notifications")';
        async function loadNotificationsGM() {
            try {
                const response = await fetch(GMNotificationURl);
                if (!response.ok) {
                    throw new Error(`Request failed with status ${response.status}`);
                }
                const notifications = await response.json();
                const notificationsList = document.getElementById("notifications-listGM");

                if (notifications.length > 0) {
                    notificationsList.innerHTML = "";
                    const lastTwoNotifications = notifications.slice(-2).reverse();
                    lastTwoNotifications.forEach((notification) => {
                        const listItem = document.createElement("div");
                        listItem.classList.add("notification-item");
                        listItem.innerHTML = `
                            <div class="notification-title">${notification.title}</div>
                            <div class="notification-body">${notification.bodyDesc}</div>
                        `;
                        notificationsList.appendChild(listItem);
                    });

                    if (notifications.length > 2) {
                        document.getElementById("see-all-linkGM").style.display = "block";
                    }
                    updateBadgeCountGM(notifications.length);
                } else {
                    notificationsList.innerHTML = "<p class='no-notifications'>No notifications available.</p>";
                    updateBadgeCountGM(0);
                }
            } catch (error) {
                console.error("Error loading notifications:", error);
            }
        }

        function updateBadgeCountGM(count) {
            const badge = document.getElementById("notification-badgeGM");
            badge.textContent = count.toString();
        }

