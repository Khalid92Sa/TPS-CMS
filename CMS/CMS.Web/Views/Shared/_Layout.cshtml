@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">


<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CMS </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Themesbrand" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/theme/images/favicon.ico">
    <!-- Layout config Js -->
    <script src="~/theme/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="~/theme/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/theme/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/theme/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- custom Css-->
    <link href="~/theme/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.18.0/font/bootstrap-icons.css" rel="stylesheet">


    <!-- LoadingOverlay CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.css">

    <!-- jQuery (required for LoadingOverlay) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- LoadingOverlay JS -->
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <style>
        /* Style for notification container */
        #notification-container {
            position: relative;
        }

        /* Style for notification button */
        #notification-dropdown {
            background-color: #007bff;
            color: #fff;
        }


        #notification-dropdownGM {
            background-color: #007bff;
            color: #fff;
        }

        #notification-dropdownHR {
            background-color: #007bff;
            color: #fff;
        }

        #notification-dropdownInterviewer {
            background-color: #007bff;
            color: #fff;
        }

        /* Style for the dropdown content */
        .dropdown-menu {
            max-height: 300px;
            overflow-y: auto;
        }

        /* Style for notification list item */
        .notification-item {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        /* Style for notification title */
        .notification-title {
            font-weight: bold;
            color: #333;
        }

        /* Style for notification body description */
        .notification-body {
            color: #777;
        }

        /* Style for notification date */
        .notification-date {
            color: #999;
        }

        /* Style for no notifications message */
        .no-notifications {
            padding: 10px;
            text-align: center;
            color: #777;
        }

        /* Default label and icon color in the sidebar */
        .app-menu .navbar-nav .nav-link span,
        .app-menu .navbar-nav .nav-link i {
            color: white !important; /* Default white color */
            transition: color 0.3s ease; /* Smooth transition */
        }

        /* Hover state for labels and icons in the sidebar */
        .app-menu .navbar-nav .nav-link:hover span,
        .app-menu .navbar-nav .nav-link:hover i {
            color: lightgray !important; /* Light gray on hover */
        }

        /* Default primary button styling */
        .btn.btn-primary {
            background: linear-gradient(135deg, #486fc7, #319ca7) !important;
            border: none !important; /* Remove border if any */
            color: white !important; /* Ensure the text is white */
            transition: background 0.3s ease; /* Smooth hover transition */
        }

            /* Hover state for primary buttons */
            .btn.btn-primary:hover {
                background: linear-gradient(135deg, #5a9bc5, #3bc6c7) !important; /* Slightly lighter gradient on hover */
                color: white !important;
            }

        /* Default secondary button styling */
        .btn.btn-secondary {
            background-color: gray !important;
            border-color: gray !important;
            color: white !important; /* Ensure the text is white for better contrast */
            transition: background-color 0.3s ease, border-color 0.3s ease; /* Smooth transition */
        }

            /* Hover state for secondary buttons */
            .btn.btn-secondary:hover {
                background-color: darkgray !important;
                border-color: darkgray !important;
                color: white !important;
            }
    </style>

</head>

<body>

    <!-- Begin page -->
    <div id="layout-wrapper">

        <header id="page-topbar">
            <div class="layout-width">
                <div class="navbar-header">
                    <div class="d-flex">
                        <!-- LOGO -->
                        <div class="navbar-brand-box horizontal-logo">
                            <a href="/" class="logo logo-dark">
                                <span class="logo-sm">
                                    <img src="~/theme/images/logo-sm.png" alt="" height="22">
                                </span>
                                <span class="logo-lg">
                                    <img src="~/theme/images/logo-dark.png" alt="" height="17">
                                </span>
                            </a>

                            <a href="/" class="logo logo-light">
                                <span class="logo-lg">
                                    <img style="width: 200px;height: 38px;" src="~/theme/images/logo-light.png" alt="" height="17">

                                </span>
                                <span class="logo-lg">
                                    <img src="~/theme/images/candidate-logo.png" alt="" height="17">
                                </span>
                            </a>
                        </div>

                        <button type="button" class="btn btn-sm px-3 fs-16 header-item vertical-menu-btn topnav-hamburger" id="topnav-hamburger-icon">
                            <span class="hamburger-icon">
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                        </button>

                    </div>

                    <div class="d-flex align-items-center">
                        <div class="ms-1 header-item d-none d-sm-flex">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" data-toggle="fullscreen">
                                <i class='bx bx-fullscreen fs-22' data-bs-toggle="tooltip" data-bs-placement="left" data-bs-original-title="Full Screen"></i>
                            </button>
                        </div>

                        <div class="ms-1 header-item d-none d-sm-flex">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle light-dark-mode">
                                <i class='bx bx-moon fs-22' data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Dark Mode"></i>
                            </button>
                        </div>


                        @if (User.IsInRole("General Manager"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    loadNotificationsGM();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownGM">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownGM" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <i class='bx bx-bell fs-22' data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Notifications"></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeGM"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownGM">
                                    <div class="dropdown-head bg-primary bg-pattern rounded-top">
                                        <div class="p-3">
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <h6 class="m-0 fs-16 fw-semibold text-white">Notifications</h6>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabGM" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabGM" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listGM">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="gm" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkGM">
                                            View All Notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("HR Manager"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    loadNotificationsHR();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownHR">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownHR" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <i class='bx bx-bell fs-22' data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Notifications"></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeHR"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownHR">
                                    <div class="dropdown-head bg-primary bg-pattern rounded-top">
                                        <div class="p-3">
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <h6 class="m-0 fs-16 fw-semibold text-white">Notifications</h6>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabHR" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabHR" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listHR">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="hr" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkHR">
                                            View All Notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("Interviewer"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    loadNotificationsInterviewer();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownInterviewer">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownInterviewer" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <i class='bx bx-bell fs-22' data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Notifications"></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeInterviewer"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownInterviewer">
                                    <div class="dropdown-head bg-primary bg-pattern rounded-top">
                                        <div class="p-3">
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <h6 class="m-0 fs-16 fw-semibold text-white">Notifications</h6>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabInterviewer" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabInterviewer" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listInterviewer">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="interviewer" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkInterviewer">
                                            View All Notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        else if (User.IsInRole("Solution Architecture"))
                        {
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    loadNotificationsArchitecture();
                                });
                            </script>
                            <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdownArchitecture">
                                <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" id="page-header-notifications-dropdownArchitecture" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <i class='bx bx-bell fs-22' data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Notifications"></i>
                                    <span class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger" id="notification-badgeArchitecture"><span class="visually-hidden">unread messages</span></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdownArchitecture">
                                    <div class="dropdown-head bg-primary bg-pattern rounded-top">
                                        <div class="p-3">
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <h6 class="m-0 fs-16 fw-semibold text-white">Notifications</h6>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="px-2 pt-2">
                                            <ul class="nav nav-tabs dropdown-tabs nav-tabs-custom" data-dropdown-tabs="true" id="notificationItemsTabArchitecture" role="tablist">
                                                <li class="nav-item waves-effect waves-light">
                                                    <a class="nav-link active" data-bs-toggle="tab" href="#all-noti-tabArchitecture" role="tab" aria-selected="true">
                                                        All
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div id="notifications-listArchitecture">
                                        <!-- Notifications will be loaded here dynamically -->
                                    </div>

                                    <div class="my-3 text-center view-all">
                                        <a asp-action="archi" asp-controller="notifications" class="btn btn-soft-success waves-effect waves-light" id="see-all-linkArchitecture">
                                            View All Notifications <i class="ri-arrow-right-line align-middle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        }

                        @* end of the icon *@

                        <div class="dropdown ms-sm-3 header-item topbar-user">
                            <button type="button" class="btn" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="d-flex align-items-center">
                                    @if (User.IsInRole("HR Manager"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/HR.png" alt="Header Avatar">
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/user-dummy-img.jpg" alt="Header Avatar">
                                    }
                                    else if (User.IsInRole("Interviewer"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/interviewers.jpeg" alt="Header Avatar">
                                    }
                                    else if (User.IsInRole("General Manager"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/General_Manager.png" alt="Header Avatar">
                                    }
                                    else if (User.IsInRole("Solution Architecture"))
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/avatar-3.jpg" alt="Header Avatar">
                                    }
                                    else
                                    {
                                        <img class="rounded-circle header-profile-user" src="~/theme/images/users/Anonymous.jpg" alt="Header Avatar">
                                    }
                                    <span class="text-start ms-xl-2">
                                        <span class="d-none d-xl-inline-block ms-1 fw-medium user-name-text">@User.Identity.Name</span>
                                        <span class="d-none d-xl-block ms-1 fs-12 user-name-sub-text"></span>
                                    </span>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <!-- item-->
                                <h6 class="dropdown-header">Welcome @User.Identity.Name !</h6>
                                <div class="dropdown-divider"></div>
                                @if (!User.IsInRole("Admin") && (User.IsInRole("Interviewer") || User.IsInRole("General Manager") || User.IsInRole("Solution Architecture") || User.IsInRole("HR Manager")))
                                {
                                    <a class="dropdown-item" asp-controller="users" asp-action="changePassword">
                                        <i class="mdi mdi-lock-reset text-muted fs-16 align-middle me-1"></i>
                                        <span class="align-middle" data-key="t-change-password">Change Password</span>
                                    </a>
                                }

                                <a class="dropdown-item" asp-controller="users" asp-action="logout"><i class="mdi mdi-logout text-muted fs-16 align-middle me-1"></i> <span class="align-middle" data-key="t-logout">Logout</span></a>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- removeNotificationModal -->
        <div id="removeNotificationModal" class="modal fade zoomIn" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="NotificationModalbtn-close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mt-2 text-center">
                            <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                            <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                <h4>Are you sure ?</h4>
                                <p class="text-muted mx-4 mb-0">Are you sure you want to remove this Notification ?</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                            <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn w-sm btn-danger" id="delete-notification">Yes, Delete It!</button>
                        </div>
                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div>
        <!-- /.modal -->
        <!-- ========== App Menu ========== -->
        <div style="background: linear-gradient(135deg, #486fc7, #319ca7);" class="app-menu navbar-menu">
            <!-- LOGO -->
            <div class="navbar-brand-box" style="background: linear-gradient(135deg, #486fc7, #319ca7);">
                <!-- Dark Logo-->
                <a href="/" class="logo logo-dark">
                    <span class="logo-sm">
                        <img src="~/theme/images/logo-sm.png" alt="" height="22">
                    </span>
                    <span class="logo-lg">
                        <img src="~/theme/images/logo-dark.png" alt="" height="17">
                    </span>
                </a>
                <!-- Light Logo-->
                <a href="/dashboard/index" class="logo logo-light" style="margin-left:-15px;">
                    <span class="logo-lg">
                        @*  <img style="width: 200px;height: 45px;" src="~/theme/images/TechProcessSolutions-logo_grey.svg" alt="" height="17"> *@
                        <img style="width: 200px;height: 45px;" src="~/theme/images/TechProcessSolutions-logo_White.svg" alt="" height="17">
                    </span>
                </a>
                <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
                    <i class="ri-record-circle-line"></i>
                </button>
            </div>

            <div id="scrollbar">
                <div class="container-fluid">
                    <div id="two-column-menu">
                    </div>
                    @{
                        var NavLinks = new[] {
                    new
                    {
                    Controller =  "Dashboard",
                    Action = "Index",
                    Icon = "ri-dashboard-fill",
                    Label = "Dashboard",
                    Roles = new[] {"Admin","General Manager","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Interviews",
                    Action = "Index",
                    Icon = "ri-team-fill",
                    Label = "Interviews",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Interviews",
                    Action = "MyInterviews",
                    Icon = "ri-team-fill",
                    Label = "My Interviews",
                    Roles = new[] {"Interviewer","HR Manager", "General Manager","Solution Architecture"}
                    },
                    new
                    {
                    Controller =  "Position",
                    Action = "GetPositions",
                    Icon = "ri-briefcase-fill",
                    Label = "Positions",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Candidates",
                    Action = "Index",
                    Icon = "ri-user-star-fill",
                    Label = "Candidates",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Account",
                    Action = "Index",
                    Icon = "ri-map-pin-user-fill",
                    Label = "Users",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Country",
                    Action = "GetCountries",
                    Icon = "ri-earth-line",
                    Label = "Countries",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "Company",
                    Action = "GetCompanies",
                    Icon = "ri-building-line",
                    Label = "Companies",
                    Roles = new[] {"Admin","HR Manager"}
                    },
                    new
                    {
                    Controller =  "SearchInterviews",
                    Action = "Index",
                    Icon = "bx bx-search-alt-2",
                    Label = "Interviews Filter",
                    Roles = new[] {"Admin","HR Manager","General Manager"}
                    }

                    };
                    }
                    <ul class="navbar-nav" id="navbar-nav">
                        @foreach (var item in NavLinks)
                        {
                            bool canShowItem = false;
                            foreach (var role in item.Roles)
                            {
                                if (User.IsInRole(role))
                                {
                                    canShowItem = true;
                                    break;
                                }
                            }
                            @if (canShowItem)
                            {
                                <li class="nav-item">
                                    <a class="nav-link menu-link" asp-controller="@item.Controller" asp-action="@item.Action">
                                        <i class="@item.Icon"></i> <span data-key="t-dashboards">@item.Label</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <!-- Sidebar -->
            </div>

            <div class="sidebar-background"></div>
        </div>
        <!-- Left Sidebar End -->
        <!-- Vertical Overlay-->
        <div class="vertical-overlay"></div>

        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content">

            <div class="page-content">
                <div class="container-fluid">

                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                                <h4 class="mb-sm-0">@ViewData["Title"]</h4>
                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    @RenderBody()
                </div>
                <!-- container-fluid -->
            </div>
            <!-- End Page-content -->

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <span id="year"></span> © TPS.
                        </div>
                    </div>
                </div>
            </footer>
        </div>
