    <script>
        function updateYear() {
            const yearElement = document.getElementById('year');
            const currentYear = new Date().getFullYear();
            yearElement.textContent = currentYear;
        }

        // Update the year when the page loads and then set up a timer to update it annually.
        updateYear();
        setInterval(updateYear, 1000); // Update every second (adjust as needed)
    </script>

    @* Request loading is handled by ~/js/tps-loader.js (loaded in <head>). *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuToggle = document.getElementById('topnav-hamburger-icon');
            const menuBar = document.querySelector('.navbar-brand-box');

            function adjustDataTables() {
                if (window.jQuery && jQuery.fn.dataTable) jQuery.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            }

            if (menuBar && menuToggle) {
                const duration = parseFloat(window.getComputedStyle(menuBar).transitionDuration) * 1000;
                menuToggle.addEventListener('click', function () {
                    setTimeout(adjustDataTables, duration || 100);
                });
            }
        });
    </script>

