    <script>
        function updateYear() {
            const yearElement = document.getElementById('year');
            const currentYear = new Date().getFullYear();
            yearElement.textContent = currentYear;
        }

        // Update the year when the page loads and then set up a timer to update it annually.
        updateYear();
        setInterval(updateYear, 1000); // Update every second (adjust as needed)
    </script>

    <script>
            window.addEventListener('beforeunload', function () {
            showLoading();

            // Hide the loading overlay automatically after 3 seconds
            setTimeout(hideLoading, 3000);
        });

        window.addEventListener('load', function () {
            hideLoading();
        });

        function showLoading() {
            $.LoadingOverlay("show");
        }

        function hideLoading() {
            $.LoadingOverlay("hide");
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuToggle = document.getElementById('topnav-hamburger-icon');
            const menuBar = document.querySelector('.navbar-brand-box');

            function adjustDataTables() {
                jQuery.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            }

            if (menuBar && menuToggle) {
                const duration = parseFloat(window.getComputedStyle(menuBar).transitionDuration) * 1000;
                menuToggle.addEventListener('click', function () {
                    setTimeout(adjustDataTables, duration || 100);
                });
            }
        });
    </script>

