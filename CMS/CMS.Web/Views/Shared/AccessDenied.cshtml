@{
    ViewData["Title"] = "Access denied";
}

<div class="tps-state">
    <div class="tps-state__icon tps-state__icon--danger"><i class="ri-lock-2-line"></i></div>
    <div class="tps-state__code">Error 403</div>
    <h2>You don't have access to this page</h2>
    @if (TempData["ErrorMessage"] != null)
    {
        <p>@TempData["ErrorMessage"]</p>
    }
    else
    {
        <p>Your role doesn't include permission for this page. If you need it, ask your administrator to update your access.</p>
    }
    <div class="tps-state__actions">
        <a href="javascript:history.back()" class="btn btn-secondary"><i class="ri-arrow-left-line me-1"></i> Go back</a>
        <a href="/users/login" class="btn btn-primary">Go to my workspace</a>
    </div>
</div>
