@model dynamic

<style>
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 10px;
    }

    .pagination {
        list-style-type: none;
        display: flex;
        align-items: center;
        padding: 0;
        margin: 0;
    }

        .pagination .page-item {
            margin: 0 5px;
        }

            .pagination .page-item .page-link {
                padding: 10px 15px;
                border-radius: 50%;
                border: 2px solid #ffffff;
                background: linear-gradient(135deg, #486fc7, #319ca7) !important;
                color: white !important;
                font-weight: bold;
                transition: all 0.3s ease;
                text-align: center;
            }

                .pagination .page-item .page-link:hover {
                    background: linear-gradient(135deg, #319ca7, #486fc7) !important;
                    color: #ffffff !important;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                }

            .pagination .page-item.active .page-link {
                background: linear-gradient(135deg, #319ca7, #486fc7) !important;
                color: white !important;
                border-color: white;
            }

            .pagination .page-item.disabled .page-link {
                color: #ffffff !important;
                background: linear-gradient(135deg, #486fc7, #319ca7) !important;
                border-color: #ffffff;
                opacity: 0.5;
                cursor: not-allowed;
            }

    /* Dropdown Styling */
    .pagination-dropdown, .rows-per-page {
        display: flex;
        align-items: center;
    }

        .pagination-dropdown label, .rows-per-page label {
            font-weight: bold;
            color: #ffffff;
            margin-right: 10px;
        }

        .pagination-dropdown select, .rows-per-page select {
            padding: 8px 15px;
            border-radius: 8px;
            border: 2px solid #ffffff;
            background: linear-gradient(135deg, #486fc7, #319ca7) !important;
            color: white !important;
            font-weight: bold;
            max-height: 150px;
            overflow-y: auto;
            transition: all 0.3s ease;
            margin-right: 15px;
            /* Custom dropdown arrow */
            background-image: url('data:image/svg+xml,%3Csvg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M6 9l6 6 6-6"/%3E%3C/svg%3E');
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
            cursor: pointer;
        }

            .pagination-dropdown select:hover, .rows-per-page select:hover {
                background: linear-gradient(135deg, #319ca7, #486fc7) !important;
                color: white !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }

            .pagination-dropdown select:focus, .rows-per-page select:focus {
                outline: none;
                border-color: #ffffff;
                background: linear-gradient(135deg, #319ca7, #486fc7) !important;
            }

            .pagination-dropdown select:hover, .rows-per-page select:hover {
                background: linear-gradient(135deg, #319ca7, #486fc7) !important;
                color: white !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }

            .pagination-dropdown select:focus, .rows-per-page select:focus {
                outline: none;
                border-color: #ffffff;
                background: linear-gradient(135deg, #319ca7, #486fc7) !important;
            }

    .size {
        background: linear-gradient(135deg, #486fc7, #319ca7) !important;
        color: white !important;
    }

</style>

@{
    var queryParams = new List<string>();

    foreach (var key in Context.Request.Query.Keys)
    {
        if (key != "pageNumber" && key != "pageSize")
        {
            var value = Context.Request.Query[key];
            queryParams.Add($"{key}={value}");
        }
    }

    var queryString = queryParams.Any() ? "&" + string.Join("&", queryParams) : "";
}

    <div class="pagination-container">
        <!-- Rows per page dropdown -->
        <div class="rows-per-page">
        <label style="color:#3ca1ab;" for="pageSize">Rows per page:</label>
            <select id="pageSize" onchange="location.href='?pageSize=' + this.value + '&pageNumber=1@(queryString)'">
                @for (int size = 5; size <= 50; size += 5)
                {
                    @if (Model.PageSize == size)
                    {
                    <option style="color:black;" value="@size" selected>@size</option>
                    }
                    else
                    {
                    <option style="color:black;" value="@size">@size</option>
                    }
                }
            </select>
        </div>
        <ul class="pagination">
            <!-- First Button -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a data-bs-toggle="tooltip" data-bs-placement="left" data-bs-original-title="First" class="page-link" href="?pageNumber=1&pageSize=@Model.PageSize@(queryString)">&lt;&lt;</a>
            </li>

            <!-- Previous Button -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Previous" class="page-link" href="?pageNumber=@(Model.PageIndex - 1)&pageSize=@Model.PageSize@(queryString)">&lt;</a>
            </li>

            <!-- Current Page -->
            <li class="page-item active">
                <span class="page-link">@Model.PageIndex</span>
            </li>

            <!-- Next Button -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Next" class="page-link" href="?pageNumber=@(Model.PageIndex + 1)&pageSize=@Model.PageSize@(queryString)">&gt;</a>
            </li>

            <!-- Last Button -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Last" class="page-link" href="?pageNumber=@Model.TotalPages&pageSize=@Model.PageSize@(queryString)">&gt;&gt;</a>
            </li>
        </ul>

        <!-- Pagination Dropdown -->
        <div class="pagination-dropdown">
        <label style="color:#3ca1ab;" for="pageSelect">Go to page:</label>
        <select id="pageSelect" onchange="location.href='?pageNumber=' + this.value + '&pageSize=@Model.PageSize@(queryString)'">
            @for (int i = 1; i <= (Model.TotalPages > 0 ? Model.TotalPages : 1); i++) // Ensure at least 1 page exists
            {
                var selectedPage = (Model.PageIndex > 0 ? Model.PageIndex : 1); // Ensure default page is 1
                if (i == selectedPage)
                {
                    <option style="color:black;" value="@i" selected="selected">@i</option>
                }
                else
                {
                    <option style="color:black;" value="@i">@i</option>
                }
            }
        </select>
        </div>
    </div>