<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] · TPS Candidate Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="TechProcess Solutions" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/theme/images/favicon.ico">

    <!-- Saved Light/Dark theme: must run before layout.js -->
    <script src="~/js/tps-theme-init.js" asp-append-version="true"></script>
    <!-- Layout config Js -->
    <script src="~/theme/js/layout.js"></script>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Css -->
    <link href="~/theme/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/theme/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/theme/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- custom Css-->
    <link href="~/theme/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- TPS design system -->
    <link href="~/css/tps-design.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/css/tps-components.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/css/tps-auth.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <script src="~/js/tps-loader.js" asp-append-version="true"></script>

</head>

<body class="tps-auth">

    <main class="tps-auth__grid">
        <!-- Brand panel -->
        <section class="tps-auth__brand" aria-label="About the system">
            <a href="/" class="tps-auth__logo">
                <img src="~/theme/images/TechProcessSolutions-logo_White.svg" alt="TechProcess Solutions" />
            </a>

            <div class="tps-auth__pitch">
                <p class="tps-eyebrow">Candidate Management System</p>
                <h1>Every candidate, every interview, one accountable process.</h1>
                <p class="tps-auth__lede">
                    Sign in to review your pipeline, run interviews, record evaluations and move candidates
                    to a decision.
                </p>
            </div>

            <ol class="tps-auth__flow" aria-label="Recruitment workflow">
                <li><i class="ri-user-add-line"></i><span>Candidate added</span></li>
                <li><i class="ri-calendar-event-line"></i><span>HR interview</span></li>
                <li><i class="ri-code-box-line"></i><span>Technical</span></li>
                <li><i class="ri-award-line"></i><span>Decision</span></li>
            </ol>
        </section>

        <!-- Form panel -->
        <section class="tps-auth__panel">
            <button type="button" class="tps-theme-fab tps-auth__theme" data-tps-theme-toggle aria-label="Switch to dark mode">
                <i class="ri-moon-clear-line" data-tps-theme-icon></i>
            </button>

            <div class="tps-auth__card">
                @RenderBody()
            </div>

            <footer class="tps-auth__foot">
                &copy; <span id="tps-year">@DateTime.Now.Year</span> TechProcess Solutions &middot; Internal system for authorized staff
            </footer>
        </section>
    </main>

    <!-- JAVASCRIPT -->
    <script src="~/theme/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/theme/libs/simplebar/simplebar.min.js"></script>
    <script src="~/theme/libs/node-waves/waves.min.js"></script>
    <script src="~/theme/libs/feather-icons/feather.min.js"></script>
    <script src="~/theme/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/theme/js/plugins.js"></script>
    <script src="~/js/tps-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
