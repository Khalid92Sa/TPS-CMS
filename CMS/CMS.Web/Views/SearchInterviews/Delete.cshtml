@model CMS.Application.DTOs.InterviewsDTO

@{
    ViewData["Title"] = "Delete Interview";
}

<!-- Page Container -->
<div class="container my-5">
    <div class="card shadow border-0 rounded-lg">
        <div class="card-header text-dark text-center py-4 border-bottom" style="background-color:#405189;">
            <h4 class="mb-0" style="color:white;">Confirm Deletion</h4>
        </div>

        <div class="card-body px-4 py-5">
            <div class="alert alert-light text-center shadow-sm border border-warning rounded-lg">
                <h5 class="mb-3 text-danger">Are you sure you want to delete this interview?</h5>
                <p class="text-muted">This action cannot be undone. All associated child entities will also be deleted.</p>
            </div>

            <!-- Two-Column Layout -->
            <div class="row">
                <!-- Left Column -->
                <div class="col-md-6">
                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Full Name:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Track:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TrackName)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Date:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Date)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Notes:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.Notes != null)
                            {
                                @Html.DisplayFor(model => model.Notes)
                            }
                            else
                            {
                                <span class="text-muted">No notes added</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">CV Attachment:</dt>
                        <dd class="col-sm-8">
                            @if (Model.CandidateCVAttachmentId != null)
                            {
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.CandidateCVAttachmentId" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Download CV">
                                    <i style="font-size: x-large;margin-top:5px;" class="bx bxs-cloud-download icon-download"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No CV added for this candidate</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <dl class="row mb-4 align-items-center">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Level:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Interviewer:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.InterviewerName)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Status:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.StatusName)</dd>

                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Stop Cycle Note:</dt>
                        <dd class="col-sm-8">
                            @if (@Model.StopCycleNote != null)
                            {
                                @Model.StopCycleNote
                            }
                            else
                            {
                                <span class="text-muted">No stop cycle note provided</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            <br />

            <!-- Action Buttons -->
            <div class="text-center mt-4">
                <form id="deleteForm" asp-action="Delete">
                    <button type="button" class="btn btn-danger btn-lg rounded-pill px-5 shadow" onclick="showSwalConfirm()">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-5 ml-3 shadow">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showSwalConfirm() {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This action will permanently delete the interview and its data!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e3342f',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
            customClass: {
                popup: 'animated fadeInDown',
                confirmButton: 'btn btn-danger rounded-pill px-5',
                cancelButton: 'btn btn-outline-secondary rounded-pill px-5'
            },
            buttonsStyling: false,
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('deleteForm').submit();
            }
        });
    }
</script>

<!-- Font Awesome for Icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
