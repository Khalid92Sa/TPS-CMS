@using CMS.Application.Helpers
@using CMS.Domain.Enums;
@model IEnumerable<CMS.Application.DTOs.InterviewsDTO>
@{
    ViewData["Title"] = "Interview Search";

    DateTime? fromDate = ViewBag.fromDate as DateTime?;
    DateTime? toDate = ViewBag.toDate as DateTime?;
    string candidateFilter = ViewBag.candidateFilter as string;
    string positionFilter = ViewBag.positionFilter as string;
    string interviewerFilter = ViewBag.interviewerFilter as string;
    int? statusFilter = ViewBag.statusFilter as int?;
    int? trackFilter = ViewBag.TrackList as int?;

    var positionList = ViewBag.PositionList as SelectList;
    var trackList = ViewBag.TrackListDropdown as SelectList;
    var statusList = ViewBag.StatusList as SelectList;
    var interviewerList = ViewBag.InterviewerList as SelectList;

    string TextOf(SelectList list, string value) =>
        string.IsNullOrEmpty(value) ? null : list?.FirstOrDefault(i => i.Value == value)?.Text;

    // Active filters, shown as chips above the results
    var active = new List<(string Label, string Value)>();
    if (!string.IsNullOrWhiteSpace(candidateFilter)) active.Add(("Candidate", candidateFilter));
    if (statusFilter.HasValue) active.Add(("Status", TextOf(statusList, statusFilter.ToString()) ?? statusFilter.ToString()));
    if (!string.IsNullOrEmpty(interviewerFilter)) active.Add(("Interviewer", TextOf(interviewerList, interviewerFilter) ?? "Selected"));
    if (fromDate.HasValue || toDate.HasValue)
        active.Add(("Date", $"{fromDate?.ToString("dd MMM yyyy") ?? "Any"} – {toDate?.ToString("dd MMM yyyy") ?? "Any"}"));
    if (!string.IsNullOrEmpty(positionFilter)) active.Add(("Level", TextOf(positionList, positionFilter) ?? positionFilter));
    if (trackFilter.HasValue) active.Add(("Track", TextOf(trackList, trackFilter.ToString()) ?? trackFilter.ToString()));

    bool advancedOpen = !string.IsNullOrEmpty(positionFilter) || trackFilter.HasValue;

    // Paging summary ("Showing 1–10 of 48")
    var paged = Model as PaginatedList<CMS.Application.DTOs.InterviewsDTO>;
    int totalCount = paged?.TotalCount ?? Model?.Count() ?? 0;
    int firstRow = paged != null && totalCount > 0 ? (paged.PageIndex - 1) * paged.PageSize + 1 : (totalCount > 0 ? 1 : 0);
    int lastRow = paged != null ? Math.Min(firstRow + paged.Count - 1, totalCount) : totalCount;
}

@* ===================== Filters ===================== *@
<form id="interviewFilterForm" method="get" action="/interviewsfilteration/index" novalidate>
    <div class="card tps-filter">
        <div class="tps-filter__head">
            <div class="tps-section-title">
                <div>
                    <h4 class="card-title">Find interviews</h4>
                    <p>Filter by candidate, outcome, interviewer or date. Leave a field empty to include everything.</p>
                </div>
            </div>
            <a class="btn btn-secondary btn-sm"
               asp-action="ExportFilteredData"
               asp-route-positionFilter="@positionFilter"
               asp-route-scoreFilter="@ViewBag.scoreFilter"
               asp-route-statusFilter="@statusFilter"
               asp-route-candidateFilter="@candidateFilter"
               asp-route-interviewerFilter="@interviewerFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-trackFilter="@trackFilter">
                <i class="ri-file-excel-2-line me-1"></i> Export to Excel
            </a>
        </div>

        <div class="tps-filter__body">
            <div class="tps-filter__grid">
                <div>
                    <label for="candidateFilter" class="form-label">Candidate</label>
                    <div class="tps-search mw-100">
                        <i class="ri-search-line"></i>
                        <input type="search" id="candidateFilter" name="candidateFilter" class="form-control"
                               placeholder="Name of the candidate" value="@candidateFilter" autocomplete="off" dir="auto" />
                    </div>
                </div>

                <div>
                    <label for="statusFilter" class="form-label">Status</label>
                    @Html.DropDownList("statusFilter", statusList, "Any status", new { @class = "form-select", id = "statusFilter" })
                </div>

                <div>
                    <label for="interviewerFilter" class="form-label">Interviewer</label>
                    @Html.DropDownList("interviewerFilter", interviewerList, "Any interviewer", new { @class = "form-select", id = "interviewerFilter", data_searchable = "" })
                </div>

                <div class="tps-span-2">
                    <label for="fromDate" class="form-label">Interview date</label>
                    <div class="tps-range">
                        <input type="date" id="fromDate" name="fromDate" class="form-control" aria-label="From date"
                               value="@fromDate?.ToString("yyyy-MM-dd")" />
                        <span class="tps-range__sep">to</span>
                        <input type="date" id="toDate" name="toDate" class="form-control" aria-label="To date"
                               value="@toDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="tps-presets" role="group" aria-label="Quick date ranges">
                        <button type="button" class="tps-preset" data-range="today">Today</button>
                        <button type="button" class="tps-preset" data-range="week">This week</button>
                        <button type="button" class="tps-preset" data-range="month">This month</button>
                        <button type="button" class="tps-preset" data-range="30">Last 30 days</button>
                        <button type="button" class="tps-preset" data-range="clear">Any date</button>
                    </div>
                    <div id="dateValidationMessage" class="text-danger fs-12 mt-1" role="alert"></div>
                </div>
            </div>

            <div class="tps-filter__advanced @(advancedOpen ? "" : "d-none")" id="advancedFilters">
                <div class="tps-filter__advanced-title">More filters</div>
                <div class="tps-filter__grid">
                    <div>
                        <label for="position-dropdown" class="form-label">Level</label>
                        @Html.DropDownList("positionFilter", positionList, "Any level", new { @class = "form-select", id = "position-dropdown", data_searchable = "" })
                    </div>
                    <div>
                        <label for="track-dropdown" class="form-label">Track</label>
                        @Html.DropDownList("trackFilterDropdown", trackList, "Any track", new { @class = "form-select", id = "track-dropdown", data_searchable = "" })
                    </div>
                </div>
            </div>
        </div>

        <div class="tps-filter__foot">
            <button type="button" class="btn btn-link btn-sm px-0" id="toggleAdvanced" aria-controls="advancedFilters" aria-expanded="@(advancedOpen ? "true" : "false")">
                <i class="ri-equalizer-line me-1"></i><span>@(advancedOpen ? "Fewer filters" : "More filters")</span>
            </button>
            <div class="tps-filter__actions">
                <a href="/interviewsfilteration/index" class="btn btn-secondary" id="resetButton">
                    <i class="ri-filter-off-line me-1"></i> Clear filters
                </a>
                <button type="submit" class="btn btn-primary" id="filterButton">
                    <i class="ri-search-line me-1"></i> Apply filters
                </button>
            </div>
        </div>
    </div>
</form>

@* ===================== Results ===================== *@
<div class="card">
    <div class="card-header">
        <div class="tps-results-head">
            <div>
                <h4 class="card-title">Results</h4>
                @if (active.Count > 0)
                {
                    <div class="tps-active-filters mt-2">
                        <span>Filtered by</span>
                        @foreach (var f in active)
                        {
                            <span class="tps-filter-chip"><span class="opacity-75">@f.Label:</span> <span dir="auto">@f.Value</span></span>
                        }
                    </div>
                }
            </div>
            <span class="tps-results-count">
                @if (totalCount > 0)
                {
                    <text>Showing <strong>@firstRow–@lastRow</strong> of <strong>@totalCount</strong></text>
                }
                else
                {
                    <text>No results</text>
                }
            </span>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="interviewResults">
                <thead>
                    <tr>
                        <th style="width:48px;">#</th>
                        <th>Candidate</th>
                        <th>Track</th>
                        <th>Interviewers</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>CV</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 0;
                        foreach (var item in Model)
                        {
                            i++;
                            bool hasSecond = !string.IsNullOrEmpty(item.SecondInterviewerName) && item.SecondInterviewerName != "User not found";
                            <tr>
                                <td>@(firstRow > 0 ? firstRow + i - 1 : i)</td>
                                <td>
                                    <div class="fw-semibold text-body" dir="auto">@item.FullName</div>
                                    <div class="text-muted fs-12">@item.Name</div>
                                </td>
                                <td>@item.TrackName</td>
                                <td>
                                    @if (hasSecond)
                                    {
                                        <div>1 · @item.InterviewerName</div>
                                        <div>2 · @item.SecondInterviewerName</div>
                                    }
                                    else
                                    {
                                        @item.InterviewerName
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <div>@item.Date.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted fs-12">@item.Date.ToString("h:mm tt")</div>
                                </td>
                                <td>@InterviewStatusUi.Badge(item.StatusName)</td>
                                <td>
                                    @if (item.CandidateCVAttachmentId != null)
                                    {
                                        <a class="tps-icon-btn" asp-controller="Attachments" asp-action="Download" asp-route-id="@item.CandidateCVAttachmentId"
                                           data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Download CV" aria-label="Download CV">
                                            <i class="ri-file-download-line"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-12">None</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="tps-actions">
                                        @if (item.StartFromHR)
                                        {
                                            <a class="tps-icon-btn" asp-action="ShowHistoryForHRFirstFlow" asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Candidate history" aria-label="Candidate history">
                                                <i class="ri-history-line"></i>
                                            </a>
                                            <a class="tps-icon-btn"
                                               asp-action="HRFirstDetails"
                                               asp-route-id="@item.InterviewsId"
                                               asp-route-positionFilter="@positionFilter"
                                               asp-route-scoreFilter="@ViewBag.scoreFilter"
                                               asp-route-statusFilter="@statusFilter"
                                               asp-route-candidateFilter="@candidateFilter"
                                               asp-route-interviewerFilter="@interviewerFilter"
                                               asp-route-fromDate="@ViewBag.fromDate"
                                               asp-route-toDate="@ViewBag.toDate"
                                               asp-route-trackFilterDropdown="@trackFilter"
                                               data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Details" aria-label="Details">
                                                <i class="ri-file-list-3-line"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="tps-icon-btn" asp-action="ShowHistory" asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Candidate history" aria-label="Candidate history">
                                                <i class="ri-history-line"></i>
                                            </a>
                                            <a class="tps-icon-btn" asp-action="Details" asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Details" aria-label="Details">
                                                <i class="ri-file-list-3-line"></i>
                                            </a>
                                        }
                                        @if (item.ParentId == null && item.StatusName == StatusCode.GetName("PND") && !User.IsInRole("Viewer"))
                                        {
                                            <a class="tps-icon-btn tps-icon-btn--danger" asp-action="Delete" asp-route-id="@item.InterviewsId"
                                               data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Delete" aria-label="Delete">
                                                <i class="ri-delete-bin-6-line"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="ri-search-eye-line fs-24 d-block mb-2"></i>
                                @(active.Count > 0 ? "No interviews match these filters. Try widening the date range or clearing a filter." : "No interviews found.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.Any())
        {
            @await Html.PartialAsync("_PaginationPartial", Model)
        }
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('interviewFilterForm');
    var fromInput = document.getElementById('fromDate');
    var toInput = document.getElementById('toDate');
    var dateMessage = document.getElementById('dateValidationMessage');
    var candidateInput = document.getElementById('candidateFilter');

    // Open the native date picker when the field is clicked
    [fromInput, toInput].forEach(function (input) {
        input.addEventListener('click', function () { if (input.showPicker) { try { input.showPicker(); } catch (e) { } } });
        input.addEventListener('change', function () { validateDates(); markPreset(); });
    });

    function validateDates() {
        fromInput.classList.remove('input-validation-error');
        toInput.classList.remove('input-validation-error');
        dateMessage.textContent = '';
        if (fromInput.value && toInput.value && fromInput.value > toInput.value) {
            dateMessage.textContent = 'The start date must be on or before the end date.';
            fromInput.classList.add('input-validation-error');
            toInput.classList.add('input-validation-error');
            return false;
        }
        return true;
    }

    // Quick ranges
    function iso(d) {
        var m = d.getMonth() + 1, day = d.getDate();
        return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day;
    }

    function rangeFor(key) {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        if (key === 'today') return [today, today];
        if (key === 'week') {
            var start = new Date(today);
            start.setDate(today.getDate() - ((today.getDay() + 6) % 7)); // Monday
            var end = new Date(start);
            end.setDate(start.getDate() + 6);
            return [start, end];
        }
        if (key === 'month') return [new Date(today.getFullYear(), today.getMonth(), 1), new Date(today.getFullYear(), today.getMonth() + 1, 0)];
        if (key === '30') { var s = new Date(today); s.setDate(today.getDate() - 29); return [s, today]; }
        return null;
    }

    function markPreset() {
        document.querySelectorAll('.tps-preset').forEach(function (btn) {
            var key = btn.getAttribute('data-range');
            var r = rangeFor(key);
            var on = key === 'clear'
                ? !fromInput.value && !toInput.value
                : !!r && fromInput.value === iso(r[0]) && toInput.value === iso(r[1]);
            btn.classList.toggle('active', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
    }

    document.querySelectorAll('.tps-preset').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var r = rangeFor(btn.getAttribute('data-range'));
            fromInput.value = r ? iso(r[0]) : '';
            toInput.value = r ? iso(r[1]) : '';
            validateDates();
            markPreset();
        });
    });
    markPreset();

    // More / fewer filters
    var toggle = document.getElementById('toggleAdvanced');
    var advanced = document.getElementById('advancedFilters');
    toggle.addEventListener('click', function () {
        var open = advanced.classList.toggle('d-none') === false;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.querySelector('span').textContent = open ? 'Fewer filters' : 'More filters';
    });

    // Submit: trim the name and stop on an invalid range
    form.addEventListener('submit', function (e) {
        candidateInput.value = candidateInput.value.trim();
        if (!validateDates()) {
            e.preventDefault();
            fromInput.focus();
        }
    });
});
</script>
