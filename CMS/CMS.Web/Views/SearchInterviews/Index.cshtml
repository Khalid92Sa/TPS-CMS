@using CMS.Application.Helpers
@using CMS.Domain.Enums;
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/selectize.js/0.12.6/css/selectize.bootstrap3.min.css" rel="stylesheet" />


@model IEnumerable<CMS.Application.DTOs.InterviewsDTO>
@{
    ViewData["Title"] = "Interviews Filter";
}
<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }

  /*   #toggleFilter{
        background-color: #405189;
        border-color: #405189;
    } */
</style>

@using (Html.BeginForm("Index", "SearchInterviews", FormMethod.Get))
{
<div class="col-md-3" style="margin-top: -11px;margin-bottom: 21px;margin-left: -8px;">    <label>&nbsp;</label>
    <a asp-action="ExportFilteredData"
       asp-route-positionFilter="@ViewBag.positionFilter"
       asp-route-scoreFilter="@ViewBag.scoreFilter"
       asp-route-statusFilter="@ViewBag.statusFilter"
       asp-route-candidateFilter="@ViewBag.candidateFilter"
       asp-route-interviewerFilter="@ViewBag.interviewerFilter"
       asp-route-fromDate="@ViewBag.fromDate"
       asp-route-toDate="@ViewBag.toDate"
       asp-route-trackFilter="@ViewBag.TrackList"
       class="btn btn-success btn-block">Export to Excel</a>
</div>

   @*  <div class="filter-icon-container" style="margin-bottom: 15px;width: 10%;">
        <button type="button" class="btn btn-secondary" id="toggleFilter" aria-expanded="false" title="Show Filters">
            <i class="bx bx-filter" style="font-size: x-large;"></i> Filter
        </button>
    </div> *@
    <div class="collapse show" id="filterFields" style="margin-bottom: 15px;">
        <div class="form-group">
            <div class="row">
                <div class="col-md-3">
                    @Html.Label("Filter by Levels:")
                    @Html.DropDownList("positionFilter", ViewBag.PositionList as SelectList, "All Levels", new { @class = "form-control", id = "position-dropdown" })
                </div>
                <div class="col-md-3">
                    @Html.Label("Filter by Track:")
                    @Html.DropDownList("trackFilterDropdown", ViewBag.TrackListDropdown as SelectList, "All Tracks", new { @class = "form-control", id = "track-dropdown" })
                </div>
                <div class="col-md-3">
                    @Html.Label("Filter by Status:")
                    @Html.DropDownList("statusFilter", ViewBag.StatusList as SelectList, "All Statuses", new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    @Html.Label("Filter by Candidate:")
                    <input type="text" id="candidateFilter" name="candidateFilter" class="form-control" placeholder="Search by Candidate Name" value="@ViewBag.candidateFilter">
                </div>
                <div class="col-md-3" style="margin-top: 25px;">
                    @Html.Label("Filter by Interviewer:")
                    @Html.DropDownList("interviewerFilter", ViewBag.InterviewerList as SelectList, "All Interviewers", new { @class = "form-control" })
                </div>
                <div class="col-md-3" style="margin-top: 25px;">
                    <label for="fromDate">From Date:</label>
                    <input type="date" id="fromDate" name="fromDate" class="form-control" value="@ViewBag.fromDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3" style="margin-top: 25px;">
                    <label for="toDate">To Date:</label>
                    <input type="date" id="toDate" name="toDate" class="form-control" value="@ViewBag.toDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3" style="margin-top:52px;width: 8%;">
                    <label>&nbsp;</label>
                    <button type="submit" id="filterButton" class="btn btn-primary btn-block">Filter</button>
                </div>
                <div class="col-md-3" style="margin-top:52px;width: 7%;">
                    <button type="button" id="resetButton" class="btn btn-secondary btn-block">Reset</button>
                </div>

                <div id="dateValidationMessage" style="color: red; margin-top: 5px;"></div>
            </div>
        </div>
    </div>
}

<br />

<div class="card-body" style="margin-top: 25px;">
    <table id="add-rows3" class="display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>#</th>
                <th>Candidate Name</th>
                <th>Level</th>
                <th>Track</th>
                <th>Interviewer/s</th>
                <th>Date and Time</th>
                <th>Status</th>
                <th hidden>Parent ID</th>
                <th hidden>Notes</th>
                <th>CV</th>
                <th>History</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
                @for (var i = 0; i < Model.Count(); i++)
                {
                    var item = Model.ElementAt(i);
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.TrackName)</td>

                        @if (item.SecondInterviewerName == "User not found")
                        {
                            <td>@item.InterviewerName</td>
                        }
                        else
                        {
                            <td>
                                <div>1-@item.InterviewerName</div>
                                <div>2-@item.SecondInterviewerName</div>
                                </td>
                        }
                        <td>
                            <div>@item.Date.ToString("dd-MM-yyyy")</div>
                            <div>@item.Date.ToString("h:mm tt")</div>
                        </td>
                        <td>@item.StatusName</td>
                        <td hidden>@item.ParentId</td>
                        <td hidden>@item.Notes</td>
                        
                        @if (item.CandidateCVAttachmentId != null)
                        {
                            <td>

                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@item.CandidateCVAttachmentId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Download CV"><i style="font-size: x-large;" class="bx bxs-cloud-download"></i></a>
                            </td>
                        }
                        else
                        {
                            <td>
                                <p>No CV Available</p>
                            </td>
                        }
                        <td><a class="bx bx-history" style="font-size:x-large" asp-action="ShowHistory" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="View Candidate History"></a></td>

                        <td>
                            <a class="bx bx-detail" style="font-size:x-large" asp-action="Details" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Details"></a>
                            @if (item.ParentId == null && item.StatusName == StatusCode.GetName("PND"))
                            {
                                @: |  <a class="ri-delete-bin-2-line text-danger" style="font-size:x-large" asp-action="Delete" asp-route-id="@item.InterviewsId" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Delete"></a>
                            }
                        </td>

                    </tr>
                }
        </tbody>
    </table>

    @await Html.PartialAsync("_PaginationPartial", Model)


</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/selectize.js/0.12.6/js/standalone/selectize.min.js"></script>

<script>
    // Function to remove trailing spaces from candidate name input field
    function removeTrailingSpaces() {
        var candidateFilter = document.getElementById("candidateFilter");
        candidateFilter.value = candidateFilter.value.trim(); // Remove trailing spaces
    }

    function validateDates() {
        removeTrailingSpaces(); // Remove trailing spaces from candidate name
        var fromDate = new Date(document.getElementById("fromDate").value);
        var toDate = new Date(document.getElementById("toDate").value);
        var validationMessageElement = document.getElementById("dateValidationMessage");

        if (fromDate > toDate) {
            validationMessageElement.textContent = "* 'From Date' should be less than or equal to 'To Date'.";
            $('#fromDate').css('border-color', 'red'); // Highlight "fromDate"
            $('#toDate').css('border-color', 'red');   // Highlight "toDate"
            return false; // Return false to prevent further action
        }

        // Reset styles if validation is successful
        validationMessageElement.textContent = ''; // Clear validation message
        $('#fromDate').css('border-color', '');  // Reset border color
        $('#toDate').css('border-color', '');    // Reset border color
        return true; // Return true if validation passed
    }

    function buildQueryString() {
    const positionFilter = $('#position-dropdown').val();
    const trackFilter = $('#track-dropdown').val();
    const statusFilter = $('#statusFilter').val();
    const candidateFilter = $('#candidateFilter').val();
    const interviewerFilter = $('#interviewerFilter').val();
    const fromDate = $('#fromDate').val();
    const toDate = $('#toDate').val();

    let queryString = `?positionFilter=${encodeURIComponent(positionFilter)}`;
    queryString += `&trackFilterDropdown=${encodeURIComponent(trackFilter)}`;
    queryString += `&statusFilter=${encodeURIComponent(statusFilter)}`;
    queryString += `&candidateFilter=${encodeURIComponent(candidateFilter)}`;
    queryString += `&interviewerFilter=${encodeURIComponent(interviewerFilter)}`;
    queryString += `&fromDate=${encodeURIComponent(fromDate)}`;
    queryString += `&toDate=${encodeURIComponent(toDate)}`;

    window.location.href = '/interviewsfilteration' + queryString;
}




    $('#filterButton').on('click', function (e) {
        e.preventDefault();

        if (!validateDates()) {
            return;
        }

        buildQueryString();
    });



    $(document).ready(function () {
        $('#add-rows3').DataTable({
            paging: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',
            searching: false,
        });

        $('#position-dropdown').selectize();
        $('#track-dropdown').selectize();

    // // Toggle filter section visibility
    // $('#toggleFilter').on('click', function () {
    //     $('#filterFields').collapse('toggle');
    //     $(this).attr('aria-expanded', function(_, attr){
    //         return attr === 'true' ? 'false' : 'true';
    //     });
    // });

     function checkFilters() {
        const hasFilters = $('#position-dropdown').val() ||
                           $('#track-dropdown').val() ||
                           $('#statusFilter').val() ||
                           $('#candidateFilter').val() ||
                           $('#interviewerFilter').val() ||
                           $('#fromDate').val() ||
                           $('#toDate').val();
        
       //if (hasFilters) {
       //    $('#filterFields').collapse('show'); // Keep the filter section open
       //    $('#toggleFilter').attr('aria-expanded', 'true');
       //}
    }

    // Call the checkFilters function on page load
    checkFilters();

    $('#resetButton').on('click', function () {
        $('#position-dropdown')[0].selectize.clear();
        $('#track-dropdown')[0].selectize.clear();
        $('#statusFilter').val('');
        $('#candidateFilter').val('');
        $('#interviewerFilter').val('');
        $('#fromDate').val('');
        $('#toDate').val('');

    window.location.href = '/interviewsfilteration';
});


    });
</script>


