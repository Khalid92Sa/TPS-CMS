@using CMS.Domain.Enums
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@model List<CMS.Application.DTOs.InterviewsDTO>

<style>
    .card-header {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        color: white;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
        border-radius: 10px 10px 0 0;
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        margin-bottom: 1.5rem;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    dt {
        font-weight: bold;
        font-size: 1rem;
        color: #333;
    }

    dd {
        font-size: 0.95rem;
        color: #555;
    }

    .text-muted {
        font-size: 0.9rem;
    }

    .btn-link {
        font-size: 13px;
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-link:hover {
        color: white;
        text-decoration: underline;
    }

    .mt-15 {
        margin-top: 15px;
    }

    .container {
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    .row {
        margin-bottom: 1.5rem;
    }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

    .btn-secondary:hover {
        background-color: darkgray !important;
        border-color: darkgray !important;
    }

    .card-body hr {
        border-top: 1px solid #eee;
    }

    .more-text {
        display: none;
    }

    .more-link {
        cursor: pointer;
        color: #007bff;
        text-decoration: none;
    }

    .more-link:hover {
        text-decoration: underline;
    }

    .card-title {
        color: white !important;
    }

</style>

@{
    var hrInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.HRInitialInterview);
    var interviewersInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.InterviewersReview);
    var gmInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.GMFinalReview);
    
    bool isInterviewer = User.IsInRole("Interviewer");
    
    bool isSolutionArchitecture = User.IsInRole("Solution Architecture");
    bool shouldShowGMCard = true;
    
    if (isInterviewer)
    {
        shouldShowGMCard = false;
    }
    else if (isSolutionArchitecture)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        
        if (currentUser != null && gmInterview != null)
        {
            bool archiInGMInterview = gmInterview.SecondInterviewerId == currentUser.Id;
            
            bool archiWasWithGMInInterviewersStage = false;
            if (interviewersInterview != null)
            {
                bool archiInInterviewersStage = interviewersInterview.InterviewerId == currentUser.Id ||
                                              interviewersInterview.SecondInterviewerId == currentUser.Id;
                
                if (archiInInterviewersStage)
                {
                    var allGMs = await UserManager.GetUsersInRoleAsync("General Manager");
                    var gmIds = allGMs.Select(gm => gm.Id).ToList();
                    
                    archiWasWithGMInInterviewersStage = !string.IsNullOrEmpty(interviewersInterview.SecondInterviewerId) &&
                        gmIds.Contains(interviewersInterview.SecondInterviewerId);
                }
            }
            
            shouldShowGMCard = archiInGMInterview || archiWasWithGMInInterviewersStage;
        }
        else
        {
            shouldShowGMCard = false;
        }
    }
}

<div class="container">
    <!-- Main Details Card -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Main Details</h5>
                </div>
                <div class="card-body">
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">Interview Date:</dt>
                        <dd class="col-sm-9">@hrInterview.Date.ToString("dd-MM-yyyy h:mm tt")</dd>

                        <dt class="col-sm-3">Candidate Name:</dt>
                        <dd class="col-sm-9">@ViewBag.CandidateName</dd>

                        <dt class="col-sm-3">Level:</dt>
                        <dd class="col-sm-9">@ViewBag.PositionName</dd>

                        <dt class="col-sm-3">Track:</dt>
                        <dd class="col-sm-9">@ViewBag.TrackName</dd>

                        <dt class="col-sm-3">CV:</dt>
                        <dd class="col-sm-9">
                            @if (ViewBag.CandidateCVAttachmentId != null)
                            {
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@ViewBag.CandidateCVAttachmentId" class="btn btn-link">Download CV</a>
                            }
                            else
                            {
                                <span class="text-muted">CV not available</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- HR Initial Interview Card (Stage 4) -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        HR Initial Interview
                    </h5>
                </div>
                <div class="card-body">
                    <hr />
                    @if (hrInterview != null)
                    {
                        <dl class="row">
                            <dt>Interviewer Name:</dt>
                            <dd>@hrInterview.InterviewerName</dd>

                            <dt class="mt-15">Status:</dt>
                            <dd>@hrInterview.StatusName</dd>

                            <dt class="mt-15">Notes:</dt>
                            <dd>
                                @if (!string.IsNullOrEmpty(hrInterview.Notes))
                                {
                                    @Html.Raw(ShowMore(hrInterview.Notes, 100))
                                }
                                else
                                {
                                    <span class="text-muted">No notes added</span>
                                }
                            </dd>

                            @if (User.IsInRole("Admin") || User.IsInRole("HR Manager"))
                            {
                                <dt class="mt-15">Stop Cycle Note:</dt>
                                <dd>
                                    @if (!string.IsNullOrEmpty(hrInterview.StopCycleNote))
                                    {
                                        @Html.Raw(ShowMore(hrInterview.StopCycleNote, 100))
                                    }
                                    else
                                    {
                                        <span class="text-muted">No stop cycle note</span>
                                    }
                                </dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted">HR interview not found</p>
                    }
                </div>
            </div>
        </div>

        <!-- Interviewers Review Card (Stage 5) -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        Interviewers Review
                    </h5>
                </div>
                <div class="card-body">
                    <hr />
                    @if (interviewersInterview != null)
                    {
                        <dl class="row">
                            <dt>First Interviewer:</dt>
                            <dd>@interviewersInterview.InterviewerName</dd>

                            @if (!string.IsNullOrEmpty(interviewersInterview.SecondInterviewerId))
                            {
                                <dt class="mt-15">Second Interviewer:</dt>
                                <dd>@interviewersInterview.SecondInterviewerName</dd>
                            }

                            <dt class="mt-15">Status:</dt>
                            <dd>@interviewersInterview.StatusName</dd>

                            <dt class="mt-15">Score:</dt>
                            <dd>
                                @if (interviewersInterview.Score.HasValue)
                                {
                                    @interviewersInterview.Score
                                }
                                else
                                {
                                    <span class="text-muted">No score yet</span>
                                }
                            </dd>

                            <dt class="mt-15">Actual Experience:</dt>
                            <dd>
                                @if (interviewersInterview.ActualExperience.HasValue)
                                {
                                    @interviewersInterview.ActualExperience
                                }
                                else
                                {
                                    <span class="text-muted">No actual experience added</span>
                                }
                            </dd>

                            <dt class="mt-15">Evaluation:</dt>
                            <dd>
                                @if (interviewersInterview.AttachmentId != null)
                                {
                                    <a asp-controller="Attachments" asp-action="Download" asp-route-id="@interviewersInterview.AttachmentId" class="btn btn-link">Download evaluation</a>
                                }
                                else
                                {
                                    <span class="text-muted">No evaluation available</span>
                                }
                            </dd>

                            <dt class="mt-15">Notes:</dt>
                            <dd>
                                @if (!string.IsNullOrEmpty(interviewersInterview.Notes))
                                {
                                    @Html.Raw(ShowMore(interviewersInterview.Notes, 100))
                                }
                                else
                                {
                                    <span class="text-muted">No notes added</span>
                                }
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted">Interviewers review not started yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- GM Final Review Card (Stage 6) -->
        @if (shouldShowGMCard)
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">
                            GM Final Review
                        </h5>
                    </div>
                    <div class="card-body">
                        <hr />
                        @if (gmInterview != null)
                        {
                            <dl class="row">
                                <dt>GM Interviewer:</dt>
                                <dd>@gmInterview.InterviewerName</dd>

                                @if (!string.IsNullOrEmpty(gmInterview.SecondInterviewerId))
                                {
                                    <dt class="mt-15">Architecture Interviewer:</dt>
                                    <dd>@gmInterview.SecondInterviewerName</dd>
                                }

                                <dt class="mt-15">Status:</dt>
                                <dd>@gmInterview.StatusName</dd>

                                <dt class="mt-15">Actual Experience:</dt>
                                <dd>
                                    @if (gmInterview.ActualExperience.HasValue)
                                    {
                                        @gmInterview.ActualExperience
                                    }
                                    else
                                    {
                                        <span class="text-muted">No actual experience added</span>
                                    }
                                </dd>

                                <dt class="mt-15">Notes:</dt>
                                <dd>
                                    @if (!string.IsNullOrEmpty(gmInterview.Notes))
                                    {
                                        @Html.Raw(ShowMore(gmInterview.Notes, 100))
                                    }
                                    else
                                    {
                                        <span class="text-muted">No notes added</span>
                                    }
                                </dd>
                            </dl>
                        }
                        else
                        {
                            <p class="text-muted">GM final review not started yet</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Back Button -->
<div class="mt-3 text-center">
    <a class="btn btn-secondary"
       asp-controller="interviewsFilteration"
       asp-action="Index"
       asp-route-positionFilter="@ViewBag.positionFilter"
       asp-route-scoreFilter="@ViewBag.scoreFilter"
       asp-route-statusFilter="@ViewBag.statusFilter"
       asp-route-candidateFilter="@ViewBag.candidateFilter"
       asp-route-interviewerFilter="@ViewBag.interviewerFilter"
       asp-route-fromDate="@ViewBag.fromDate"
       asp-route-toDate="@ViewBag.toDate"
       asp-route-trackFilterDropdown="@ViewBag.TrackList">
        Back to List
    </a>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $(".more-link").click(function () {
            var moreContent = $(this).siblings(".more-text");
            var moreLink = $(this);

            moreContent.toggle();
            moreLink.text(moreContent.is(":visible") ? "Less" : "More");
        });
    });
</script>

@functions {
    public string ShowMore(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
        {
            return text ?? string.Empty;
        }

        var shortText = text.Substring(0, maxLength);
        var moreText = text.Substring(maxLength);

        return $"{shortText}<span class=\"more-text\">{moreText}</span> <a class=\"more-link\">More</a>";
    }
}

