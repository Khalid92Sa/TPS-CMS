@using CMS.Domain.Enums
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@model List<CMS.Application.DTOs.InterviewsDTO>

@await Html.PartialAsync("_InterviewDetailsStyles")

@{
    var hrInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.HRInitialInterview);
    var interviewersInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.InterviewersReview);
    var gmInterview = Model.FirstOrDefault(i => i.WorkflowStageId == (int)EnumWorkflowStage.GMFinalReview);

    bool isInterviewer = User.IsInRole("Interviewer");
    bool isSolutionArchitecture = User.IsInRole("Solution Architecture");
    bool shouldShowGMCard = true;

    if (isInterviewer)
    {
        shouldShowGMCard = false;
    }
    else if (isSolutionArchitecture)
    {
        var currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null && gmInterview != null)
        {
            bool archiInGMInterview = gmInterview.SecondInterviewerId == currentUser.Id;
            bool archiWasWithGMInInterviewersStage = false;

            if (interviewersInterview != null)
            {
                bool archiInInterviewersStage = interviewersInterview.InterviewerId == currentUser.Id ||
                                              interviewersInterview.SecondInterviewerId == currentUser.Id;

                if (archiInInterviewersStage)
                {
                    var allGMs = await UserManager.GetUsersInRoleAsync("General Manager");
                    var gmIds = allGMs.Select(gm => gm.Id).ToList();

                    archiWasWithGMInInterviewersStage = !string.IsNullOrEmpty(interviewersInterview.SecondInterviewerId) &&
                        gmIds.Contains(interviewersInterview.SecondInterviewerId);
                }
            }

            shouldShowGMCard = archiInGMInterview || archiWasWithGMInInterviewersStage;
        }
        else
        {
            shouldShowGMCard = false;
        }
    }
}

<div class="container interview-details-page">
    <div class="interview-details-page__header">
        <div class="interview-details-page__title">
            <h2>HR First Flow Details</h2>
            <p><i class="bx bx-user me-1"></i>@ViewBag.CandidateName</p>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.TrackName as string))
        {
            <div class="interview-details-page__badges">
                <span class="detail-badge detail-badge--muted"><i class="bx bx-git-branch"></i>@ViewBag.TrackName</span>
            </div>
        }
    </div>

    <div class="detail-summary-card">
        <div class="detail-summary-card__header">
            <span class="interview-detail-card__icon"><i class="bx bx-id-card"></i></span>
            <h5>Main Details</h5>
        </div>
        <div class="detail-summary-card__body">
            <div class="detail-summary-grid">
                <div class="detail-field">
                    <div class="detail-field__label">Interview Date</div>
                    <div class="detail-field__value">@(hrInterview?.Date.ToString("dd-MM-yyyy h:mm tt") ?? "—")</div>
                </div>
                <div class="detail-field">
                    <div class="detail-field__label">Candidate Name</div>
                    <div class="detail-field__value">@ViewBag.CandidateName</div>
                </div>
                <div class="detail-field">
                    <div class="detail-field__label">Level</div>
                    <div class="detail-field__value">@ViewBag.PositionName</div>
                </div>
                <div class="detail-field">
                    <div class="detail-field__label">Track</div>
                    <div class="detail-field__value">@ViewBag.TrackName</div>
                </div>
                <div class="detail-field">
                    <div class="detail-field__label">CV</div>
                    <div class="detail-field__value">
                        @if (ViewBag.CandidateCVAttachmentId != null)
                        {
                            <a asp-controller="Attachments" asp-action="Download" asp-route-id="@ViewBag.CandidateCVAttachmentId" class="detail-download-btn">
                                <i class="bx bx-download"></i> Download CV
                            </a>
                        }
                        else
                        {
                            <span class="detail-empty-state">CV not available</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row interview-cards-row">
        <!-- HR Initial Interview -->
        <div class="@NotesDisplayHelper.GetHrCardColumnClass(hrInterview?.Notes)">
            <div class="interview-detail-card">
                <div class="interview-detail-card__header">
                    <span class="interview-detail-card__icon"><i class="bx bx-user-voice"></i></span>
                    <h5 class="interview-detail-card__title">HR Initial Interview</h5>
                </div>
                <div class="interview-detail-card__body">
                    @if (hrInterview != null)
                    {
                        <div class="detail-field">
                            <div class="detail-field__label">Interviewer</div>
                            <div class="detail-field__value">@hrInterview.InterviewerName</div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Status</div>
                            <div class="detail-field__value">@hrInterview.StatusName</div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Notes</div>
                            <div class="detail-field__value detail-field__value--notes">
                                @if (!string.IsNullOrEmpty(hrInterview.Notes))
                                {
                                    @await Html.PartialAsync("_NotesContent", new { Content = hrInterview.Notes, MaxLength = 100 })
                                }
                                else
                                {
                                    <span class="detail-empty-state">No notes added</span>
                                }
                            </div>
                        </div>
                        @if (User.IsInRole("Admin") || User.IsInRole("HR Manager"))
                        {
                            <div class="detail-field">
                                <div class="detail-field__label">Stop Cycle Note</div>
                                <div class="detail-field__value">
                                    @if (!string.IsNullOrEmpty(hrInterview.StopCycleNote))
                                    {
                                        @await Html.PartialAsync("_NotesContent", new { Content = hrInterview.StopCycleNote, MaxLength = 100 })
                                    }
                                    else
                                    {
                                        <span class="detail-empty-state">No stop cycle note</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="detail-empty-state">HR interview not found</p>
                    }
                </div>
            </div>
        </div>

        <!-- Interviewers Review -->
        <div class="@NotesDisplayHelper.GetHrCardColumnClass(interviewersInterview?.Notes)">
            <div class="interview-detail-card">
                <div class="interview-detail-card__header">
                    <span class="interview-detail-card__icon"><i class="bx bx-microphone"></i></span>
                    <h5 class="interview-detail-card__title">Interviewers Review</h5>
                </div>
                <div class="interview-detail-card__body">
                    @if (interviewersInterview != null)
                    {
                        <div class="detail-field">
                            <div class="detail-field__label">First Interviewer</div>
                            <div class="detail-field__value">@interviewersInterview.InterviewerName</div>
                        </div>
                        @if (!string.IsNullOrEmpty(interviewersInterview.SecondInterviewerId))
                        {
                            <div class="detail-field">
                                <div class="detail-field__label">Second Interviewer</div>
                                <div class="detail-field__value">@interviewersInterview.SecondInterviewerName</div>
                            </div>
                        }
                        <div class="detail-field">
                            <div class="detail-field__label">Status</div>
                            <div class="detail-field__value">@interviewersInterview.StatusName</div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Score</div>
                            <div class="detail-field__value">@(interviewersInterview.Score?.ToString() ?? "—")</div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Actual Experience</div>
                            <div class="detail-field__value">@(interviewersInterview.ActualExperience?.ToString() ?? "—")</div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Evaluation</div>
                            <div class="detail-field__value">
                                @if (interviewersInterview.AttachmentId != null)
                                {
                                    <a asp-controller="Attachments" asp-action="Download" asp-route-id="@interviewersInterview.AttachmentId" class="detail-download-btn">
                                        <i class="bx bx-download"></i> Download evaluation
                                    </a>
                                }
                                else
                                {
                                    <span class="detail-empty-state">No evaluation available</span>
                                }
                            </div>
                        </div>
                        <div class="detail-field">
                            <div class="detail-field__label">Notes</div>
                            <div class="detail-field__value detail-field__value--notes">
                                @if (!string.IsNullOrEmpty(interviewersInterview.Notes))
                                {
                                    @await Html.PartialAsync("_NotesContent", new { Content = interviewersInterview.Notes, MaxLength = 100 })
                                }
                                else
                                {
                                    <span class="detail-empty-state">No notes added</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="detail-empty-state">Interviewers review not started yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- GM Final Review -->
        @if (shouldShowGMCard)
        {
            <div class="@NotesDisplayHelper.GetHrCardColumnClass(gmInterview?.Notes)">
                <div class="interview-detail-card">
                    <div class="interview-detail-card__header">
                        <span class="interview-detail-card__icon"><i class="bx bx-crown"></i></span>
                        <h5 class="interview-detail-card__title">GM Final Review</h5>
                    </div>
                    <div class="interview-detail-card__body">
                        @if (gmInterview != null)
                        {
                            <div class="detail-field">
                                <div class="detail-field__label">GM Interviewer</div>
                                <div class="detail-field__value">@gmInterview.InterviewerName</div>
                            </div>
                            @if (!string.IsNullOrEmpty(gmInterview.SecondInterviewerId))
                            {
                                <div class="detail-field">
                                    <div class="detail-field__label">Architecture Interviewer</div>
                                    <div class="detail-field__value">@gmInterview.SecondInterviewerName</div>
                                </div>
                            }
                            <div class="detail-field">
                                <div class="detail-field__label">Status</div>
                                <div class="detail-field__value">@gmInterview.StatusName</div>
                            </div>
                            <div class="detail-field">
                                <div class="detail-field__label">Actual Experience</div>
                                <div class="detail-field__value">@(gmInterview.ActualExperience?.ToString() ?? "—")</div>
                            </div>
                            <div class="detail-field">
                                <div class="detail-field__label">Notes</div>
                                <div class="detail-field__value detail-field__value--notes">
                                    @if (!string.IsNullOrEmpty(gmInterview.Notes))
                                    {
                                        @await Html.PartialAsync("_NotesContent", new { Content = gmInterview.Notes, MaxLength = 100 })
                                    }
                                    else
                                    {
                                        <span class="detail-empty-state">No notes added</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="detail-empty-state">GM final review not started yet</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="interview-details-page__footer">
        <a class="btn-detail-back"
           asp-controller="interviewsFilteration"
           asp-action="Index"
           asp-route-positionFilter="@ViewBag.positionFilter"
           asp-route-scoreFilter="@ViewBag.scoreFilter"
           asp-route-statusFilter="@ViewBag.statusFilter"
           asp-route-candidateFilter="@ViewBag.candidateFilter"
           asp-route-interviewerFilter="@ViewBag.interviewerFilter"
           asp-route-fromDate="@ViewBag.fromDate"
           asp-route-toDate="@ViewBag.toDate"
           asp-route-trackFilterDropdown="@ViewBag.TrackList">
            <i class="bx bx-arrow-back"></i> Back to List
        </a>
    </div>
</div>
