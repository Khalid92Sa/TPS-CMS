@model IEnumerable<CMS.Application.DTOs.InterviewsDTO>
@using System

<style>
    .table {
        border-collapse: collapse;
        width: 100%;
        margin: 20px 0;
        font-size: 0.9rem;
        text-align: left;
        table-layout: fixed; 
    }

        .table th, .table td {
            padding: 12px 15px;
            border: 1px solid #ddd;
            word-wrap: break-word; 
        }

        .table th {
            background-color: #f4f4f4;
            font-weight: bold;
        }

        .table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

    .more-text {
        display: none;
    }

    .more-link {
        cursor: pointer;
        color: #007bff;
        text-decoration: none;
    }

        .more-link:hover {
            text-decoration: underline;
        }

    .empty-cell {
        color: #aaa;
        font-style: italic;
        text-align: center;
    }

    .interview-type-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: bold;
        margin-left: 8px;
    }

    .badge-hr {
        background-color: #28a745;
        color: white;
    }

    .badge-interviewer {
        background-color: #007bff;
        color: white;
    }

    .badge-gm {
        background-color: #ffc107;
        color: #333;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 10px 20px;
        margin-top: 20px;
        cursor: pointer;
        border-radius: 4px;
        text-align: center;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }
</style>

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center">
                <h5>HR-First Flow History: <span style="color:red">@ViewBag.CandidateName</span></h5>
            </div>
            <div class="card-body">
                <table id="add-rows" class="table">
                    <thead>
                        <tr>
                            <th>Candidate Name</th>
                            <th>Company Name</th>
                            <th>Interviewer(s)</th>
                            <th>Score</th>
                            <th>Actual Experience</th>
                            <th>Notes</th>
                            <th>Evaluation</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                <td>@item.CompanyName</td>
                                <td>@(item.SecondInterviewerId != null ? $"{item.InterviewerName} & {item.SecondInterviewerName}" : item.InterviewerName)</td>
                                @if (item.Score != null)
                                {
                                    <td>@item.Score</td>
                                }
                                else
                                {
                                    <td style="max-width: 200px; white-space: pre-line;" class="text-muted">No score here</td>
                                }
                                @if (item.ActualExperience != null)
                                {
                                    <td>@item.ActualExperience</td>
                                }
                                else
                                {
                                    <td style="max-width: 200px; white-space: pre-line;" class="text-muted">No Actual Experience added</td>
                                }
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div style="overflow: hidden; text-overflow: ellipsis;">
                                            @Html.Raw(ShowMore(item.Notes, 100))
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="empty-cell">No notes added</span>
                                    }
                                </td>
                                <td>
                                    @if (item.AttachmentId != null)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="Attachments" asp-action="Download" asp-route-id="@item.AttachmentId">Download</a>
                                    }
                                    else
                                    {
                                        <span class="empty-cell">No evaluation here</span>
                                    }
                                </td>
                                <td>@item.Date.ToString("MM/dd/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="text-center">
                    <a class="btn btn-secondary" href="@Url.Action("Index", new { positionFilter = ViewBag.PositionFilter, scoreFilter = ViewBag.ScoreFilter, statusFilter = ViewBag.StatusFilter, candidateFilter = ViewBag.CandidateFilter, interviewerFilter = ViewBag.InterviewerFilter, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, trackFilterDropdown = ViewBag.TrackList })">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $(".more-link").click(function () {
            var moreContent = $(this).siblings(".more-text");
            var moreLink = $(this);

            moreContent.toggle();
            moreLink.text(moreContent.is(":visible") ? "Less" : "More");
        });
    });
</script>

@functions {
    public string ShowMore(string text, int maxLength)
    {
        if (text.Length <= maxLength)
        {
            return text;
        }

        var shortText = text.Substring(0, maxLength);
        var moreText = text.Substring(maxLength);

        return $"{shortText}<span class='more-text'>{moreText}</span> <a class='more-link'>More</a>";
    }
}

