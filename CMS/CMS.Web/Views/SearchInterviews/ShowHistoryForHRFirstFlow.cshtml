@model IEnumerable<CMS.Application.DTOs.InterviewsDTO>
@{
    ViewData["Title"] = "Interview History";
    ViewData["HistoryChronological"] = true;
    ViewData["HistoryFlowLabel"] = "HR-first flow";
    string V(object o) => o is DateTime d ? d.ToString("yyyy-MM-dd") : o?.ToString();
    ViewData["HistoryBack"] = new Dictionary<string, string>
    {
        ["action"] = "Index",
        ["positionFilter"] = V((object)ViewBag.PositionFilter),
        ["scoreFilter"] = V((object)ViewBag.ScoreFilter),
        ["statusFilter"] = V((object)ViewBag.StatusFilter),
        ["candidateFilter"] = V((object)ViewBag.CandidateFilter),
        ["interviewerFilter"] = V((object)ViewBag.InterviewerFilter),
        ["fromDate"] = V((object)ViewBag.FromDate),
        ["toDate"] = V((object)ViewBag.ToDate),
        ["trackFilterDropdown"] = V((object)ViewBag.TrackList)
    };
}

@await Html.PartialAsync("_InterviewHistory", Model)
