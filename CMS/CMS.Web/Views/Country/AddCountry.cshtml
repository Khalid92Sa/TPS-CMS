@model CMS.Application.DTOs.CountryDTO

@{
    ViewData["Title"] = "Add a Country";
}

<form asp-action="AddCountry" class="needs-validation" novalidate id="countryForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-earth-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Countries</p>
                <h2 class="tps-ihead__name">New country</h2>
            </div>
        </div>
    </div>

    <section class="card tps-fsection" aria-labelledby="sec-country">
        <div class="card-header">
            <span class="tps-fsection__icon"><i class="ri-earth-line"></i></span>
            <div>
                <h4 class="tps-fsection__title" id="sec-country">Country</h4>
                <p class="tps-fsection__desc">The country companies and positions are linked to.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="tps-fgrid">
                <div class="tps-field">
                    <label asp-for="Name" class="form-label">Country name <span class="tps-req">*</span></label>
                    <input asp-for="Name" class="form-control" id="Name" placeholder="e.g. Jordan" dir="auto" autocomplete="off">
                    <div class="invalid-feedback">Enter the country name.</div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <span id="errorMessage" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetCountries">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-add-line me-1"></i> Add country</button>
        </div>
    </div>
</form>

<script>
    $(function () {
        // Duplicate-name check. Only a confirmed duplicate blocks saving; if the lookup
        // is slow or fails, submission is not blocked.
        var nameTaken = false;
        var timer = null;
        var check = null;

        function setNameError(message) {
            $('#Name').toggleClass('is-invalid', !!message);
            $('#errorMessage').text(message || '');
        }

        $('#Name').on('input', function () {
            var name = $(this).val().trim();
            nameTaken = false;
            setNameError('');
            clearTimeout(timer);
            if (!name) return;
            timer = setTimeout(function () {
                if (check) check.abort();
                check = $.ajax({
                    url: '@Url.Action("CheckCountryName", "Country")',
                    data: { name: name },
                    type: 'POST',
                    tpsLoader: false,
                    success: function (response) {
                        nameTaken = !!response.exists;
                        setNameError(nameTaken ? 'A country with this name already exists.' : '');
                    }
                });
            }, 350);
        });

        $('#countryForm').submit(function (e) {
            var name = $('#Name').val().trim();
            if (!name) {
                $('#Name').addClass('is-invalid');
                e.preventDefault();
                return;
            }
            if (nameTaken) {
                setNameError('A country with this name already exists.');
                e.preventDefault();
            }
        });

        if ($('#Name').val().trim()) $('#Name').trigger('input');
    });
</script>
