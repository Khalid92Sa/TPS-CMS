@model CMS.Application.DTOs.CountryDTO

@{
    ViewData["Title"] = "Delete Country";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-earth-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete country</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                <span class="tps-chip"><i class="ri-building-2-line"></i>@(Model.companyDTOs?.Count ?? 0) linked companies</span>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div><strong>All companies linked to this country will also be deleted.</strong></div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Country name</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div>
                    <dt>Linked companies</dt>
                    <dd>@if (Model.companyDTOs != null && Model.companyDTOs.Any())
                        {
                            <div class="tps-related">@foreach (var com in Model.companyDTOs) { <span class="tps-chip"><i class="ri-building-2-line"></i>@com.Name</span> }</div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No companies are linked to this country</span>
                        }</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="DeleteCountry" asp-route-id="@Model.Id">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetCountries">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this country?" data-confirm-text="The country and its linked companies are deleted. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete country</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
