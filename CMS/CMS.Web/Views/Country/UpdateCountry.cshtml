@model CMS.Application.DTOs.CountryDTO

@{
    ViewData["Title"] = "Edit Country";
}

<form asp-action="UpdateCountry" class="needs-validation" novalidate id="editCountryForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-earth-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Editing country</p>
                <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            </div>
        </div>
        <div class="tps-ihead__actions">
            <a class="btn btn-secondary" asp-action="ShowCompanies" asp-route-id="@Model.Id"><i class="ri-file-list-3-line me-1"></i> View details</a>
        </div>
    </div>

    <section class="card tps-fsection" aria-labelledby="sec-country">
        <div class="card-header">
            <span class="tps-fsection__icon"><i class="ri-earth-line"></i></span>
            <div>
                <h4 class="tps-fsection__title" id="sec-country">Country</h4>
                <p class="tps-fsection__desc">The country companies and positions are linked to.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="tps-fgrid">
                <div class="tps-field">
                    <label asp-for="Name" class="form-label">Country name <span class="tps-req">*</span></label>
                    <input asp-for="Name" class="form-control" id="Name" dir="auto" autocomplete="off" />
                    <div class="invalid-feedback">Enter the country name.</div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <span id="errorMessage" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetCountries">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save changes</button>
        </div>
    </div>
</form>

<script>
    $(document).ready(function () {
        $('#editCountryForm').on('submit', function (e) {
            var name = $('#Name').val().trim();
            if (!name) {
                $('#Name').addClass('is-invalid');
                e.preventDefault();
            } else {
                $('#Name').removeClass('is-invalid');
                $('#errorMessage').text('');
            }
        });
        $('#Name').on('input', function () {
            if (this.value.trim()) $(this).removeClass('is-invalid');
        });
    });
</script>
