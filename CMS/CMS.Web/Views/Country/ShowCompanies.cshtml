@model CMS.Application.DTOs.CountryDTO

@{
    ViewData["Title"] = "Country Details";
}

<style>
    .text-muted-custom {
        color: #6c757d;
        font-style: italic;
    }

    .details-card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header-custom {
        background-color: #405189;
        color: white;
        padding: 20px;
        border-bottom: 3px solid #ffffff;
    }

    .card-body-custom {
        padding: 20px;
    }

    dt {
        font-weight: bold;
        color: #333;
    }

    dd {
        margin-bottom: 1rem;
    }

    .text-muted {
        color: #6c757d;
    }

    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="card details-card">
    <div class="card-header card-header-custom">
        <h2 style="color:white;">Country Details</h2>
    </div>

    <div class="card-body card-body-custom">
        <dl class="row">
            <dt class="col-sm-2">Country Name:</dt>
            <dd class="col-sm-10">@Model.Name</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Companies Name:</dt>
            <dd class="col-sm-10">
                @if (Model.companyDTOs.Any())
                {
                    @foreach (var com in Model.companyDTOs)
                    {
                        @com.Name

                        @if (com != Model.companyDTOs.Last())
                        {
                            @(",  ")
                        }
                    }
                }
                else
                {
                    <p class="text-muted-custom">There are no companies connected to this country.</p>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="form-group text-center mt-3">
    <a asp-action="UpdateCountry" asp-route-id="@Model.Id" class="btn btn-success">Edit</a>
    <a class="btn btn-secondary" asp-action="GetCountries">Back to List</a>
</div>
