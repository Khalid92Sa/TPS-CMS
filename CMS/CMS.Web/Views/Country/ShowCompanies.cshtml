@model CMS.Application.DTOs.CountryDTO

@{
    ViewData["Title"] = "Country Details";
    var companies = Model.companyDTOs ?? new List<CMS.Application.DTOs.CompanyDTO>();
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-earth-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Country</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                <span class="tps-chip"><i class="ri-building-2-line"></i>@companies.Count @(companies.Count == 1 ? "company" : "companies")</span>
            </div>
        </div>
    </div>
    <div class="tps-ihead__actions">
        <a class="btn btn-secondary" asp-action="GetCountries"><i class="ri-arrow-left-line me-1"></i> Back to list</a>
        <a class="btn btn-primary" asp-action="UpdateCountry" asp-route-id="@Model.Id"><i class="ri-edit-line me-1"></i> Edit</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Details</h4>
    </div>
    <div class="card-body">
        <dl class="tps-dl">
            <div>
                <dt>Country name</dt>
                <dd dir="auto">@Model.Name</dd>
            </div>
            <div>
                <dt>Companies</dt>
                @if (companies.Any())
                {
                    <dd>
                        <div class="tps-related">
                            @foreach (var company in companies)
                            {
                                <a class="tps-chip text-decoration-none" asp-controller="Company" asp-action="Details" asp-route-id="@company.Id" dir="auto">
                                    <i class="ri-building-2-line"></i>@company.Name
                                </a>
                            }
                        </div>
                    </dd>
                }
                else
                {
                    <dd class="is-empty">No companies are linked to this country yet.</dd>
                }
            </div>
        </dl>
    </div>
</div>
