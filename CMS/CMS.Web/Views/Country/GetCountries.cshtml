<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

@model List<CMS.Application.DTOs.CountryDTO>
@{
    ViewData["Title"] = "Countries";
}

<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }
</style>

@using (Html.BeginForm("GetCountries", "Country", FormMethod.Get, new { id = "filterForm" }))
{
    <div class="form-group" style="margin-bottom: 23px;">
        <div class="row">
            <div class="col-md-3">
                @Html.Label("Filter by Country Name:")
                <input type="text" id="countryName" name="countryName" class="form-control" placeholder="Search by Country Name" value="@ViewBag.countryNameFilter">
            </div>
            <div class="col-md-1" style="margin-top: 27px;">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary btn-block" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Filter Countries">Filter</button>
            </div>
            <div class="col-md-1" style="margin-top: 27px;">
                <button type="button" id="resetButton" class="btn btn-secondary btn-block" title="Reset Filters">Reset</button>
            </div>
        </div>
    </div>
}


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <div>
                    <a asp-action="AddCountry" class="btn btn-primary">Add New Country</a>
                </div>
            </div>
            <div class="card-body">

                <table id="add-rows2" class="display nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Country Name</th>
                            <th>Number of Companies</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count(); i++)
                        {
                            var country = Model.ElementAt(i);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@country.Name</td>
                                <td>@country.companyDTOs.Count</td>
                                <td>
                                    <a class="bx bxs-edit-alt" style="font-size:x-large" asp-action="UpdateCountry" asp-route-id="@country.Id" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-original-title="Edit"></a> |
                                    <a class="bx bx-detail" style="font-size:x-large" asp-action="ShowCompanies" asp-route-id="@country.Id" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-original-title="Details"></a> |
                                    <a class="ri-delete-bin-2-line text-danger" style="font-size:x-large" href="@Url.Action("ConfirmDelete", new { id = country.Id })" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Delete"></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>
    </div><!--end col-->
</div><!--end row-->


<script>
    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this country?")) {
            window.location.href = "@Url.Action("DeleteCountry")/" + id;
        }
    }
</script>
<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        $('#add-rows2').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh'
        });

            $('#resetButton').on('click', function () {
                $('#countryName').val('');
                window.location.href = '@Url.Action("GetCountries", "Country")';
            });
        });
</script>
