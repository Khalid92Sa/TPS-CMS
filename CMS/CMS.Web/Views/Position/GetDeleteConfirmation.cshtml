@model CMS.Application.DTOs.PositionDTO

@{
    ViewData["Title"] = "Delete Position";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-briefcase-4-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete position</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                <span class="tps-chip"><i class="ri-file-text-line"></i>@(Model.EvaluationId != null ? "Has evaluation template" : "No evaluation template")</span>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>All associated child entities will also be deleted.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Position name</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div>
                    <dt>Evaluation template</dt>
                    <dd>@if (Model.EvaluationId != null)
                        {
                            <a asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.EvaluationId"><i class="ri-file-download-line me-1"></i>Download template</a>
                        }
                        else
                        {
                            <span class="text-muted fst-italic fw-normal">No evaluation template</span>
                        }</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" action="@Url.Action("DeletePosition", "Position", new { id = Model.Id })">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetPositions">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this position?" data-confirm-text="The position and its related data are deleted. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete position</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
