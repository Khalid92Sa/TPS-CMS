@model CMS.Application.DTOs.PositionDTO

@{
    ViewData["Title"] = "Add a Position";
}

<form asp-action="AddPosition" enctype="multipart/form-data" class="needs-validation" id="positionForm" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-briefcase-4-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Positions</p>
                <h2 class="tps-ihead__name">New position</h2>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5">
            <section class="card tps-fsection" aria-labelledby="sec-position">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-briefcase-4-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-position">Position</h4>
                        <p class="tps-fsection__desc">The level name used when scheduling interviews.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-field">
                        <label asp-for="Name" class="form-label">Position name <span class="tps-req">*</span></label>
                        <input asp-for="Name" class="form-control" id="Name" placeholder="e.g. Senior Developer" dir="auto" autocomplete="off" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <span id="errorMessage" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="card tps-fsection" aria-labelledby="sec-eval">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-file-upload-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-eval">Evaluation template <span class="text-muted fw-normal fs-13">(optional)</span></h4>
                        <p class="tps-fsection__desc">Interviewers download this form and upload it completed with their result. You can add it later.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-upload" id="fileUploadArea">
                        <input type="file" id="file" name="file" class="file-input-hidden" accept=".docx,.xlsx,.png,.jpg" aria-describedby="fileHint" />
                        <span class="tps-upload__icon"><i class="ri-upload-cloud-2-line"></i></span>
                        <div class="tps-upload__text"><strong>Click to choose a file</strong> or drag it here</div>
                        <div class="tps-upload__hint" id="fileHint">DOCX, XLSX, PNG or JPG · up to 10 MB</div>
                    </div>
                    <div id="filePreviewContainer" style="display: none;">
                        <div class="tps-file" id="filePreviewItem">
                            <span class="tps-file__icon"><i class="ri-file-3-line"></i></span>
                            <div>
                                <div class="tps-file__name" id="fileName"></div>
                                <div class="tps-file__meta" id="fileSize"></div>
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm tps-file__remove" id="removeFileBtn" title="Remove file">
                                <i class="ri-close-line"></i> Remove
                            </button>
                        </div>
                    </div>
                    <span id="fileError" class="text-danger d-block mt-2"></span>
                </div>
            </section>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="GetPositions">Cancel</a>
            <button type="submit" class="btn btn-primary px-4" id="submitButton"><i class="ri-add-line me-1"></i> Add position</button>
        </div>
    </div>
</form>

<script>
    $(document).ready(function () {
        const fileInput = $('#file');
        const fileUploadArea = $('#fileUploadArea');
        const filePreviewContainer = $('#filePreviewContainer');
        const fileName = $('#fileName');
        const fileSize = $('#fileSize');
        const removeFileBtn = $('#removeFileBtn');
        const fileError = $('#fileError');
        const allowedExtensions = /\.(docx|xlsx|png|jpg)$/i;
        const fileSizeLimit = 10 * 1024 * 1024; // 10MB

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // The template is optional; only an invalid file blocks saving
        function validateFile(file) {
            if (!file) return { valid: true };
            if (!allowedExtensions.exec(file.name)) return { valid: false, error: 'This file type isn\'t supported. Use DOCX, XLSX, PNG or JPG.' };
            if (file.size > fileSizeLimit) return { valid: false, error: 'This file is larger than 10 MB. Choose a smaller file.' };
            return { valid: true };
        }

        function showFilePreview(file) {
            const validation = validateFile(file);
            if (!validation.valid) {
                fileError.text(validation.error);
                fileUploadArea.removeClass('has-file').addClass('has-error');
                return;
            }
            fileName.text(file.name);
            fileSize.text(formatFileSize(file.size));
            filePreviewContainer.show();
            fileUploadArea.removeClass('has-error').addClass('has-file');
            fileError.text('');
        }

        function hideFilePreview() {
            filePreviewContainer.hide();
            fileInput.val('');
            fileUploadArea.removeClass('has-file has-error');
            fileError.text('');
        }

        fileInput.on('change', function (e) {
            const file = e.target.files[0];
            if (file) showFilePreview(file); else hideFilePreview();
        });

        removeFileBtn.on('click', function (e) {
            e.stopPropagation();
            hideFilePreview();
        });

        fileUploadArea.on('dragover', function (e) { e.preventDefault(); e.stopPropagation(); $(this).addClass('dragover'); });
        fileUploadArea.on('dragleave', function (e) { e.preventDefault(); e.stopPropagation(); $(this).removeClass('dragover'); });
        fileUploadArea.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(files[0]);
                fileInput[0].files = dataTransfer.files;
                showFilePreview(files[0]);
            }
        });

        $('#positionForm').on('submit', function (e) {
            var isValid = true;

            if (!$('#Name').val().trim()) {
                $('#Name').addClass('is-invalid');
                $('#errorMessage').text('Enter the position name.');
                isValid = false;
            } else {
                $('#Name').removeClass('is-invalid');
                $('#errorMessage').text('');
            }

            const file = fileInput[0].files[0];
            const validation = validateFile(file);
            if (!validation.valid) {
                fileError.text(validation.error);
                fileUploadArea.addClass('has-error');
                isValid = false;
            }

            if (!isValid) e.preventDefault();
        });

        $('#Name').on('input', function () {
            if (this.value.trim()) { $(this).removeClass('is-invalid'); $('#errorMessage').text(''); }
        });
    });
</script>
