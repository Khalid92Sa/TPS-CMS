@model CMS.Application.DTOs.PositionDTO

@{
    ViewData["Title"] = "Add a Position";
}
<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 style="color:white !important">Add a Position</h2>
        </div>
        <div class="card-body">
            <form asp-action="AddPosition" enctype="multipart/form-data" class="needs-validation" id="positionForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Position Name -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">
                            <span class="text-danger">*</span> Position Name
                        </label>
                        <input asp-for="Name" class="form-control" id="Name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <span id="errorMessage" class="text-danger"></span>
                    </div>
                </div>

                <!-- Upload Evaluation Form -->
                <div class="row">
                     <div class="col-md-6 mb-3">
                         <label for="file" class="form-label">Upload an Evaluation Form:</label>
                         <input type="file" id="file" name="file" class="form-control-file" onchange="validateFileFormat(this)" />
                         <br />
                         <div class="invalid-feedback">Only DOCX, XLSX, PNG, and JPG files are allowed.</div>
                         <span id="fileError" class="text-danger"></span>
                     </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4" id="submitButton">Add</button>
                    <a class="btn btn-secondary" asp-action="GetPositions">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<!-- Script to handle Position Name and File Validation -->
<script>
    $(document).ready(function () {
        // Form validation on submit
        $('#positionForm').on('submit', function (e) {
            var name = $('#Name').val();
            var fileInput = $('#file');
            var isValid = true;

            // Validate Position Name
            if (!name.trim()) {
                $('#Name').addClass('is-invalid'); // Add Bootstrap class for invalid input
                $('#errorMessage').text('Position Name is required.');
                isValid = false;
            } else {
                $('#Name').removeClass('is-invalid'); // Remove invalid class when input is valid
                $('#errorMessage').text('');
            }

            // Validate File Input
            var allowedExtensions = /\.(docx|xlsx|png|jpg)$/i; // Allowed file formats
            var fileVal = fileInput.val();
            if (fileVal && !allowedExtensions.exec(fileVal)) {
                $('#fileError').text('Only DOCX, XLSX, PNG, and JPG files are allowed.');
                isValid = false;
            } else {
                $('#fileError').text('');
            }

            // Prevent form submission if validation fails
            if (!isValid) {
                e.preventDefault();
            }
        });

        // Validate file format when user selects a file
        window.validateFileFormat = function (input) {
            var fileInput = $(input);
            var allowedExtensions = /\.(docx|xlsx|png|jpg)$/i; // Allowed file formats
            var fileVal = fileInput.val();

            if (fileVal && !allowedExtensions.exec(fileVal)) {
                $('#fileError').text('Only DOCX, XLSX, PNG, and JPG files are allowed.');
                fileInput.val('');
            } else {
                $('#fileError').text('');
            }
        };
    });
</script>

