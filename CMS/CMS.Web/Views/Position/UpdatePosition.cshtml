@model CMS.Application.DTOs.PositionDTO

@{
    ViewData["Title"] = "Edit Position";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-briefcase-4-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Editing position</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">
                <span class="tps-chip"><i class="ri-file-text-line"></i>@(Model.EvaluationId != null ? "Evaluation template on file" : "No evaluation template")</span>
            </div>
        </div>
    </div>
    <div class="tps-ihead__actions">
        <a class="btn btn-secondary" asp-action="GetPositions"><i class="ri-arrow-left-line me-1"></i> Back to list</a>
    </div>
</div>

<div class="row">
    @* ---------- Name ---------- *@
    <div class="col-lg-5">
        <form asp-action="UpdatePosition" id="positionForm" class="card tps-fsection needs-validation" novalidate aria-labelledby="sec-position">
            <div class="card-header">
                <span class="tps-fsection__icon"><i class="ri-briefcase-4-line"></i></span>
                <div>
                    <h4 class="tps-fsection__title" id="sec-position">Position</h4>
                    <p class="tps-fsection__desc">The level name used when scheduling interviews.</p>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input asp-for="EvaluationId" type="hidden" />
                <div class="tps-field">
                    <label asp-for="Name" class="form-label">Position name <span class="tps-req">*</span></label>
                    <input asp-for="Name" class="form-control" id="positionName" dir="auto" autocomplete="off" required />
                    <div class="invalid-feedback">Enter the position name.</div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save name</button>
            </div>
        </form>
    </div>

    @* ---------- Evaluation template ---------- *@
    <div class="col-lg-7">
        <form asp-action="UpdateAttachment" asp-route-id="@Model.Id" enctype="multipart/form-data" id="uploadForm" class="card tps-fsection" aria-labelledby="sec-eval">
            <div class="card-header">
                <span class="tps-fsection__icon"><i class="ri-file-upload-line"></i></span>
                <div>
                    <h4 class="tps-fsection__title" id="sec-eval">Evaluation template</h4>
                    <p class="tps-fsection__desc">Interviewers download this form and upload it completed with their result.</p>
                </div>
            </div>
            <div class="card-body">
                @if (Model.EvaluationId != null)
                {
                    <div class="tps-callout tps-callout--success">
                        <i class="ri-checkbox-circle-line"></i>
                        <div>
                            <div class="tps-callout__title">Current template on file</div>
                            <p class="tps-callout__text">Uploading a new file replaces it.</p>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Attachments" asp-action="Download" asp-route-id="@Model.EvaluationId">
                                <i class="ri-file-download-line me-1"></i> Download current template
                            </a>
                        </div>
                    </div>
                }

                <label class="form-label" for="file">New template</label>
                <div class="tps-upload" id="fileUploadArea">
                    <input type="file" id="file" name="file" class="file-input-hidden" accept=".pdf,.docx,.xlsx,.png,.jpg" aria-describedby="fileHint" />
                    <span class="tps-upload__icon"><i class="ri-upload-cloud-2-line"></i></span>
                    <div class="tps-upload__text"><strong>Click to choose a file</strong> or drag it here</div>
                    <div class="tps-upload__hint" id="fileHint">PDF, DOCX, XLSX, PNG or JPG · up to 4 MB</div>
                </div>
                <div id="filePreviewContainer" style="display: none;">
                    <div class="tps-file" id="filePreviewItem">
                        <span class="tps-file__icon"><i class="ri-file-3-line"></i></span>
                        <div>
                            <div class="tps-file__name" id="fileName"></div>
                            <div class="tps-file__meta" id="fileSize"></div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm tps-file__remove" id="removeFileBtn" title="Remove file">
                            <i class="ri-close-line"></i> Remove
                        </button>
                    </div>
                </div>
                <span id="fileError" class="text-danger d-block mt-2"></span>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-4" id="uploadButton" disabled><i class="ri-upload-2-line me-1"></i> Upload template</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Position name: browser validation with Bootstrap styles
        var form = document.getElementById('positionForm');
        var positionNameInput = document.getElementById('positionName');

        form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });

        positionNameInput.addEventListener('input', function () {
            if (positionNameInput.value.trim() === '') {
                positionNameInput.setCustomValidity('Position Name is required.');
                positionNameInput.classList.add('is-invalid');
            } else {
                positionNameInput.setCustomValidity('');
                positionNameInput.classList.remove('is-invalid');
            }
        });
    });

    // Evaluation template upload
    $(document).ready(function () {
        const fileInput = $('#file');
        const fileUploadArea = $('#fileUploadArea');
        const filePreviewContainer = $('#filePreviewContainer');
        const fileName = $('#fileName');
        const fileSize = $('#fileSize');
        const removeFileBtn = $('#removeFileBtn');
        const fileError = $('#fileError');
        const uploadButton = $('#uploadButton');
        const allowedExtensions = [".pdf", ".docx", ".png", ".jpg", ".xlsx"];
        const fileSizeLimit = 4 * 1024 * 1024; // 4MB

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function validateFile(file) {
            if (!file) {
                fileError.text('Choose a file to upload.');
                uploadButton.prop('disabled', true);
                return false;
            }
            const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
            if (!allowedExtensions.includes(fileExtension)) {
                fileError.text('This file type isn\'t supported. Use PDF, DOCX, XLSX, PNG or JPG.');
                uploadButton.prop('disabled', true);
                return false;
            } else if (file.size > fileSizeLimit) {
                fileError.text('This file is larger than 4 MB. Choose a smaller file.');
                uploadButton.prop('disabled', true);
                return false;
            }
            fileError.text('');
            uploadButton.prop('disabled', false);
            return true;
        }

        function showFilePreview(file) {
            if (validateFile(file)) {
                fileName.text(file.name);
                fileSize.text(formatFileSize(file.size));
                filePreviewContainer.show();
                fileUploadArea.removeClass('has-error').addClass('has-file');
            } else {
                fileUploadArea.removeClass('has-file').addClass('has-error');
            }
        }

        function hideFilePreview() {
            filePreviewContainer.hide();
            fileInput.val('');
            fileUploadArea.removeClass('has-file has-error');
            fileError.text('');
            uploadButton.prop('disabled', true);
        }

        fileInput.on('change', function (e) {
            const file = e.target.files[0];
            if (file) showFilePreview(file); else hideFilePreview();
        });

        removeFileBtn.on('click', function (e) {
            e.stopPropagation();
            hideFilePreview();
        });

        fileUploadArea.on('dragover', function (e) { e.preventDefault(); e.stopPropagation(); $(this).addClass('dragover'); });
        fileUploadArea.on('dragleave', function (e) { e.preventDefault(); e.stopPropagation(); $(this).removeClass('dragover'); });
        fileUploadArea.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(files[0]);
                fileInput[0].files = dataTransfer.files;
                showFilePreview(files[0]);
            }
        });

        $('#uploadForm').on('submit', function (e) {
            const file = fileInput[0].files[0];
            if (!file || !validateFile(file)) {
                e.preventDefault();
                if (!file) fileError.text('Choose a file to upload.');
                fileUploadArea.addClass('has-error');
                return false;
            }
            fileUploadArea.removeClass('has-error');
        });
    });
</script>
