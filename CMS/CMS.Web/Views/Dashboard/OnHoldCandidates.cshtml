@model List<CMS.Application.DTOs.CandidateDTO>
@{
    ViewData["Title"] = "On Hold Candidates";
    var candidateName = ViewData["candidateName"] as string;
    var selectedTrack = ViewData["selectedTrack"] as int?;
    var companyName = ViewData["companyName"] as string;
}

<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }

    #onHoldCandidateId_wrapper {
        padding: 20px;
    }


    #onHoldCandidateId_filter {
        display: none;
    }

    .btn-back {
        margin-top: 20px;
    }

</style>

<form asp-action="OnHoldCandidates" asp-controller="Dashboard" method="get">
    <div class="form-group" style="margin-bottom: 23px;">
        <div class="row">
            <div class="col-md-3">
                @Html.Label("Filter by Candidate Name:")
                <input type="text" id="candidateName" name="candidateName" class="form-control" placeholder="Enter candidate name" value="@Html.Raw(candidateName)">
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Company:")
                @Html.DropDownList("companyFilter", ViewBag.CompanyList as SelectList, "Select a Company", new { @class = "form-control" })
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Track:")
                @Html.DropDownList("trackFilter", ViewBag.TrackList as SelectList, "All Tracks", new { @class = "form-control", @value = selectedTrack })
            </div>

            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary mt-4 w-50 me-2" title="Filter Candidates">
                    Filter
                </button>
                <button type="button" id="resetButton" class="btn btn-secondary mt-4 w-50" title="Reset Filters">
                    Reset
                </button>
            </div>
        </div>
    </div>
</form>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <table id="onHoldCandidateId" class="table table-nowrap dt-responsive table-bordered display tps-candidate-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Candidate Name</th>
                            <th>Experience</th>
                            <th>Level</th>
                            <th>Track</th>
                            <th>Company Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var candidate = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@candidate.Name</td>
                                <td>@candidate.Experience</td>
                                <td>@candidate.PositionName</td>
                                <td>@candidate.TrackName</td>
                                <td>@candidate.CompanyName</td>
                                @if (candidate.Status == "HOLD")
                                {
                                    <td>@InterviewStatusUi.Badge(candidate.Status)</td>
                                }
                            </tr>
                        }
                    </tbody>
                  
                </table>

                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>

        <div class="text-center" style="width: 80%;float:right;">
            <a style="margin-right:27%;" class="btn btn-secondary btn-back" asp-action="Index" asp-controller="Dashboard">Back to Dashboard</a>
        </div>



    </div><!--end col-->
</div><!--end row-->

<script>
    $(document).ready(function () {
        $('#onHoldCandidateId').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',  // Ensures proper height management
            scrollX: true,
            autoWidth: true,
            columnDefs: [
                { targets: 'hidden', visible: false }
            ],
            initComplete: function () {
                this.api().columns.adjust();
            }
        });

           $('#resetButton').on('click', function () {
            $('#candidateName').val('');
            $('#companyFilter').val('');
            $('#trackFilter').val('');
            window.location.href = '@Url.Action("OnHoldCandidates", "Dashboard")';
        });
    });
</script>
