@model List<CMS.Application.DTOs.CandidateDTO>
@{
    ViewData["Title"] = "On Hold Candidates";
    var candidateName = ViewData["candidateName"] as string;
    var selectedTrack = ViewData["selectedTrack"] as int?;
    var companyName = ViewData["companyName"] as string;
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }

    #onHoldCandidateId_wrapper {
        padding: 20px;
    }

    #onHoldCandidateId th,
    #onHoldCandidateId td {
        text-align: center;
    }

    #onHoldCandidateId_filter {
        display: none;
    }

    .btn-back {
        margin-top: 20px;
    }

</style>

<form asp-action="OnHoldCandidates" asp-controller="Dashboard" method="get">
    <div class="form-group" style="margin-bottom: 23px;">
        <div class="row">
            <div class="col-md-3">
                @Html.Label("Filter by Candidate Name:")
                <input type="text" id="candidateName" name="candidateName" class="form-control" placeholder="Enter candidate name" value="@Html.Raw(candidateName)">
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Company:")
                @Html.DropDownList("companyFilter", ViewBag.CompanyList as SelectList, "Select a Company", new { @class = "form-control" })
            </div>

            <div class="col-md-3">
                @Html.Label("Filter by Track:")
                @Html.DropDownList("trackFilter", ViewBag.TrackList as SelectList, "All Tracks", new { @class = "form-control", @value = selectedTrack })
            </div>

            <div class="col-md-1" style="margin-top: 27px;">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary btn-block" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-original-title="Filter Candidates">Filter</button>
            </div>
            <div class="col-md-1" style="margin-top: 27px;">
                <button type="button" id="resetButton" class="btn btn-secondary btn-block" title="Reset Filters">Reset</button>
            </div>
        </div>
    </div>
</form>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <table id="onHoldCandidateId" class="table table-nowrap dt-responsive table-bordered display" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Candidate Name</th>
                            <th>Experience</th>
                            <th>Level</th>
                            <th>Track</th>
                            <th>Company Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var candidate = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@candidate.Name</td>
                                <td>@candidate.Experience</td>
                                <td>@candidate.PositionName</td>
                                <td>@candidate.TrackName</td>
                                <td>@candidate.CompanyName</td>
                                @if (candidate.Status == "HOLD")
                                {
                                    <td style="color:#2196F3">@candidate.Status</td>
                                }
                            </tr>
                        }
                    </tbody>
                  
                </table>

                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>

        <div class="text-center" style="width: 80%;float:right;">
            <a style="margin-right:27%;" class="btn btn-secondary btn-back" asp-action="Index" asp-controller="Dashboard">Back to Dashboard</a>
        </div>


        <div class="card mt-3" style="width: 20%; background-color: aliceblue;">
            <div class="card-header">
                <h5 class="card-title">Status Indicators</h5>
            </div>
            <div class="card-body">
                <div class="text-right">
                    <span class="badge badge-success" style="color: green; background-color: transparent;">APR: Approved</span>
                    <span class="badge badge-danger" style="color: #F44336; background-color: transparent;">REJ: Rejected</span>
                </div>
                <div class="text-right mt-2">
                    <span class="badge badge-warning" style="color: #cec03d; background-color: transparent;">PND: Pending</span>
                    <span class="badge badge-info" style="color: #2196F3; background-color: transparent;">Hold: On Hold</span>
                </div>
            </div>
        </div>




    </div><!--end col-->
</div><!--end row-->

<script>
    $(document).ready(function () {
        $('#onHoldCandidateId').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',  // Ensures proper height management
            scrollX: true,     // Enables horizontal scrolling to prevent misalignment
            autoWidth: false,  // Prevents columns from being resized incorrectly
            fixedHeader: true, // Keeps column headers aligned correctly
            columnDefs: [
                { targets: 'hidden', visible: false } // Ensures hidden columns remain hidden
            ]
        });

           $('#resetButton').on('click', function () {
            $('#candidateName').val('');
            $('#companyFilter').val('');
            $('#trackFilter').val('');
            window.location.href = '@Url.Action("OnHoldCandidates", "Dashboard")';
        });
    });
</script>
