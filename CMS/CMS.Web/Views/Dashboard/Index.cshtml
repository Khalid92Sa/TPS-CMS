@model CMS.Application.DTOs.PerformanceReportDTO
@{
    ViewData["Title"] = "Dashboard";
    ViewData["additionalJS"] = new[]
    {
        "/theme/libs/apexcharts/apexcharts.min.js",
        "/dashboard-js/jobx.js",
        "/dashboard-js/rejected-chart.js",
        "/dashboard-js/pending-chart.js",
        "/dashboard-js/onHold-chart.js",
        "/dashboard-js/stoppedCycles-chart.js",
        "/theme/libs/jsvectormap/js/jsvectormap.min.js",
        "/theme/libs/jsvectormap/maps/world-merc.js",
        "/dashboard-js/countries-hash.js",
        "/dashboard-js/candidate-sources-map.js"
    };
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>

<!-- Pipeline summary -->
<div class="tps-kpi-grid">
    <div class="tps-kpi tps-kpi--total">
        <div>
            <p class="tps-kpi__label">Candidates</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfCandidates">@Model.NumberOfCandidates</span></p>
            <span class="tps-kpi__hint">In the pipeline</span>
        </div>
        <span class="tps-kpi__icon"><i class="ri-user-star-line"></i></span>
    </div>

    <a asp-action="AcceptedCandidates" class="tps-kpi tps-kpi--accepted">
        <div>
            <p class="tps-kpi__label">Accepted</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfAccepted">0</span></p>
            <span class="tps-kpi__hint">View list <i class="ri-arrow-right-s-line"></i></span>
        </div>
        <div class="tps-kpi__chart" id="accepted-chart" data-percent="@ViewBag.AcceptedPercentage"></div>
    </a>

    <a asp-action="PendingCandidates" class="tps-kpi tps-kpi--pending">
        <div>
            <p class="tps-kpi__label">Pending</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfPending">0</span></p>
            <span class="tps-kpi__hint">View list <i class="ri-arrow-right-s-line"></i></span>
        </div>
        <div class="tps-kpi__chart" id="pending-chart" data-percent="@ViewBag.PendingPercentage"></div>
    </a>

    <a asp-action="RejectedCandidates" class="tps-kpi tps-kpi--rejected">
        <div>
            <p class="tps-kpi__label">Rejected</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfRejected">0</span></p>
            <span class="tps-kpi__hint">View list <i class="ri-arrow-right-s-line"></i></span>
        </div>
        <div class="tps-kpi__chart" id="rejected-chart" data-percent="@ViewBag.RejectedPercentage"></div>
    </a>

    <a asp-action="OnHoldCandidates" class="tps-kpi tps-kpi--hold">
        <div>
            <p class="tps-kpi__label">On hold</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfOnHold">0</span></p>
            <span class="tps-kpi__hint">View list <i class="ri-arrow-right-s-line"></i></span>
        </div>
        <div class="tps-kpi__chart" id="onhold-chart" data-percent="@ViewBag.OnHoldPercentage"></div>
    </a>

    <a asp-action="StoppedCyclesCandidates" class="tps-kpi tps-kpi--stopped">
        <div>
            <p class="tps-kpi__label">Stopped cycles</p>
            <p class="tps-kpi__value"><span class="counter-value" data-target="@Model.NumberOfStoppedCycles">0</span></p>
            <span class="tps-kpi__hint">View list <i class="ri-arrow-right-s-line"></i></span>
        </div>
        <div class="tps-kpi__chart" id="stoppedCycles-chart" data-percent="@ViewBag.StoppedCycles"></div>
    </a>
</div>

<div class="row">
    <!-- Job views by location -->
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header">
                <div class="tps-section-title">
                    <div>
                        <h4 class="card-title">Job views by location</h4>
                        <p>Countries where candidates viewed open positions</p>
                    </div>
                    <i class="ri-earth-line fs-20 text-muted"></i>
                </div>
            </div>
            <div class="card-body">
                <div id="candidate-sources-map" data-locations="@ViewBag.CountriesList"></div>
            </div>
        </div>
    </div>

    <!-- Pipeline by country and position -->
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header">
                <div class="tps-section-title">
                    <div>
                        <h4 class="card-title">Pipeline by country</h4>
                        <p>Open a country, then a position, to see its candidates</p>
                    </div>
                    <i class="ri-node-tree fs-20 text-muted"></i>
                </div>
            </div>
            <div class="card-body pt-1">
                <div class="accordion accordion-flush tps-tree" id="countryAccordion">
                    @{
                        int i = 1;
                    }
                    @foreach (var country in ViewBag.TreeData)
                    {
                        @if (country.Positions != null && country.Positions.Count > 0)
                        {
                            int candidateCount = 0;
                            foreach (var p in country.Positions) { candidateCount += p.Candidates.Count; }

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="countryheading-@i">
                                    <button class="accordion-button collapsed d-flex align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#countrycollapse-@i" aria-expanded="false" aria-controls="countrycollapse-@i">
                                        <i class="ri-map-pin-2-line text-primary"></i> @country.Name
                                        <span class="tps-count">@country.Positions.Count positions · @candidateCount candidates</span>
                                    </button>
                                </h2>
                                <div id="countrycollapse-@i" class="accordion-collapse collapse" data-bs-parent="#countryAccordion">
                                    <div class="accordion-body">
                                        <ul class="list-group list-group-flush">
                                            @{
                                                int j = 1;
                                            }
                                            @foreach (var position in country.Positions)
                                            {
                                                <li class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                                        <button class="btn btn-link p-0 text-start d-flex align-items-center gap-2" data-bs-toggle="collapse" data-bs-target="#positioncollapse-@i-@j" aria-expanded="false">
                                                            <i class="ri-briefcase-4-line text-muted"></i> @position.Name
                                                        </button>
                                                        <span class="badge bg-primary">@position.Candidates.Count candidates</span>
                                                    </div>
                                                    <div id="positioncollapse-@i-@j" class="collapse mt-2">
                                                        <ul class="list-group">
                                                            @foreach (var candidate in position.Candidates)
                                                            {
                                                                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                                    <span class="d-flex align-items-center gap-2">
                                                                        <i class="ri-user-line text-muted"></i> @candidate.Name
                                                                    </span>
                                                                    <span class="d-flex flex-wrap align-items-center gap-1">
                                                                        @InterviewStatusUi.Badge(candidate.Status)
                                                                        <span class="text-muted fs-12">
                                                                            @(candidate.Status == "Pending" ? "for" : "by") @candidate.InterviewerName
                                                                        </span>
                                                                    </span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </li>
                                                j++;
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            i++;
                        }
                    }
                    @if (i == 1)
                    {
                        <p class="text-muted text-center py-4 mb-0">No candidates are assigned to positions yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
