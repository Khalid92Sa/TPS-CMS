@model CMS.Application.DTOs.PerformanceReportDTO
@{
    ViewData["Title"] = "Dashboard";
    ViewData["additionalJS"] = new[]
    {
        "/theme/libs/apexcharts/apexcharts.min.js",
        "/dashboard-js/jobx.js",
        "/dashboard-js/rejected-chart.js",
        "/dashboard-js/pending-chart.js",
        "/dashboard-js/onHold-chart.js",
        "/dashboard-js/stoppedCycles-chart.js",
        "/theme/libs/jsvectormap/js/jsvectormap.min.js",
        "/theme/libs/jsvectormap/maps/world-merc.js",
        "/dashboard-js/countries-hash.js",
        "/dashboard-js/candidate-sources-map.js"
    };
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

<div class="row">
    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="fw-medium text-muted mb-0">Candidates</p>
                        <h2 class="mt-4 ff-secondary fw-semibold">
                            <span class="counter-value" data-target="@Model.NumberOfCandidates">@Model.NumberOfCandidates</span>
                        </h2>
                    </div>
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-info-subtle rounded-circle fs-2">
                            <i class="ri-user-star-fill" style="color:#36a2dd;"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <a asp-action="AcceptedCandidates">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase fw-medium text-muted mb-0">Accepted</p>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-0">
                                <span class="counter-value" data-target="@Model.NumberOfAccepted">0</span>
                            </h4>
                        </div>
                        <div id="accepted-chart" data-percent="@ViewBag.AcceptedPercentage"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <a asp-action="PendingCandidates">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase fw-medium text-muted mb-0">Pending</p>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-0">
                                <span class="counter-value" data-target="@Model.NumberOfPending">0</span>
                            </h4>
                        </div>
                        <div id="pending-chart" data-percent="@ViewBag.PendingPercentage"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <a asp-action="RejectedCandidates">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase fw-medium text-muted mb-0">Rejected</p>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-0">
                                <span class="counter-value" data-target="@Model.NumberOfRejected">0</span>
                            </h4>
                        </div>
                        <div id="rejected-chart" data-percent="@ViewBag.RejectedPercentage"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <a asp-action="OnHoldCandidates">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase fw-medium text-muted mb-0">On Hold</p>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-0">
                                <span class="counter-value" data-target="@Model.NumberOfOnHold">0</span>
                            </h4>
                        </div>
                        <div id="onhold-chart" data-percent="@ViewBag.OnHoldPercentage"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <a asp-action="StoppedCyclesCandidates">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase fw-medium text-muted mb-0">Stopped Cycles</p>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-0">
                                <span class="counter-value" data-target="@Model.NumberOfStoppedCycles">0</span>
                            </h4>
                        </div>
                        <div id="stoppedCycles-chart" data-percent="@ViewBag.StoppedCycles"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>

</div>


<!-- Jobs Views Location Map -->
<div class="row">
    <div class="col-md-12">
        <div class="card card-animate">
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <h4 class="card-title mb-0">Jobs Views Location</h4>
                <div style="background-color:#dfe1e2;" id="candidate-sources-map" data-locations="@ViewBag.CountriesList"></div>
            </div>
        </div>
    </div>
</div>

<!--Tree Chart -->
<div class="row">
    <div class="col-md-12">
        <div class="card card-animate">
            <div class="card-header">
                <h4 class="card-title mb-0">Tree Chart</h4>
            </div>
            <div class="card-body" data-aos="fade-up" data-aos-duration="600">
                <div class="accordion accordion-flush" id="countryAccordion">
                    @{
                        int i = 1;
                    }
                    @foreach (var country in ViewBag.TreeData)
                    {
                        @if (country.Positions != null && country.Positions.Count > 0)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="countryheading-@i">
                                    <button class="accordion-button collapsed d-flex align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#countrycollapse-@i">
                                        <i class="ri-earth-line me-2 text-primary"></i> @country.Name
                                    </button>
                                </h2>
                                <div id="countrycollapse-@i" class="accordion-collapse collapse" data-bs-parent="#countryAccordion">
                                    <div class="accordion-body">
                                        <ul class="list-group list-group-flush">
                                            @{
                                                int j = 1;
                                            }
                                            @foreach (var position in country.Positions)
                                            {
                                                <li class="list-group-item">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <i class="ri-briefcase-line me-2 text-info"></i>
                                                            <button class="btn btn-link p-0" data-bs-toggle="collapse" data-bs-target="#positioncollapse-@i-@j">
                                                                @position.Name
                                                            </button>
                                                        </div>
                                                        <span class="badge bg-primary">@position.Candidates.Count candidates</span>
                                                    </div>
                                                    <div id="positioncollapse-@i-@j" class="collapse mt-2">
                                                        <ul class="list-group">
                                                            @{
                                                                int k = 1;
                                                            }
                                                            @foreach (var candidate in position.Candidates)
                                                            {
                                                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                    <div>
                                                                        <i class="ri-user-line me-2 text-success"></i> @candidate.Name
                                                                    </div>
                                                                    <div>
                                                                        <span class="badge bg-success">@candidate.Status</span>
                                                                        <span class="badge bg-info">
                                                                            @(candidate.Status == "Pending" ? "for" : "by") @candidate.InterviewerName
                                                                        </span>
                                                                    </div>
                                                                </li>
                                                                k++;
                                                            }
                                                        </ul>
                                                    </div>
                                                </li>
                                                j++;
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            i++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AOS Init Script -->
<script>
    AOS.init();
</script>

