@model IEnumerable<CMS.Application.DTOs.NotificationsDTO>

@{
    ViewData["Title"] = "Notifications";
    ViewData["MarkAllId"] = "markAllAsReadButton";
    ViewData["ServerUnread"] = true;
    ViewData["ServerRead"] = false;
}

@await Html.PartialAsync("_NotificationsPage", Model)

<script>
    $(document).ready(function () {
        $("#read-tab").click(function () {
            TPSNotices.loading('#read-notifications-content');
            $.ajax({
                url: '@Url.Action("IndexInterviewerForAllNotification", "notifications")',
                type: 'GET',
                success: function (response) {
                    TPSNotices.render('#read-notifications-content', (response || []).reverse(), { read: true });
                },
                error: function () {
                    Swal.fire({
                        title: "Couldn't load notifications",
                        text: 'Refresh the page to try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });

        // "Mark all as read"
        $("#markAllAsReadButton").click(function () {
            var button = $(this).prop('disabled', true);
            $.ajax({
                url: '@Url.Action("MarkAll", "notifications")',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'All caught up',
                            text: 'All notifications are marked as read.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: "Couldn't mark notifications as read",
                            text: response.message || 'Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error marking all as read: " + error);
                    Swal.fire({
                        title: "Couldn't mark notifications as read",
                        text: 'Check your connection and try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                },
                complete: function () { button.prop('disabled', false); }
            });
        });
    });
</script>
