@model IEnumerable<CMS.Application.DTOs.NotificationsDTO>

@{
    ViewData["Title"] = "Notifications";
}

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background: #f0f2f5;
        margin: 0;
        padding: 0;
    }

    .container {
        margin: 20px auto;
        max-width: 1200px;
    }

    .card {
        background: #ffffff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
    }

    /* Tabs Styling */
    /* Tabs Styling */
    .nav-tabs-notification {
        display: flex;
        border: none;
        margin-bottom: 20px;
        justify-content: center;
    }

        .nav-tabs-notification .nav-link-tabs {
            padding: 12px 25px;
            font-size: 16px;
            font-weight: bold;
            color: #495057;
            border: none;
            border-radius: 50px;
            background: #e9ecef;
            margin: 0 5px;
            transition: all 0.3s ease-in-out;
        }

            .nav-tabs-notification .nav-link-tabs.active {
                background: linear-gradient(to right, #6a11cb, #2575fc);
                color: #ffffff;
                box-shadow: 0px 4px 10px rgba(106, 17, 203, 0.4);
            }

            .nav-tabs-notification .nav-link-tabs:hover {
                background: #dfe4ea;
            }

    /* Notification Section */
    .notifications-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        padding-top: 10px;
    }

    .notification-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 15px;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
    }

    .notification-card:hover {
        transform: scale(1.02);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
    }

    .notification-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 8px;
        color: #333333;
        line-height: 1.4;
    }

    .notification-title a {
        text-decoration: none;
        color: inherit;
        transition: color 0.3s;
    }

    .notification-title a:hover {
        color: #6a11cb;
    }

    .notification-date {
        font-size: 14px;
        color: #888888;
        margin-top: 5px;
    }

    .empty-state {
        text-align: center;
        color: #adb5bd;
        font-size: 18px;
        margin-top: 50px;
        font-weight: 500;
    }
    /* Buttons */
    .btn-primary {
        background: linear-gradient(to right, #6a11cb, #2575fc);
        border: none;
        padding: 10px 25px;
        font-size: 14px;
        font-weight: bold;
        color: white;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background: linear-gradient(to right, #5a0fb5, #1b64e3);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }
</style>

<div class="container">
    <div class="card">
        <!-- Tabs -->
        <ul class="nav nav-tabs-notification" id="myTab" role="tablist">
            <li class="nav-item">
                <button class="nav-link-tabs active" id="unread-tab" data-bs-toggle="tab" data-bs-target="#unread" type="button" role="tab" aria-controls="unread" aria-selected="true">
                    Unread Notifications
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link-tabs" id="read-tab" data-bs-toggle="tab" data-bs-target="#read" type="button" role="tab" aria-controls="read" aria-selected="false">
                    Read Notifications
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Unread Notifications -->
            <div class="tab-pane fade show active" id="unread" role="tabpanel" aria-labelledby="unread-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Unread Notifications</h5>
                    <button id="markAllAsReadButton" class="btn-primary">Mark All as Read</button>
                </div>
                <div class="notifications-section">
                    @if (!Model.Any(n => !n.IsRead))
                    {
                        <div class="empty-state">No unread notifications found.</div>
                    }
                    else
                    {
                        @foreach (var notification in Model.Where(n => !n.IsRead).Reverse())
                        {
                            <div class="notification-card" onclick="location.href='@Url.Action("Details", "Notifications", new { id = notification.NotificationsId })'">
                                <div class="notification-title" style="font-weight: bold; color: black;">
                                    @Html.Raw(notification.Title)
                                </div>
                                <div class="notification-date">@notification.SendDate</div>
                            </div>

                        }
                    }
                </div>
            </div>

            <!-- Read Notifications -->
            <div class="tab-pane fade" id="read" role="tabpanel" aria-labelledby="read-tab">
                <div id="read-notifications-content" class="notifications-section">
                    <!-- Populated dynamically using AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<!-- SweetAlert2 CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10">

<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script>
    $(document).ready(function () {
        $("#read-tab").click(function () {
            $.ajax({
                url: '@Url.Action("IndexInterviewerForAllNotification", "notifications")',
                type: 'GET',
                success: function (response) {
                    let readNotificationsHtml = "";
                    $('#read-notifications-content').html("");

                    if (response.length === 0) {
                        readNotificationsHtml = '<div class="empty-state">No read notifications found.</div>';
                    } else {
                        response.reverse();
                        response.forEach(notification => {
                            const sendDate = new Date(notification.sendDate);
                            const formattedDate = sendDate.toLocaleDateString();
                            const formattedTime = sendDate.toLocaleTimeString();

                            readNotificationsHtml += `
                                <div class="notification-card" onclick="location.href='/Notifications/Details/${notification.notificationsId}'" style="cursor: pointer;">
                                    <div class="notification-title" style="color: blue;">
                                        ${notification.title}
                                    </div>
                                    <div class="notification-date">${formattedDate} ${formattedTime}</div>
                                </div>`;

                        });
                    }

                    $('#read-notifications-content').html(readNotificationsHtml);
                },
                error: function () {
                    Swal.fire({
                        title: 'Error!',
                        text: 'Failed to load read notifications.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });

        // Handle "Mark All as Read" button click
           $("#markAllAsReadButton").click(function () {
        $.ajax({
            url: '@Url.Action("MarkAll", "notifications")',
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: 'All notifications have been marked as read.',
                        icon: 'success',
                        confirmButtonText: 'OK',
                    }).then(() => {
                        location.reload(); // Refresh the page after user clicks OK
                    });
                } else {
                    Swal.fire({
                        title: 'Error!',
                        text: response.message || 'Failed to mark all notifications as read.',
                        icon: 'error',
                        confirmButtonText: 'OK',
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error("Error marking all as read: " + error);
                Swal.fire({
                    title: 'Error!',
                    text: 'An error occurred while marking notifications as read.',
                    icon: 'error',
                    confirmButtonText: 'OK',
                });
            }
        });
    });

        function loadUnreadNotifications() {
            $.ajax({
                url: '@Url.Action("UnRead", "notifications")',
                type: 'GET',
                success: function (response) {
                    var unreadNotificationsHtml = "";

                    if (response.length === 0) {
                        unreadNotificationsHtml = '<div class="empty-state">No unread notifications found.</div>';
                    } else {
                        response.forEach(notification => {
                            unreadNotificationsHtml += `
                                <div class="notification-card" onclick="location.href='/Notifications/Details/${notification.notificationsId}'">
                                    <div class="notification-title">${notification.title}</div>
                                    <div class="notification-date">${new Date(notification.sendDate).toLocaleDateString()} ${new Date(notification.sendDate).toLocaleTimeString()}</div>
                                </div>`;
                        });
                    }

                    $("#unread-notifications-content").html(unreadNotificationsHtml);
                },
                error: function (xhr, status, error) {
                    console.error("Error loading unread notifications: " + error);
                }
            });
        }

        function loadReadNotifications() {
            $.ajax({
                url: '@Url.Action("Read", "notifications")',
                type: 'GET',
                success: function (response) {
                    var readNotificationsHtml = "";

                    if (response.length === 0) {
                        readNotificationsHtml = '<div class="empty-state">No read notifications found.</div>';
                    } else {
                        response.forEach(notification => {
                            readNotificationsHtml += `
                                <div class="notification-card" onclick="location.href='/Notifications/Details/${notification.notificationsId}'">
                                    <div class="notification-title" style="color: blue;">${notification.title}</div>
                                    <div class="notification-date">${new Date(notification.sendDate).toLocaleDateString()} ${new Date(notification.sendDate).toLocaleTimeString()}</div>
                                </div>`;
                        });
                    }

                    $("#read-notifications-content").html(readNotificationsHtml);
                },
                error: function (xhr, status, error) {
                    console.error("Error loading read notifications: " + error);
                }
            });
        }
    });
</script>
