@model IEnumerable<CMS.Application.DTOs.NotificationsDTO>

@{
    ViewData["Title"] = "Notifications";
    ViewData["MarkAllId"] = "readAllButton";
    ViewData["ServerUnread"] = false;
    ViewData["ServerRead"] = false;
}

@await Html.PartialAsync("_NotificationsPage", Model)

<script>
    $(document).ready(function () {
        loadUnreadNotifications();

        // "Mark all as read"
        $("#readAllButton").click(function () {
            var button = $(this).prop('disabled', true);
            $.ajax({
                url: '@Url.Action("MarkAll", "notifications")',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'All caught up',
                            text: 'All notifications are marked as read.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: "Couldn't mark notifications as read",
                            text: response.message || 'Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error marking all as read: " + error);
                    Swal.fire({
                        title: "Couldn't mark notifications as read",
                        text: 'Check your connection and try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                },
                complete: function () { button.prop('disabled', false); }
            });
        });

        $("#unread-tab").click(function () { loadUnreadNotifications(); });
        $("#read-tab").click(function () { loadReadNotifications(); });

        function loadUnreadNotifications() {
            TPSNotices.loading('#unread-notifications-content');
            $.ajax({
                url: '@Url.Action("UnReadForGmAndArchi", "notifications")',
                type: 'GET',
                success: function (response) {
                    TPSNotices.render('#unread-notifications-content', response, { read: false });
                    TPSNotices.setCount('#unread-count', (response || []).length);
                },
                error: function (xhr, status, error) {
                    console.error("Error loading notifications: " + error);
                    $('#unread-notifications-content').html('<div class="tps-notices-empty"><i class="ri-error-warning-line"></i>Couldn&#39;t load notifications. Refresh the page to try again.</div>');
                }
            });
        }

        function loadReadNotifications() {
            TPSNotices.loading('#read-notifications-content');
            $.ajax({
                url: '@Url.Action("Read", "notifications")',
                type: 'GET',
                success: function (response) {
                    TPSNotices.render('#read-notifications-content', response, { read: true });
                },
                error: function (xhr, status, error) {
                    console.error("Error loading notifications: " + error);
                    $('#read-notifications-content').html('<div class="tps-notices-empty"><i class="ri-error-warning-line"></i>Couldn&#39;t load notifications. Refresh the page to try again.</div>');
                }
            });
        }
    });
</script>
