@model CMS.Application.DTOs.NotificationsDTO
@{
    ViewData["Title"] = "Notification";

    // Back to the inbox that matches the user's role (same targets as before)
    string backAction =
        User.IsInRole("HR Manager") ? "IndexHRnotification" :
        User.IsInRole("Interviewer") ? "IndexInterviewernotification" :
        User.IsInRole("General Manager") ? "IndexGMnotification" :
        User.IsInRole("Solution Architecture") ? "IndexArchinotification" :
        "Index";
    bool canOpenCandidate = User.IsInRole("Admin") || User.IsInRole("HR Manager");
}

@if (Model == null)
{
    <div class="tps-state">
        <div class="tps-state__icon"><i class="ri-notification-off-line"></i></div>
        <div class="tps-state__code">Not found</div>
        <h2>This notification is no longer available</h2>
        <p>It may have been removed, for example when a delegation was withdrawn.</p>
        <div class="tps-state__actions">
            <a class="btn btn-primary" asp-action="@backAction"><i class="ri-arrow-left-line me-1"></i> Back to notifications</a>
        </div>
    </div>
}
else
{
    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--icon" aria-hidden="true"><i class="ri-notification-3-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Notification</p>
                <h2 class="tps-ihead__name" dir="auto">@Html.Raw(Model.Title)</h2>
                <div class="tps-ihead__meta">
                    <span class="tps-chip"><i class="ri-time-line"></i><time datetime="@Model.SendDate.ToString("o")">@Model.SendDate.ToString("dddd, dd MMM yyyy, h:mm tt")</time></span>                </div>
            </div>
        </div>
        <div class="tps-ihead__actions">
            @if (canOpenCandidate && Model.CandidateId.HasValue)
            {
                <a class="btn btn-outline-primary" asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.CandidateId">
                    <i class="ri-user-star-line me-1"></i> Open candidate
                </a>
            }
            <a class="btn btn-secondary" asp-action="@backAction"><i class="ri-arrow-left-line me-1"></i> Back to notifications</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Message</h4>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.BodyDesc))
            {
                <div class="tps-notice-body" dir="auto">@Html.Raw(Model.BodyDesc)</div>
            }
            else
            {
                <p class="text-muted fst-italic mb-0">This notification has no further details.</p>
            }
        </div>
    </div>
}
