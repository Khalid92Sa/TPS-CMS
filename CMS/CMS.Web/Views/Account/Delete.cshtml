@model CMS.Application.DTOs.Register

@{
    ViewData["Title"] = "Confirm Delete";
}

<!-- Page Container -->
<div class="container my-5">
    <div class="card shadow border-0 rounded-lg">
        <div class="card-header text-dark text-center py-4 border-bottom" style="background: linear-gradient(135deg, #486fc7, #319ca7);">
            <h4 class="mb-0" style="color:white;">Confirm Deletion</h4>
        </div>

        <div class="card-body px-4 py-5">
            <div class="alert alert-light text-center shadow-sm border border-warning rounded-lg">
                <h5 class="mb-3 text-danger">Are you sure you want to delete this user?</h5>
                <p class="text-muted">This action cannot be undone.</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8" style="margin-left:20%;">
                    <!-- User Email -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Email:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
                    </dl>

                    <!-- User Name -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Username:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.UserName)</dd>
                    </dl>

                    <!-- Selected Role -->
                    <dl class="row align-items-center mb-4">
                        <dt class="col-sm-4 text-right font-weight-bold text-secondary">Role:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.SelectedRole)</dd>
                    </dl>
                   
                </div>
                <!-- Action Buttons -->
                <div class="text-center mt-4">
                    <form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@Model.RegisterrId">
                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-danger px-4" onclick="showSwalConfirm()">Delete</button>
                            <a class="btn btn-secondary" asp-action="Index">Back to list</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showSwalConfirm() {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This action will permanently delete the user and its data!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e3342f',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('deleteForm').submit();
            }
        });
    }
</script>

<!-- Font Awesome for Icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
