@model CMS.Application.DTOs.Register

@{
    ViewData["Title"] = "Delete User";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-user-unfollow-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete user</p>
            <h2 class="tps-ihead__name" dir="auto">@(Model.UserName ?? Model.Email)</h2>
            <div class="tps-ihead__meta">
                @if (!string.IsNullOrEmpty(Model.SelectedRole))
                {
                    <span class="tps-chip"><i class="ri-shield-user-line"></i>@Model.SelectedRole</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div>The user can no longer sign in, and their account data is deleted.</div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Email</dt>
                    <dd><span dir="ltr">@Model.Email</span></dd>
                </div>
                <div>
                    <dt>Username</dt>
                    <dd><span dir="ltr">@Model.UserName</span></dd>
                </div>
                <div>
                    <dt>Role</dt>
                    <dd>@Model.SelectedRole</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@Model.RegisterrId">
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this user?" data-confirm-text="They lose access immediately. This can't be undone."><i class="ri-delete-bin-6-line me-1"></i> Delete user</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
