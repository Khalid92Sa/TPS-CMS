@model CMS.Application.DTOs.ChangePasswordDTO
@{
    ViewData["Title"] = "Change Password";
    var who = User.Identity?.Name;
}

<style>
    .tps-pwd { position: relative; }
    .tps-pwd .form-control,
    .tps-pwd .form-control.is-invalid { padding-inline-end: 2.75rem; background-image: none; }
    .tps-pwd__toggle {
        position: absolute;
        inset-block: 0;
        inset-inline-end: 0;
        width: 2.75rem;
        display: grid;
        place-items: center;
        border: 0;
        background: transparent;
        color: var(--tps-subtle);
        border-radius: 0 var(--tps-radius-sm, 6px) var(--tps-radius-sm, 6px) 0;
    }
    .tps-pwd__toggle:hover { color: var(--tps-heading); }
    .tps-pwd__toggle:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--tps-primary); }
</style>

<form asp-action="ChangePassword" method="post" id="changePasswordForm" novalidate>
    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-lock-password-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">My account</p>
                <h2 class="tps-ihead__name">Change password</h2>
                @if (!string.IsNullOrEmpty(who))
                {
                    <div class="tps-ihead__meta">
                        <span class="tps-chip" dir="ltr"><i class="ri-user-line"></i>@who</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8">
            <div id="formError" class="alert alert-danger d-none" role="alert"></div>

            <section class="card tps-fsection" aria-labelledby="sec-current">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-shield-keyhole-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-current">Confirm it's you</h4>
                        <p class="tps-fsection__desc">Enter the password you use to sign in today.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="CurrentPassword" class="form-label">Current password <span class="tps-req">*</span></label>
                            <div class="tps-pwd">
                                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" aria-describedby="currentPasswordError" />
                                <button type="button" class="tps-pwd__toggle" data-pwd-toggle="CurrentPassword" aria-label="Show password"><i class="ri-eye-line" aria-hidden="true"></i></button>
                            </div>
                            <span id="currentPasswordError" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card tps-fsection" aria-labelledby="sec-new">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-key-2-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-new">New password</h4>
                        <p class="tps-fsection__desc">Use at least 5 characters, different from your current password.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="NewPassword" class="form-label">New password <span class="tps-req">*</span></label>
                            <div class="tps-pwd">
                                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="newPasswordError" />
                                <button type="button" class="tps-pwd__toggle" data-pwd-toggle="NewPassword" aria-label="Show password"><i class="ri-eye-line" aria-hidden="true"></i></button>
                            </div>
                            <span id="newPasswordError" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm new password <span class="tps-req">*</span></label>
                            <div class="tps-pwd">
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="confirmPasswordError" />
                                <button type="button" class="tps-pwd__toggle" data-pwd-toggle="ConfirmPassword" aria-label="Show password"><i class="ri-eye-line" aria-hidden="true"></i></button>
                            </div>
                            <span id="confirmPasswordError" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-4">
            <div class="tps-callout">
                <i class="ri-information-line" aria-hidden="true"></i>
                <div>
                    <div class="tps-callout__title">You'll be signed out</div>
                    <p class="tps-callout__text mb-0">After the password changes, sign in again with the new one on every device you use.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" href="/">Cancel</a>
            <button type="submit" class="btn btn-primary px-4" id="changePasswordSubmit"><i class="ri-lock-password-line me-1"></i> Change password</button>
        </div>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {
        var form = document.getElementById('changePasswordForm');
        var submitBtn = document.getElementById('changePasswordSubmit');
        var formError = document.getElementById('formError');
        var fields = {
            CurrentPassword: document.getElementById('currentPasswordError'),
            NewPassword: document.getElementById('newPasswordError'),
            ConfirmPassword: document.getElementById('confirmPasswordError')
        };

        function setError(name, message) {
            fields[name].textContent = message || '';
            document.getElementById(name).classList.toggle('is-invalid', !!message);
        }

        function showFormError(message) {
            formError.textContent = message || '';
            formError.classList.toggle('d-none', !message);
        }

        // Show / hide password
        document.querySelectorAll('[data-pwd-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-pwd-toggle'));
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.querySelector('i').className = show ? 'ri-eye-off-line' : 'ri-eye-line';
            });
        });

        // Clear a field's error as soon as the user types in it
        Object.keys(fields).forEach(function (name) {
            document.getElementById(name).addEventListener('input', function () {
                setError(name, '');
                showFormError('');
            });
        });

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            showFormError('');

            var currentPassword = document.getElementById('CurrentPassword').value.trim();
            var newPassword = document.getElementById('NewPassword').value.trim();
            var confirmPassword = document.getElementById('ConfirmPassword').value.trim();
            var firstInvalid = null;

            function fail(name, message) {
                setError(name, message);
                if (!firstInvalid) firstInvalid = name;
            }

            Object.keys(fields).forEach(function (name) { setError(name, ''); });

            if (!currentPassword) fail('CurrentPassword', 'Current password is required.');

            if (!newPassword) fail('NewPassword', 'New password is required.');
            else if (newPassword.length < 5) fail('NewPassword', 'New password must be at least 5 characters.');
            else if (newPassword === currentPassword) fail('NewPassword', 'New password must be different from the current password.');

            if (!confirmPassword) fail('ConfirmPassword', 'Confirm the new password.');
            else if (newPassword !== confirmPassword) fail('ConfirmPassword', 'New password and confirmation do not match.');

            if (firstInvalid) {
                document.getElementById(firstInvalid).focus();
                return;
            }

            submitBtn.disabled = true;

            fetch(form.action, {
                method: form.method,
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) throw data;
                    return data;
                });
            })
            .then(function (data) {
                Swal.fire({
                    icon: 'success',
                    title: 'Password changed',
                    text: data.message || 'You will be signed out.',
                    confirmButtonText: 'Sign in again'
                }).then(function () {
                    window.location.href = '/users/logout';
                });
            })
            .catch(function (error) {
                submitBtn.disabled = false;
                if (error && error.field && fields[error.field]) {
                    setError(error.field, error.message);
                    document.getElementById(error.field).focus();
                } else {
                    showFormError((error && error.message) || 'The password could not be changed. Please try again.');
                }
            });
        });
    })();
</script>
