@model CMS.Application.DTOs.Register

<style>
    .text-muted-custom {
        color: #6c757d;
        font-style: italic;
    }

    .details-card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header-custom {
        background-color: #405189;
        color: white;
        padding: 20px;
        border-bottom: 3px solid #ffffff;
    }

    .card-body-custom {
        padding: 20px;
    }

    dt {
        font-weight: bold;
        color: #333;
    }

    dd {
        margin-bottom: 1rem;
    }

    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="card details-card">
    <div class="card-header card-header-custom">
        <h2 style="color:white;">User Details</h2>
    </div>

    <div class="card-body card-body-custom">
        <dl class="row">
            <dt class="col-sm-2">Email:</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">Username:</dt>
            <dd class="col-sm-10">@Model.UserName</dd>

            <dt class="col-sm-2">Role:</dt>
            <dd class="col-sm-10">@Model.SelectedRole</dd>
        </dl>
    </div>
</div>

<div class="form-group text-center mt-3">
    <a asp-action="Edit" asp-route-id="@Model.RegisterrId" class="btn btn-success">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
