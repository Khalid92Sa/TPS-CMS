@model CMS.Application.DTOs.Register
@{
    ViewData["Title"] = "Create User";
}

<style>
    .card-header {
        color: white;
        background: linear-gradient(135deg, #486fc7, #319ca7);
    }

    .btn-success {
        background: linear-gradient(135deg, #486fc7, #319ca7);
        border: none;
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #5a9bc5, #3bc6c7);
            color: white;
            transition: background 0.3s ease;
        }

    .btn-secondary {
        background-color: gray;
        border-color: gray;
    }

        .btn-secondary:hover {
            background-color: darkgray !important;
            border-color: darkgray !important;
        }
</style>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 style="color:white !important">Create User</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label">
                            <span class="text-danger">*</span> Email
                            <i class="fas fa-info-circle" data-toggle="tooltip" title="Enter a valid email address."></i>
                        </label>
                        <input asp-for="Email" class="form-control" id="email" placeholder="Enter email" required />
                        <div class="invalid-feedback">Please enter a valid email.</div>
                        <span id="emailError" class="text-danger"></span>
                    </div>

                    <!-- Username -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="UserName" class="form-label">
                            <span class="text-danger">*</span> Username
                            <i class="fas fa-info-circle" data-toggle="tooltip" title="Enter a unique username."></i>
                        </label>
                        <input asp-for="UserName" class="form-control" id="userName" placeholder="Enter username" required />
                        <div class="invalid-feedback">Please enter a username.</div>
                        <span id="userNameError" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label">
                            <span class="text-danger">*</span> Password
                        </label>
                        <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Enter password" required />
                        <div class="invalid-feedback">Please enter a password.</div>
                        <span id="passwordError" class="text-danger"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <span class="text-danger">*</span> Confirm Password
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmpassword" placeholder="Confirm password" required />
                        <div class="invalid-feedback">Passwords must match.</div>
                        <span id="confirmPasswordError" class="text-danger"></span>
                    </div>

                    <!-- Role Selection -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="SelectedRole" class="form-label">
                            <span class="text-danger">*</span> Role
                        </label>
                        @Html.DropDownListFor(model => model.SelectedRole, (SelectList)ViewBag.Roles, "Select a Role", new { @class = "form-control", id = "selectedRole", required = true })
                        <div class="invalid-feedback">Please select a role.</div>
                        <span id="selectedRoleError" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4" onclick="validateForm(event)">Create</button>
                    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<script>
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();

        let emailValid = false;

        function debounce(func, delay) {
            let timer;
            return function () {
                clearTimeout(timer);
                timer = setTimeout(() => func.apply(this, arguments), delay);
            };
        }

        $('#email').on('input', debounce(function () {
            var email = $(this).val().trim();
            if (email) {
                $.ajax({
                    url: '@Url.Action("CheckEmailExists", "Users")',
                    type: 'GET',
                    data: { email: email },
                    success: function (response) {
                        if (response.exists) {
                            $('#email').addClass('is-invalid').removeClass('is-valid');
                            $('#emailError').text('Email already exists. Please use a different email.');
                            emailValid = false;
                        } else {
                            $('#email').removeClass('is-invalid').addClass('is-valid');
                            $('#emailError').text('');
                            emailValid = true;
                        }
                    },
                    error: function () {
                        $('#emailError').text('Error checking email. Please try again.');
                        emailValid = false;
                    }
                });
            }
        }, 500));

        $('form').submit(function (e) {
            let isValid = true;

            function validateField(selector, errorMsg) {
                var value = $(selector).val().trim();
                var errorElement = $(selector).siblings('.text-danger'); // Find existing error message
                if (!value) {
                    $(selector).addClass('is-invalid');
                    if (errorElement.length === 0) {
                        $(selector).after(`<span class="text-danger">${errorMsg}</span>`);
                    }
                    isValid = false;
                } else {
                    $(selector).removeClass('is-invalid').addClass('is-valid');
                    errorElement.remove(); // Remove duplicate messages
                }
            }

            validateField('#email', 'Please enter a valid email.');
            validateField('#userName', 'Please enter a username.');
            validateField('#password', 'Please enter a password.');
            validateField('#confirmpassword', 'Passwords must match.');
            validateField('#selectedRole', 'Please select a role.');

            // Check Password Match
            if ($('#password').val().trim() !== $('#confirmpassword').val().trim()) {
                $('#confirmpassword').addClass('is-invalid');
                $('#confirmPasswordError').text('Passwords must match.');
                isValid = false;
            }

            // Prevent form submission if email is invalid
            if (!emailValid) {
                $('#email').addClass('is-invalid');
                $('#emailError').text('Please enter a valid, unique email.');
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
            }
        });
    });
</script>
