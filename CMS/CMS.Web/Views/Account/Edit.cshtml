@model CMS.Application.DTOs.Register

@{
    ViewData["Title"] = "Edit User";
}

<form asp-action="Edit" method="post" class="needs-validation" novalidate id="userForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="RegisterrId" />

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-user-settings-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Editing user</p>
                <h2 class="tps-ihead__name" dir="ltr">@(Model.UserName ?? Model.Email)</h2>
                <div class="tps-ihead__meta">
                    @if (!string.IsNullOrEmpty(Model.SelectedRole))
                    {
                        <span class="tps-chip"><i class="ri-shield-user-line"></i>@Model.SelectedRole</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8">
            <section class="card tps-fsection" aria-labelledby="sec-account">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-account-circle-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-account">Account</h4>
                        <p class="tps-fsection__desc">The person signs in with this email.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="Email" class="form-label">Email <span class="tps-req">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" id="Email" dir="ltr" autocomplete="off" />
                            <span id="EmailError" class="text-danger"></span>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="UserName" class="form-label">Username <span class="tps-req">*</span></label>
                            <input asp-for="UserName" class="form-control" id="UserName" dir="ltr" autocomplete="off" />
                            <span id="UserNameError" class="text-danger"></span>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card tps-fsection" aria-labelledby="sec-password">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-lock-password-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-password">Sign-in password</h4>
                        <p class="tps-fsection__desc">Enter the password to save with this user, and confirm it.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="Password" class="form-label">Password <span class="tps-req">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" id="Password" autocomplete="new-password" />
                            <span id="PasswordError" class="text-danger"></span>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="tps-field">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm password <span class="tps-req">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" autocomplete="new-password" />
                            <span id="ConfirmPasswordError" class="text-danger"></span>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card tps-fsection" aria-labelledby="sec-role">
                <div class="card-header">
                    <span class="tps-fsection__icon"><i class="ri-shield-user-line"></i></span>
                    <div>
                        <h4 class="tps-fsection__title" id="sec-role">Access</h4>
                        <p class="tps-fsection__desc">The role decides which pages and actions the user sees.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tps-fgrid">
                        <div class="tps-field">
                            <label asp-for="SelectedRole" class="form-label">Role <span class="tps-req">*</span></label>
                            @Html.DropDownListFor(model => model.SelectedRole, (SelectList)ViewBag.Roles, new { @class = "form-select", id = "SelectedRole" })
                            <span id="SelectedRoleError" class="text-danger"></span>
                            <span asp-validation-for="SelectedRole" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-save-line me-1"></i> Save changes</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_UserFormScript", new Dictionary<string, string>
{
    ["email"] = "Email",
    ["userName"] = "UserName",
    ["password"] = "Password",
    ["confirm"] = "ConfirmPassword",
    ["role"] = "SelectedRole",
    ["checkEmailUrl"] = null
})
