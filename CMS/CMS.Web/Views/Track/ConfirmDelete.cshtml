@model CMS.Application.DTOs.TrackDTO

@{
    ViewData["Title"] = "Delete Track";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--danger" aria-hidden="true"><i class="ri-git-branch-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Delete track</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
            <div class="tps-ihead__meta">

            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="tps-danger-note" role="note">
            <i class="ri-error-warning-line"></i>
            <div><strong>All candidates related to this track will also be deleted.</strong></div>
        </div>

        <div class="card tps-delete-card">
            <div class="card-header">
                <i class="ri-delete-bin-6-line"></i>
                <h4 class="card-title">What will be deleted</h4>
            </div>
            <div class="card-body">
                <dl class="tps-dl">
                <div>
                    <dt>Track name</dt>
                    <dd>@Model.Name</dd>
                </div>
                </dl>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> You'll be asked to confirm. This can't be undone.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-danger px-4" data-tps-delete data-confirm-title="Delete this track?" data-confirm-text="The track and its related candidates are deleted. This can't be undone." data-ajax="true" data-redirect="@Url.Action("Index", "Track")" data-success-text="The track and its related candidates were deleted."><i class="ri-delete-bin-6-line me-1"></i> Delete track</button>
        </div>
    </div>
</form>

@await Html.PartialAsync("_DeleteConfirm")
