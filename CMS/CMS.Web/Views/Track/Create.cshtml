@model CMS.Application.DTOs.TrackDTO

@{
    ViewData["Title"] = "Add a Track";
}

<form asp-action="Create" class="needs-validation" novalidate id="createTrackForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="tps-ihead">
        <div class="tps-ihead__who">
            <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-git-branch-line"></i></span>
            <div>
                <p class="tps-ihead__eyebrow">Tracks</p>
                <h2 class="tps-ihead__name">New track</h2>
            </div>
        </div>
    </div>

    <section class="card tps-fsection" aria-labelledby="sec-track">
        <div class="card-header">
            <span class="tps-fsection__icon"><i class="ri-git-branch-line"></i></span>
            <div>
                <h4 class="tps-fsection__title" id="sec-track">Track</h4>
                <p class="tps-fsection__desc">The specialisation candidates and interviews are grouped by.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="tps-fgrid">
                <div class="tps-field">
                    <label asp-for="Name" class="form-label">Track name <span class="tps-req">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Backend .NET" dir="auto" autocomplete="off" required>
                    <div class="invalid-feedback">Enter the track name.</div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <div class="tps-factions">
        <span class="tps-factions__note"><i class="ri-information-line"></i> Fields marked <span class="tps-req">*</span> are required.</span>
        <div class="tps-factions__buttons">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="ri-add-line me-1"></i> Add track</button>
        </div>
    </div>
</form>

<script>
    $(function () {
        $('#createTrackForm').submit(function (e) {
            var name = $('#Name').val().trim();
            if (!name) {
                $('#Name').addClass('is-invalid');
                e.preventDefault();
            } else {
                $('#Name').removeClass('is-invalid');
            }
        });
        $('#Name').on('input', function () { if (this.value.trim()) $(this).removeClass('is-invalid'); });
    });
</script>
