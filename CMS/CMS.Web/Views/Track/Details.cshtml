@model CMS.Application.DTOs.TrackDTO

@{
    ViewData["Title"] = "Track Details";
}

<div class="tps-ihead">
    <div class="tps-ihead__who">
        <span class="tps-ihead__avatar tps-ihead__avatar--entity" aria-hidden="true"><i class="ri-git-branch-line"></i></span>
        <div>
            <p class="tps-ihead__eyebrow">Track</p>
            <h2 class="tps-ihead__name" dir="auto">@Model.Name</h2>
        </div>
    </div>
    <div class="tps-ihead__actions">
        <a class="btn btn-secondary" asp-action="Index"><i class="ri-arrow-left-line me-1"></i> Back to list</a>
        <a class="btn btn-primary" asp-action="Update" asp-route-id="@Model.Id"><i class="ri-edit-line me-1"></i> Edit</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Details</h4>
    </div>
    <div class="card-body">
        <dl class="tps-dl">
            <div>
                <dt>Track name</dt>
                <dd dir="auto">@Model.Name</dd>
            </div>
        </dl>
    </div>
</div>
