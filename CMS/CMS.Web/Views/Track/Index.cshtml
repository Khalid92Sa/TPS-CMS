@model List<CMS.Application.DTOs.TrackDTO>

@{
    ViewData["Title"] = "Tracks";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<style>
    .card-body {
        width: 100%;
        max-width: 100%;
        overflow-y: hidden;
    }
</style>

@using (Html.BeginForm("Index", "Track", FormMethod.Get, new { id = "filterForm" }))
{
    <div class="form-group mb-3">
        <div class="row align-items-end">
            <div class="col-md-3">
                @Html.Label("Filter by Track Name:")
                <input type="text" id="trackName" name="trackName" class="form-control" placeholder="Search by Track Name" value="@ViewBag.trackNameFilter">
            </div>

            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary mt-4 w-50 me-2" title="Filter Tracks">
                    Filter
                </button>
                <button type="button" id="resetButton" class="btn btn-secondary mt-4 w-50" title="Reset Filters">
                    Reset
                </button>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <div>
                    <a asp-action="Create" class="btn btn-primary">Add New Track</a>
                </div>
            </div>
            <div class="card-body">
                <table id="track-table" class="display nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Track Name</th>
                            <th>Candidate Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            for (var i = 0; i < Model.Count(); i++)
                            {
                                var track = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@track.Name</td>
                                    <td>@track.CandidateCount</td>
                                    <td>
                                        <a class="bx bxs-edit-alt" style="font-size:x-large" asp-action="Update" asp-route-id="@track.Id" data-bs-toggle="tooltip" title="Edit"></a> |
                                        <a class="bx bx-detail" style="font-size:x-large" asp-action="Details" asp-route-id="@track.Id" data-bs-toggle="tooltip" title="Details"></a> |
                                        <a class="ri-delete-bin-2-line text-danger" style="font-size:x-large" href="@Url.Action("ConfirmDelete", new { id = track.Id })" data-bs-toggle="tooltip" title="Delete"></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No tracks found.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_PaginationPartial", Model)
            </div>
        </div>
    </div>
</div>

<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        $('#track-table').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            scrollCollapse: true,
            scrollY: '50vh',
            scrollX: true,
            autoWidth: false,
            fixedHeader: true,
            columnDefs: [
                { targets: 'hidden', visible: false }
            ]
        });

        $('#resetButton').on('click', function () {
            $('#trackName').val('');
            window.location.href = '@Url.Action("Index", "Track")';
        });
    });
</script>
