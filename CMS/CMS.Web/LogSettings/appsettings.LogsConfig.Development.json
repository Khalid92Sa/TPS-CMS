{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Debugs/log-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Debug",
          "fileSizeLimitBytes": 509715200,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {LevelEmoji} [{Level:u3}] [CorrelationId: {CorrelationId}] — {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Warnings/log-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "fileSizeLimitBytes": 509715200,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {LevelEmoji} [{Level:u3}] [CorrelationId: {CorrelationId}] — {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Informations/log-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "fileSizeLimitBytes": 509715200,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {LevelEmoji} [{Level:u3}] [CorrelationId: {CorrelationId}] — {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Errors/log-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "fileSizeLimitBytes": 509715200,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {LevelEmoji} [{Level:u3}] [CorrelationId: {CorrelationId}] — {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
