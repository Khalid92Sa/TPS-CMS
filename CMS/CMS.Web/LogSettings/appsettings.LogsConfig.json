{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Volo": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithCorrelationId"
    ]
  }
}